// kesdas: Kestrel Data Analysis. A pandas-style Series and DataFrame library,
// loaded as the virtual standard module `std.kesdas`.
//
// Storage. A Column holds one typed list per kind (Int, double, Bool, String) plus a
// mask of missing positions. Only the list of its own kind has entries. Every list
// copies cheaply, so a Series, a DataFrame and their copies share storage.

import std.math

// ---------------------------------------------------------------- list helpers

function indexRange(n : Int) : List[Int] = range(n).toList()

function pick(xs : List[Int], positions : List[Int]) : List[Int] = [xs.at(i) for i in positions]

function pick(xs : List[double], positions : List[Int]) : List[double] =
    [xs.at(i) for i in positions]

function pick(xs : List[String], positions : List[Int]) : List[String] =
    [xs.at(i) for i in positions]

function pick(xs : List[Bool], positions : List[Int]) : List[Bool] = [xs.at(i) for i in positions]

function reversedPositions(n : Int) : List[Int] = [n - 1 - i for i in range(n)]

function joinLists(left : List[Int], right : List[Int]) : List[Int] {
    let mut items : Array[Int] = Array.empty()
    for (x in left) { items.append(x) }
    for (x in right) { items.append(x) }
    items.toList()
}

function joinLists(left : List[double], right : List[double]) : List[double] {
    let mut items : Array[double] = Array.empty()
    for (x in left) { items.append(x) }
    for (x in right) { items.append(x) }
    items.toList()
}

function joinLists(left : List[String], right : List[String]) : List[String] {
    let mut items : Array[String] = Array.empty()
    for (x in left) { items.append(x) }
    for (x in right) { items.append(x) }
    items.toList()
}

function joinLists(left : List[Bool], right : List[Bool]) : List[Bool] {
    let mut items : Array[Bool] = Array.empty()
    for (x in left) { items.append(x) }
    for (x in right) { items.append(x) }
    items.toList()
}

function sliceString(text : String, start : Int, stop : Int) : String =
    [text[i] for i in range(start, stop)].join("")

// fixedDecimals writes x with exactly n decimals, for n from 1 to 17.
function fixedDecimals(x : double, n : Int) : String =
    if n == 1 then f"{x:.1f}"
    else if n == 2 then f"{x:.2f}"
    else if n == 3 then f"{x:.3f}"
    else if n == 4 then f"{x:.4f}"
    else if n == 5 then f"{x:.5f}"
    else if n == 6 then f"{x:.6f}"
    else if n == 7 then f"{x:.7f}"
    else if n == 8 then f"{x:.8f}"
    else if n == 9 then f"{x:.9f}"
    else if n == 10 then f"{x:.10f}"
    else if n == 11 then f"{x:.11f}"
    else if n == 12 then f"{x:.12f}"
    else if n == 13 then f"{x:.13f}"
    else if n == 14 then f"{x:.14f}"
    else if n == 15 then f"{x:.15f}" else if n == 16 then f"{x:.16f}" else f"{x:.17f}"

// reprFloat gives the shortest text that reads back as the same double, as Python's repr does.
function reprFloat(x : double) : String {
    if x != x { return "NaN" }
    if !x.isFinite() { return if x > 0.0 then "inf" else "-inf" }
    if x.abs() >= 1.0e16 || (x != 0.0 && x.abs() < 1.0e-4) { return x.text() }
    for (n in range(1, 18)) {
        let candidate := fixedDecimals(x, n)
        let back := match parseDouble(candidate) { v => v, _ => nanValue() }
        if back == x { return candidate }
    }
    x.text()
}

function formatFloat(x : double) : String {
    if x != x { return "NaN" }
    if !x.isFinite() { return if x > 0.0 then "inf" else "-inf" }
    let full := f"{x:.6f}"
    let mut end := full.length()
    while end > 1 && full[end - 1] == "0" { end = end - 1 }
    if full[end - 1] == "." { end = end + 1 }
    sliceString(full, 0, end)
}

// ---------------------------------------------------------------- columns

const KIND_INT : Int = 0

const KIND_FLOAT : Int = 1

const KIND_BOOL : Int = 2

const KIND_STR : Int = 3

public class Column {
    public final kind : Int
    public final ints : List[Int]
    public final floats : List[double]
    public final bools : List[Bool]
    public final strs : List[String]
    public final missing : List[Bool]
    public final size : Int

    new(
        kind : Int,
        ints : List[Int],
        floats : List[double],
        bools : List[Bool],
        strs : List[String],
        missing : List[Bool],
        size : Int,
    ) {
        this.kind = kind
        this.ints = ints
        this.floats = floats
        this.bools = bools
        this.strs = strs
        this.missing = missing
        this.size = size
    }

    // An Int column with missing entries holds doubles, as in pandas.
    public static function ofInts(values : List[Int], missing : List[Bool]) : Column {
        if [m for m in missing if m].length() > 0 {
            Column.ofFloats(values.map(x => x.toDouble()).toList(), missing)
        } else {
            Column(KIND_INT, values, [], [], [], missing, values.length())
        }
    }

    public static function ofFloats(values : List[double], missing : List[Bool]) : Column {
        let gone := [m || x != x for (x, m) in values.zip(missing)]
        Column(KIND_FLOAT, [], values, [], [], gone, values.length())
    }

    public static function ofBools(values : List[Bool], missing : List[Bool]) : Column =
        Column(KIND_BOOL, [], [], values, [], missing, values.length())

    public static function ofStrings(values : List[String], missing : List[Bool]) : Column =
        Column(KIND_STR, [], [], [], values, missing, values.length())

    public static function noneMissing(n : Int) : List[Bool] = [false for i in range(n)]

    public function tile(times : Int) : Column = __columnTile(this, times)
    public function concat(other : Column) : Column = __columnConcat(this, other)
    public static function ids(count : Int) : Column = __columnIndex(count)

    public static function ints(values : List[Int]) : Column =
        Column.ofInts(values, Column.noneMissing(values.length()))

    public static function floats(values : List[double]) : Column =
        Column.ofFloats(values, Column.noneMissing(values.length()))

    public static function bools(values : List[Bool]) : Column =
        Column.ofBools(values, Column.noneMissing(values.length()))

    public static function strings(values : List[String]) : Column =
        Column.ofStrings(values, Column.noneMissing(values.length()))

    public static function empty(kind : Int, size : Int) : Column {
        let gone := [true for i in range(size)]
        if kind == KIND_INT {
            Column(kind, [0 for i in range(size)], [], [], [], gone, size)
        } else if kind == KIND_FLOAT {
            Column(kind, [], [0.0 for i in range(size)], [], [], gone, size)
        } else if kind == KIND_BOOL {
            Column(kind, [], [], [false for i in range(size)], [], gone, size)
        } else {
            Column(kind, [], [], [], ["" for i in range(size)], gone, size)
        }
    }

    public function copy() : Column =
        Column(this.kind, this.ints, this.floats, this.bools, this.strs, this.missing, this.size)

    public function dtype() : String =
        if this.kind == KIND_INT then "int64"
        else if this.kind == KIND_FLOAT then "float64"
        else if this.kind == KIND_BOOL then "bool" else "str"

    public function isNumeric() : Bool = this.kind == KIND_INT || this.kind == KIND_FLOAT

    // orderPositions sorts the given positions by this column with a native stable sort.
    public function orderPositions(start : List[Int], ascending : Bool, naFirst : Bool) : List[Int] =
        __columnOrder(this, start, ascending, naFirst)

    // topPositions selects the n largest or smallest present rows in rank order.
    public function topPositions(n : Int, ascending : Bool) : List[Int] =
        __columnTop(this, n, ascending)

    // gather builds a column from the given row positions, in that order.
    public function gather(positions : List[Int]) : Column = __columnGather(this, positions)

    public function head(n : Int) : Column = this.gather(indexRange(min(n, this.size)))

    // join appends another column of the same kind below this one.
    public function join(other : Column) : Column {
        let gone := joinLists(this.missing, other.missing)
        let n := this.size + other.size
        if this.kind == KIND_INT {
            Column(this.kind, joinLists(this.ints, other.ints), [], [], [], gone, n)
        } else if this.kind == KIND_FLOAT {
            Column(this.kind, [], joinLists(this.floats, other.floats), [], [], gone, n)
        } else if this.kind == KIND_BOOL {
            Column(this.kind, [], [], joinLists(this.bools, other.bools), [], gone, n)
        } else {
            Column(this.kind, [], [], [], joinLists(this.strs, other.strs), gone, n)
        }
    }

    // toFloats gives the numbers as doubles; missing entries are NaN.
    public function toFloats() : List[double] {
        let nan := 0.0 / 0.0
        if this.kind == KIND_FLOAT {
            [if m then nan else x for (x, m) in this.floats.zip(this.missing)]
        } else if this.kind == KIND_INT {
            [if m then nan else x.toDouble() for (x, m) in this.ints.zip(this.missing)]
        } else if this.kind == KIND_BOOL {
            [if m then nan else if x then 1.0 else 0.0 for (x, m) in this.bools.zip(this.missing)]
        } else {
            [nan for i in range(this.size)]
        }
    }

    // texts shows each entry the way a printed table does.
    public function texts() : List[String] {
        if this.kind == KIND_INT {
            [if m then "NaN" else x.text() for (x, m) in this.ints.zip(this.missing)]
        } else if this.kind == KIND_FLOAT {
            let shown :=
                [if m then "NaN" else formatFloat(x) for (x, m) in this.floats.zip(this.missing)]
            alignDecimals(shown)
        } else if this.kind == KIND_BOOL {
            [
                if m then "NaN"
                    else if x then "True" else "False" for (x, m) in this.bools.zip(this.missing)
            ]
        } else {
            [if m then "NaN" else x for (x, m) in this.strs.zip(this.missing)]
        }
    }

    // keys gives one comparable text per entry. Equal values give equal keys, and a whole
    // double matches the Int with the same value.
    public function keys() : List[String] {
        if this.kind == KIND_INT {
            [if m then "~" else "n" + x.text() for (x, m) in this.ints.zip(this.missing)]
        } else if this.kind == KIND_FLOAT {
            [if m then "~" else floatKey(x) for (x, m) in this.floats.zip(this.missing)]
        } else if this.kind == KIND_BOOL {
            [if m then "~" else if x then "b1" else "b0" for (x, m) in this.bools.zip(this.missing)]
        } else {
            [if m then "~" else "s" + x for (x, m) in this.strs.zip(this.missing)]
        }
    }
}

function floatKey(x : double) : String =
    if x == x.floor() && x.abs() < 9.0e15 then "n" + wholeInt(x).text() else "d" + x.text()

// wholeInt converts a double to an Int by rounding down; values outside the range give 0.
function wholeInt(x : double) : Int = match x.floor().checkedToInt() { n => n, _ => 0 }

// charAt finds the first position of a one-character text, or -1.
function charAt(text : String, ch : String) : Int {
    for (i in range(text.length())) {
        if text[i] == ch { return i }
    }
    -1
}

// alignDecimals gives every number the same count of decimals, as a printed pandas column does.
function alignDecimals(shown : List[String]) : List[String] {
    let mut decimals := 1
    for (text in shown) {
        let at := charAt(text, ".")
        if at >= 0 { decimals = max(decimals, text.length() - at - 1) }
    }
    [padDecimals(text, decimals) for text in shown]
}

function padDecimals(text : String, decimals : Int) : String {
    let at := charAt(text, ".")
    if at < 0 { return text }
    let have := text.length() - at - 1
    text + ["0" for i in range(decimals - have)].join("")
}

// ---------------------------------------------------------------- scalars

// A Scalar is one cell lifted out of a column: a number, a flag, a text, or a missing entry.
public class Scalar {
    has (Text, Equals)

    public final kind : Int
    public final whole : Int
    public final real : double
    public final flag : Bool
    public final word : String

    new(kind : Int, whole : Int, real : double, flag : Bool, word : String) {
        this.kind = kind
        this.whole = whole
        this.real = real
        this.flag = flag
        this.word = word
    }

    public static function ofInt(value : Int) : Scalar = Scalar(KIND_INT, value, 0.0, false, "")
    public static function ofFloat(value : double) : Scalar =
        if value != value then Scalar.missing() else Scalar(KIND_FLOAT, 0, value, false, "")
    public static function ofBool(value : Bool) : Scalar = Scalar(KIND_BOOL, 0, 0.0, value, "")
    public static function ofString(value : String) : Scalar =
        Scalar(KIND_STR, 0, 0.0, false, value)
    public static function missing() : Scalar = Scalar(-1, 0, 0.0, false, "")

    public function isMissing() : Bool = this.kind < 0
    public function isNumeric() : Bool = this.kind == KIND_INT || this.kind == KIND_FLOAT

    // asDouble reads a number as a double; anything else is NaN.
    public function asDouble() : double =
        if this.kind == KIND_INT then this.whole.toDouble()
        else if this.kind == KIND_FLOAT then this.real
        else if this.kind == KIND_BOOL then (if this.flag then 1.0 else 0.0) else 0.0 / 0.0

    public function asInt() : Int =
        if this.kind == KIND_INT then this.whole
        else if this.kind == KIND_FLOAT then wholeInt(this.real)
        else if this.kind == KIND_BOOL then (if this.flag then 1 else 0) else 0

    public function asString() : String = this.text()
    public function asBool() : Bool = this.kind == KIND_BOOL && this.flag

    public function text() : String =
        if this.kind == KIND_INT then this.whole.text()
        else if this.kind == KIND_FLOAT then reprFloat(this.real)
        else if this.kind == KIND_BOOL then (if this.flag then "True" else "False")
        else if this.kind == KIND_STR then this.word else "NaN"

    public function equals(other : Scalar) : Bool {
        let sameReal :=
            this.real == other.real || (this.real != this.real && other.real != other.real)
        this.kind == other.kind &&
            this.whole == other.whole &&
            this.flag == other.flag && this.word == other.word && sameReal
    }
}

// ---------------------------------------------------------------- column kernels

function truePositions(mask : List[Bool]) : List[Int] = [i for (i, m) in mask.enumerate() if m]

// presentMask reads a Bool column as a mask: missing counts as false.
function presentMask(c : Column) : List[Bool] = [v && !m for (v, m) in c.bools.zip(c.missing)]

// truthyColumn reads a column the way any() and all() do: zero, empty text and missing
// are false, and every other entry is true.
function truthyColumn(c : Column) : List[Bool] {
    if c.kind == KIND_BOOL {
        [x && !m for (x, m) in c.bools.zip(c.missing)]
    } else if c.kind == KIND_INT {
        [x != 0 && !m for (x, m) in c.ints.zip(c.missing)]
    } else if c.kind == KIND_FLOAT {
        [x != 0.0 && x == x && !m for (x, m) in c.floats.zip(c.missing)]
    } else {
        [x.length() > 0 && !m for (x, m) in c.strs.zip(c.missing)]
    }
}

function truthyPresent(c : Column) : List[Bool] =
    [x && !m for (x, m) in truthyColumn(c).zip(c.missing) if !m]

function scalarKey(s : Scalar) : String =
    if s.isMissing() then "~"
    else if s.kind == KIND_INT then "n" + s.whole.text()
    else if s.kind == KIND_FLOAT then floatKey(s.real)
    else if s.kind == KIND_BOOL then (if s.flag then "b1" else "b0") else "s" + s.word

// replaceInColumn swaps one value for another throughout a column. The result takes the
// narrowest kind that holds both the old and the new value.
function scalarCopy(s : Scalar) : Scalar = Scalar(s.kind, s.whole, s.real, s.flag, s.word)

function replaceInColumn(c : Column, old : Scalar, replacement : Scalar) : Column {
    let target := scalarKey(old)
    columnOfScalars(
        [
            if scalarKey(scalarAt(c, i)) == target then scalarCopy(replacement)
                else scalarAt(c, i) for i in range(c.size)
        ],
    )
}

// whereInColumn keeps an entry where the mask is true and puts the replacement elsewhere.
function whereInColumn(c : Column, mask : List[Bool], replacement : Scalar, invert : Bool) : Column {
    columnOfScalars(
        [
            if (mask.toArray()[i] != invert) then scalarAt(c, i)
                else scalarCopy(replacement) for i in range(c.size)
        ],
    )
}

// normalizeIndex turns a negative position into its distance from the end. It gives -1
// for a position outside the column.
function normalizeIndex(position : Int, size : Int) : Int {
    if position < 0 && position >= -size { return size + position }
    if position >= size { return -1 }
    position
}

function normalizeIndexes(positions : List[Int], size : Int) : List[Int] =
    positions.map(position => normalizeIndex(position, size)).toList()

function duplicateFlags(keys : List[String], keep : String) : List[Bool] {
    let seen : MutSet[String] = MutSet()
    let counts : MutMap[String, Int] = MutMap()
    for (key in keys) {
        let own := key
        counts.put(own, match counts.get(key) { Some(n) => n + 1, None => 1 })
    }
    let flags := Array(keys.length(), false)
    if keep == "none" {
        for ((i, key) in keys.enumerate()) {
            flags[i] = match counts.get(key) { Some(n) => n > 1, None => false }
        }
        return flags.toList()
    }
    if keep == "last" {
        for (k in range(keys.length())) {
            let i := keys.length() - 1 - k
            let key := keys.toArray()[i]
            if seen.contains(key) {
                flags[i] = true
            } else {
                let own := key
                seen.add(own)
            }
        }
        return flags.toList()
    }
    for ((i, key) in keys.enumerate()) {
        if seen.contains(key) {
            flags[i] = true
        } else {
            let own := key
            seen.add(own)
        }
    }
    flags.toList()
}

function keepPositions(keys : List[String], keep : String) : List[Int] {
    if keep == "none" {
        let flags := duplicateFlags(keys, keep)
        return [i for (i, dup) in indexRange(keys.length()).zip(flags) if !dup]
    }
    let flags := duplicateFlags(keys, keep)
    [i for (i, dup) in indexRange(keys.length()).zip(flags) if !dup]
}

function validFloats(c : Column) : List[double] =
    [x for (x, m) in c.toFloats().zip(c.missing) if !m]

function nanValue() : double = 0.0 / 0.0

function scalarAt(c : Column, i : Int) : Scalar {
    if c.missing.at(i) { return Scalar.missing() }
    if c.kind == KIND_INT { return Scalar.ofInt(c.ints.at(i)) }
    if c.kind == KIND_FLOAT { return Scalar.ofFloat(c.floats.at(i)) }
    if c.kind == KIND_BOOL { return Scalar.ofBool(c.bools.at(i)) }
    Scalar.ofString(c.strs.at(i))
}

function sortedFloats(xs : List[double]) : List[double] = xs.sorted()

function meanOf(xs : List[double]) : double =
    if xs.length() == 0 then nanValue() else xs.sum() / xs.length().toDouble()

function varianceOf(xs : List[double], ddof : Int) : double {
    let n := xs.length()
    if n - ddof <= 0 { return nanValue() }
    let mean := meanOf(xs)
    let squares := xs.map(x => (x - mean) * (x - mean))
    squares.sum() / (n - ddof).toDouble()
}

// quantileOf interpolates linearly between neighbours, as pandas does.
function quantileOf(xs : List[double], q : double) : double {
    let n := xs.length()
    if n == 0 { return nanValue() }
    let items := sortedFloats(xs).toArray()
    let position := q * (n - 1).toDouble()
    let low := wholeInt(position.floor())
    let high := min(low + 1, n - 1)
    let weight := position - low.toDouble()
    items[low] + (items[high] - items[low]) * weight
}

// skewOf is the unbiased Fisher-Pearson skewness that pandas reports.
function skewOf(xs : List[double]) : double {
    let n := xs.length()
    if n < 3 { return nanValue() }
    let mean := meanOf(xs)
    let mut m2 := 0.0
    let mut m3 := 0.0
    for (x in xs) {
        let d := x - mean
        m2 = m2 + d * d
        m3 = m3 + d * d * d
    }
    if m2 == 0.0 { return nanValue() }
    let spread := sqrt(m2 / (n - 1).toDouble())
    let value :=
        m3 * n.toDouble() / ((n - 1).toDouble() * (n - 2).toDouble() * (spread * spread * spread))
    if value.abs() < 1.0e-12 { 0.0 } else { value }
}

// kurtosisOf is the unbiased excess kurtosis that pandas reports as kurt.
function kurtosisOf(xs : List[double]) : double {
    let n := xs.length()
    if n < 4 { return nanValue() }
    let mean := meanOf(xs)
    let mut m2 := 0.0
    let mut m4 := 0.0
    for (x in xs) {
        let d := x - mean
        m2 = m2 + d * d
        m4 = m4 + d * d * d * d
    }
    if m2 == 0.0 { return nanValue() }
    let nf := n.toDouble()
    let value :=
        (nf * (nf + 1.0) * (nf - 1.0) * m4 / ((nf - 2.0) * (nf - 3.0) * m2 * m2)) -
            (3.0 * (nf - 1.0) * (nf - 1.0) / ((nf - 2.0) * (nf - 3.0)))
    if value.abs() < 1.0e-12 { 0.0 } else { value }
}

// covarianceColumns computes the sample covariance from the positions where both columns
// are present, so one missing cell does not poison the whole pair.
function covarianceColumns(a : Column, b : Column, ddof : Int) : double {
    let xs := a.toFloats().toArray()
    let ys := b.toFloats().toArray()
    let ma := a.missing.toArray()
    let mb := b.missing.toArray()
    let n := min(xs.length(), ys.length())
    let mut count := 0
    let mut mx := 0.0
    let mut my := 0.0
    for (i in range(n)) {
        if !ma[i] && !mb[i] {
            count = count + 1
            mx = mx + xs[i]
            my = my + ys[i]
        }
    }
    if count - ddof <= 0 { return nanValue() }
    mx = mx / count.toDouble()
    my = my / count.toDouble()
    let mut total := 0.0
    for (i in range(n)) {
        if !ma[i] && !mb[i] { total = total + (xs[i] - mx) * (ys[i] - my) }
    }
    total / (count - ddof).toDouble()
}

function correlationColumns(a : Column, b : Column) : double = __columnCorrelation(a, b)

function semOf(xs : List[double]) : double {
    let n := xs.length()
    if n == 0 { return nanValue() }
    sqrt(varianceOf(xs, 1) / n.toDouble())
}

function covarianceOf(xs : List[double], ys : List[double], ddof : Int) : double {
    let n := min(xs.length(), ys.length())
    if n - ddof <= 0 { return nanValue() }
    let mx := meanOf(xs)
    let my := meanOf(ys)
    let mut total := 0.0
    for (i in range(n)) {
        total = total + (xs.toArray()[i] - mx) * (ys.toArray()[i] - my)
    }
    total / (n - ddof).toDouble()
}

// orderBy sorts the given row positions by one column. Equal entries keep their order.
function orderBy(c : Column, start : List[Int], ascending : Bool) : List[Int] =
    orderByWithNa(c, start, ascending, false)

// orderByWithNa also chooses whether missing entries go first or last, as sortValues does.
function orderByWithNa(c : Column, start : List[Int], ascending : Bool, naFirst : Bool) : List[Int] =
    c.orderPositions(start, ascending, naFirst)

// MutSet.add and MutMap.put take a String out of the variable they are given, which would
// empty the source list when that variable borrows a list item. `let own := item` copies first.
function keySet(items : List[String]) : MutSet[String] {
    let set : MutSet[String] = MutSet()
    for (item in items) {
        let own := item
        set.add(own)
    }
    set
}

function positionSet(items : List[Int]) : MutSet[Int] {
    let set : MutSet[Int] = MutSet()
    for (item in items) { set.add(item) }
    set
}

// firstOccurrences keeps the first position of every distinct key.
function columnCodes(column : Column) : (List[Int], Int) =
    if column.kind == KIND_FLOAT then __factorCodes(column.keys().toList())
    else __columnCodes(column)

// distinctFirsts codes a column once and returns its distinct first rows.
function distinctFirsts(column : Column) : (List[Int], List[Int], Int) {
    let (codes, width) := columnCodes(column)
    let codeAt := codes.toArray()
    let mut firsts := Array(width, -1)
    for (i in range(codeAt.length())) {
        let c := codeAt[i]
        if firsts[c] < 0 { firsts[c] = i }
    }
    let distinct := [firsts[c] for c in range(width)]
    (codes, distinct.toList(), width)
}

function firstOccurrences(keys : List[String]) : List[Int] {
    let seen : MutSet[String] = MutSet()
    let mut kept : Array[Int] = Array.empty()
    for ((i, key) in keys.enumerate()) {
        if !seen.contains(key) {
            let own := key
            seen.add(own)
            kept.append(i)
        }
    }
    kept.toList()
}

// groupRuns lists the row positions of each distinct key, each group in row order and the
// groups in order of their first row.
function groupRuns(keys : List[String]) : List[List[Int]] {
    let items := keys.toArray()
    let n := items.length()
    if n == 0 { return [] }
    let owners := Array(n, 0)
    let counts : Array[Int] = Array.empty()
    let table : MutMap[String, Int] = MutMap()
    for (i in range(n)) {
        let key := items[i]
        let g := match table.get(key) {
            Some(group) => group,
            None => {
                let group := counts.length()
                let own := key
                table.put(own, group)
                counts.append(0)
                group
            },
        }
        owners[i] = g
        counts[g] = counts[g] + 1
    }
    let starts := Array(counts.length(), 0)
    let cursor := Array(counts.length(), 0)
    let mut total := 0
    for (g in range(counts.length())) {
        starts[g] = total
        cursor[g] = total
        total = total + counts[g]
    }
    let flat := Array(n, 0)
    for (i in range(n)) {
        let g := owners[i]
        flat[cursor[g]] = i
        cursor[g] = cursor[g] + 1
    }
    let mut groups : Array[List[Int]] = Array.empty()
    for (g in range(counts.length())) {
        groups.append([flat[k] for k in range(starts[g], starts[g] + counts[g])])
    }
    groups.toList()
}

function groupRunsCodes(codes : List[Int]) : List[List[Int]] {
    let items := codes.toArray()
    let n := items.length()
    if n == 0 { return [] }
    let owners := Array(n, 0)
    let counts : Array[Int] = Array.empty()
    let table : MutMap[Int, Int] = MutMap()
    for (i in range(n)) {
        let key := items[i]
        let g := match table.get(key) {
            Some(group) => group,
            None => {
                let group := counts.length()
                table.put(key, group)
                counts.append(0)
                group
            },
        }
        owners[i] = g
        counts[g] = counts[g] + 1
    }
    let starts := Array(counts.length(), 0)
    let cursor := Array(counts.length(), 0)
    let mut total := 0
    for (g in range(counts.length())) {
        starts[g] = total
        cursor[g] = total
        total = total + counts[g]
    }
    let flat := Array(n, 0)
    for (i in range(n)) {
        let g := owners[i]
        flat[cursor[g]] = i
        cursor[g] = cursor[g] + 1
    }
    let mut groups : Array[List[Int]] = Array.empty()
    for (g in range(counts.length())) {
        groups.append([flat[k] for k in range(starts[g], starts[g] + counts[g])])
    }
    groups.toList()
}

// groupRunsCodesWidth maps dense codes with one array instead of a hash map.
function groupRunsCodesWidth(codes : List[Int], width : Int) : List[List[Int]] {
    let items := codes.toArray()
    let n := items.length()
    if n == 0 { return [] }
    let owners := Array(n, 0)
    let counts : Array[Int] = Array.empty()
    let mapping := Array(if width > 0 then width else 1, -1)
    for (i in range(n)) {
        let c := items[i]
        let g := mapping[c]
        if g < 0 {
            let group := counts.length()
            mapping[c] = group
            counts.append(0)
            owners[i] = group
            counts[group] = counts[group] + 1
        } else {
            owners[i] = g
            counts[g] = counts[g] + 1
        }
    }
    let starts := Array(counts.length(), 0)
    let cursor := Array(counts.length(), 0)
    let mut total := 0
    for (g in range(counts.length())) {
        starts[g] = total
        cursor[g] = total
        total = total + counts[g]
    }
    let flat := Array(n, 0)
    for (i in range(n)) {
        let g := owners[i]
        flat[cursor[g]] = i
        cursor[g] = cursor[g] + 1
    }
    let mut groups : Array[List[Int]] = Array.empty()
    for (g in range(counts.length())) {
        groups.append([flat[k] for k in range(starts[g], starts[g] + counts[g])])
    }
    groups.toList()
}

function firstOf(group : List[Int]) : Int = match group.first() { Some(i) => i, None => 0 }

// ---------------------------------------------------------------- column arithmetic

const OP_ADD : Int = 0

const OP_SUB : Int = 1

const OP_MUL : Int = 2

const OP_DIV : Int = 3

const OP_FLOORDIV : Int = 4

const OP_MOD : Int = 5

const OP_POW : Int = 6

const CMP_EQ : Int = 0

const CMP_NE : Int = 1

const CMP_LT : Int = 2

const CMP_LE : Int = 3

const CMP_GT : Int = 4

const CMP_GE : Int = 5

function applyFloats(op : Int, x : double, y : double) : double =
    if op == OP_ADD then x + y
    else if op == OP_SUB then x - y
    else if op == OP_MUL then x * y
    else if op == OP_DIV then x / y
    else if op == OP_FLOORDIV then (x / y).floor()
    else if op == OP_MOD then x - y * (x / y).floor() else x.pow(y)

function applyInts(op : Int, x : Int, y : Int) : Int =
    if op == OP_ADD then x + y
    else if op == OP_SUB then x - y
    else if op == OP_MUL then x * y
    else if op == OP_FLOORDIV then floorDivide(x, y)
    else if op == OP_MOD then x - y * floorDivide(x, y) else x ** y

function floorDivide(x : Int, y : Int) : Int {
    let quotient := x / y
    if (x % y != 0) && ((x < 0) != (y < 0)) { quotient - 1 } else { quotient }
}

function combine(a : List[Bool], b : List[Bool]) : List[Bool] = [x || y for (x, y) in a.zip(b)]

// arithmetic combines two columns entry by entry. Whole numbers stay whole except for
// division and a zero divisor, which turn the result into doubles.
function arithmetic(op : Int, left : Column, right : Column) : Column {
    if left.isNumeric() &&
        right.isNumeric() && (left.kind == KIND_FLOAT || right.kind == KIND_FLOAT) {
            return __columnArithmetic(op, left, right)
        }
    let gone := combine(left.missing, right.missing)
    if left.kind == KIND_STR && right.kind == KIND_STR && op == OP_ADD {
        let joined := [x + y for (x, y) in left.strs.zip(right.strs)]
        return Column.ofStrings(joined, gone)
    }
    if left.kind == KIND_INT && right.kind == KIND_INT && op != OP_DIV && op != OP_POW {
        let ys := right.ints.toArray()
        let xs := left.ints.toArray()
        let masks := gone.toArray()
        let safe :=
            [
                masks[i] ||
                    (ys[i] == 0 && (op == OP_FLOORDIV || op == OP_MOD)) for i in range(xs.length())
            ]
        let flags := safe.toArray()
        let values :=
            [if flags[i] then 0 else applyInts(op, xs[i], ys[i]) for i in range(xs.length())]
        return Column.ofInts(values, safe)
    }
    let xs := left.toFloats()
    let ys := right.toFloats()
    Column.ofFloats([applyFloats(op, x, y) for (x, y) in xs.zip(ys)], gone)
}

function arithmeticWithFloat(op : Int, column : Column, other : double, flipped : Bool) : Column {
    let xs := column.toFloats()
    let values :=
        if flipped then xs.map(x => applyFloats(op, other, x)).toList()
        else xs.map(x => applyFloats(op, x, other)).toList()
    Column.ofFloats(values, column.missing)
}

function arithmeticWithInt(op : Int, column : Column, other : Int, flipped : Bool) : Column {
    if column.kind == KIND_INT && op != OP_DIV && op != OP_POW && other != 0 {
        let values :=
            if flipped then column.ints.map(x => applyInts(op, other, if x == 0 then 1 else x)).toList()
            else column.ints.map(x => applyInts(op, x, other)).toList()
        return Column.ofInts(values, column.missing)
    }
    arithmeticWithFloat(op, column, other.toDouble(), flipped)
}

function matches(op : Int, order : Int) : Bool =
    if op == CMP_EQ then order == 0
    else if op == CMP_NE then order != 0
    else if op == CMP_LT then order < 0
    else if op == CMP_LE then order <= 0 else if op == CMP_GT then order > 0 else order >= 0

function compareColumns(op : Int, left : Column, right : Column) : Column {
    let gone := combine(left.missing, right.missing)
    let verdicts : List[Bool] = if left.kind == KIND_STR && right.kind == KIND_STR {
        [matches(op, x.compare(y)) for (x, y) in left.strs.zip(right.strs)]
    } else if left.kind == KIND_BOOL && right.kind == KIND_BOOL {
        [
            matches(op, (if x then 1 else 0) - (if y then 1 else 0)) for (x, y) in left.bools.zip(
                right.bools,
            )
        ]
    } else if left.isNumeric() && right.isNumeric() {
        [matches(op, x.compare(y)) for (x, y) in left.toFloats().zip(right.toFloats())]
    } else {
        [false for i in range(left.size)]
    }
    let answers := [if m then op == CMP_NE else v for (v, m) in verdicts.zip(gone)]
    Column.bools(answers)
}

function compareWithFloat(op : Int, column : Column, other : double) : Column {
    if column.kind == KIND_INT || column.kind == KIND_FLOAT {
        return __columnCompareFloat(column, op, other)
    }
    let answers :=
        [
            if m then op == CMP_NE
                else matches(op, x.compare(other)) for (x, m) in column.toFloats().zip(
                    column.missing,
                )
        ]
    Column.bools(if column.isNumeric() then answers else [op == CMP_NE for i in range(column.size)])
}

function compareWithString(op : Int, column : Column, other : String) : Column {
    if column.kind != KIND_STR { return Column.bools([op == CMP_NE for i in range(column.size)]) }
    Column.bools(
        [
            if m then op == CMP_NE
                else matches(op, x.compare(other)) for (x, m) in column.strs.zip(column.missing)
        ],
    )
}

function compareWithBool(op : Int, column : Column, other : Bool) : Column {
    if column.kind != KIND_BOOL { return Column.bools([op == CMP_NE for i in range(column.size)]) }
    let target := if other then 1 else 0
    Column.bools(
        [
            if m then op == CMP_NE
                else matches(op, (if x then 1 else 0) - target) for (x, m) in column.bools.zip(
                    column.missing,
                )
        ],
    )
}

// ---------------------------------------------------------------- rendering

function spaces(n : Int) : String = [" " for i in range(n)].join("")

function padLeft(text : String, width : Int) : String = spaces(width - text.length()) + text

function padRight(text : String, width : Int) : String = text + spaces(width - text.length())

function widest(texts : List[String]) : Int =
    match texts.map(t => t.length()).toList().max() { Some(w) => w, None => 0 }

function htmlEscape(text : String) : String =
    text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

const MAX_ROWS : Int = 60

const SHOWN_EDGE : Int = 5

// seriesLines prints the rows of a series, cutting the middle of a long one. A number that
// is not negative gets a leading space where a minus sign would go, as pandas prints it.
function seriesLines(
    indexTexts : List[String],
    valueTexts : List[String],
    numeric : Bool,
) : List[String] {
    let n := valueTexts.length()
    let cut := n > MAX_ROWS
    let positions :=
        if cut then joinLists(
            indexRange(MAX_ROWS / 2),
            [n - MAX_ROWS / 2 + i for i in range(MAX_ROWS / 2)],
        )
        else indexRange(n)
    let shownIndex := pick(indexTexts, positions)
    let shownValues :=
        pick(valueTexts, positions).map(v => if numeric && v.startsWith("-") then v else " " + v).toList()
    let indexWidth := widest(shownIndex)
    let valueWidth := widest(shownValues)
    let rows :=
        [
            padRight(i, indexWidth) +
                "   " + padLeft(v, valueWidth) for (i, v) in shownIndex.zip(shownValues)
        ]
    if cut {
        let half := MAX_ROWS / 2
        joinLists(joinLists(takeStrings(rows, half), ["..."]), dropStrings(rows, half))
    } else {
        rows
    }
}

function takeStrings(xs : List[String], n : Int) : List[String] =
    pick(xs, indexRange(min(n, xs.length())))

function dropStrings(xs : List[String], n : Int) : List[String] =
    pick(xs, [n + i for i in range(xs.length() - n)])

// tableLines prints a data frame: a header, then each row, with "..." cutting a long middle.
function tableLines(
    headers : List[String],
    indexTexts : List[String],
    columns : List[List[String]],
    indexName : String,
    columnsLabel : String,
    collapse : List[Bool],
) : List[String] {
    let n := indexTexts.length()
    let cut := n > MAX_ROWS
    let positions :=
        if cut then joinLists(
            indexRange(SHOWN_EDGE),
            [n - SHOWN_EDGE + i for i in range(SHOWN_EDGE)],
        )
        else indexRange(n)
    let shownIndex := pick(indexTexts, positions)
    let shown := columns.map(column => pick(column, positions)).toList()
    let indexWidth := max(widest(shownIndex), max(indexName.length(), columnsLabel.length()))
    let widths := [max(h.length(), widest(column)) for (h, column) in headers.zip(shown)]
    // pandas separates a text column from its neighbour with one space and a number or
    // Bool column with two. An all-NaN column is laid out like text.
    let firstIsNaN := headers.length() > 0 && shown.toArray()[0].all(v => v == "NaN")
    let seps :=
        [
            if i == 0 then (if firstIsNaN then " " else "  ")
                else if collapse.toArray()[i] then " " else "  " for i in range(headers.length())
        ]
    let head :=
        padRight(columnsLabel, indexWidth) +
            joinTexts(
                [
                    seps.toArray()[i] +
                        padLeft(h, widths.toArray()[i]) for (i, h) in headers.enumerate()
                ],
            )
    let named :=
        if indexName == "" then [head]
        else [
            head,
            padRight(indexName, indexWidth) +
                joinTexts(
                    [
                        seps.toArray()[i] +
                            spaces(widths.toArray()[i]) for i in range(widths.length())
                    ],
                ),
        ]
    let body :=
        [
            padRight(shownIndex.toArray()[r], indexWidth) +
                joinTexts(
                    [
                        seps.toArray()[i] +
                            padLeft(column.toArray()[r], widths.toArray()[i]) for (i, column) in shown.enumerate()
                    ],
                ) for r in range(shownIndex.length())
        ]
    if cut {
        let dots :=
            padRight("...", indexWidth) +
                joinTexts(
                    [
                        seps.toArray()[i] +
                            padLeft("...", widths.toArray()[i]) for i in range(widths.length())
                    ],
                )
        joinLists(
            joinLists(joinLists(named, takeStrings(body, SHOWN_EDGE)), [dots]),
            dropStrings(body, SHOWN_EDGE),
        )
    } else {
        joinLists(named, body)
    }
}

function joinTexts(parts : List[String]) : String = parts.join("")

function tableHtml(
    headers : List[String],
    indexTexts : List[String],
    columns : List[List[String]],
    indexName : String,
) : String {
    let n := indexTexts.length()
    let cut := n > MAX_ROWS
    let positions :=
        if cut then joinLists(
            indexRange(SHOWN_EDGE),
            [n - SHOWN_EDGE + i for i in range(SHOWN_EDGE)],
        )
        else indexRange(n)
    let shownIndex := pick(indexTexts, positions)
    let shown := columns.map(column => pick(column, positions)).toList()
    let head :=
        "<tr style=\"text-align: right;\"><th>" +
            htmlEscape(indexName) +
            "</th>" +
            joinTexts(headers.map(h => "<th>" + htmlEscape(h) + "</th>").toList()) + "</tr>"
    let rows := [rowHtml(shownIndex.toArray()[r], shown, r) for r in range(shownIndex.length())]
    let dots := "<tr><th>...</th>" + joinTexts(headers.map(h => "<td>...</td>").toList()) + "</tr>"
    let middle :=
        if cut then joinTexts(takeStrings(rows, SHOWN_EDGE)) +
            dots + joinTexts(dropStrings(rows, SHOWN_EDGE))
        else joinTexts(rows)
    "<div><style scoped>.dataframe tbody tr th:only-of-type { vertical-align: middle; } .dataframe tbody tr th { vertical-align: top; } .dataframe thead th { text-align: right; }</style><table border=\"1\" class=\"dataframe\"><thead>" +
        head + "</thead><tbody>" + middle + "</tbody></table></div>"
}

function rowHtml(label : String, columns : List[List[String]], r : Int) : String =
    "<tr><th>" +
        htmlEscape(label) +
        "</th>" +
        joinTexts(
            columns.map(column => "<td>" + htmlEscape(column.toArray()[r]) + "</td>").toList(),
        ) +
        "</tr>"

// ---------------------------------------------------------------- column statistics

function sumColumn(c : Column) : Scalar {
    if c.kind == KIND_INT {
        return Scalar.ofInt([x for (x, m) in c.ints.zip(c.missing) if !m].sum())
    }
    if c.kind == KIND_BOOL {
        return Scalar.ofInt([if x then 1 else 0 for (x, m) in c.bools.zip(c.missing) if !m].sum())
    }
    if c.kind == KIND_FLOAT { return Scalar.ofFloat(validFloats(c).sum()) }
    Scalar.ofString([x for (x, m) in c.strs.zip(c.missing) if !m].join(""))
}

function extremum(c : Column, wantMax : Bool) : Scalar {
    if c.kind == KIND_INT {
        let xs := [x for (x, m) in c.ints.zip(c.missing) if !m]
        return match (if wantMax then xs.max() else xs.min()) {
            Some(v) => Scalar.ofInt(v),
            None => Scalar.missing(),
        }
    }
    if c.kind == KIND_STR {
        let xs := [x for (x, m) in c.strs.zip(c.missing) if !m]
        return match (if wantMax then xs.max() else xs.min()) {
            Some(v) => Scalar.ofString(v),
            None => Scalar.missing(),
        }
    }
    if c.kind == KIND_BOOL {
        let xs := [if x then 1 else 0 for (x, m) in c.bools.zip(c.missing) if !m]
        return match (if wantMax then xs.max() else xs.min()) {
            Some(v) => Scalar.ofBool(v == 1),
            None => Scalar.missing(),
        }
    }
    let xs := validFloats(c)
    match (if wantMax then xs.max() else xs.min()) {
        Some(v) => Scalar.ofFloat(v),
        None => Scalar.missing(),
    }
}

function countValid(c : Column) : Int = [m for m in c.missing if !m].length()

// toKind converts a column to another kind, as astype does.
function toKind(c : Column, kind : Int) : Column {
    if kind == c.kind { return c.copy() }
    let nan := nanValue()
    if kind == KIND_FLOAT {
        if c.kind == KIND_STR {
            let parsed := c.strs.map(s => match parseDouble(s) { x => x, _ => nan }).toList()
            return Column.ofFloats(parsed, c.missing)
        }
        return Column.ofFloats(c.toFloats(), c.missing)
    }
    if kind == KIND_INT {
        if c.kind == KIND_STR {
            let parsed := c.strs.map(s => match parseInt(s) { n => n, _ => 0 }).toList()
            return Column.ofInts(parsed, c.missing)
        }
        let truncated :=
            c.toFloats().map(x => wholeInt(if x < 0.0 then x.ceil() else x.floor())).toList()
        return Column.ofInts(truncated, c.missing)
    }
    if kind == KIND_BOOL {
        if c.kind == KIND_STR {
            return Column.ofBools(c.strs.map(s => s == "True" || s == "true").toList(), c.missing)
        }
        return Column.ofBools(c.toFloats().map(x => x != 0.0).toList(), c.missing)
    }
    Column.ofStrings(c.texts(), c.missing)
}

// fillColumn replaces missing entries with a value of the column's own kind.
function fillColumn(c : Column, value : Scalar) : Column {
    if value.isMissing() { return c.copy() }
    if !c.missing.any(m => m) { return c.copy() }
    let none := Column.noneMissing(c.size)
    if c.kind == KIND_FLOAT && value.isNumeric() {
        let v := value.asDouble()
        return Column.ofFloats([if m then v else x for (x, m) in c.floats.zip(c.missing)], none)
    }
    if c.kind == KIND_INT && value.kind == KIND_INT {
        let v := value.whole
        return Column.ofInts([if m then v else x for (x, m) in c.ints.zip(c.missing)], none)
    }
    if c.kind == KIND_STR && value.kind == KIND_STR {
        let v := value.word
        return Column.ofStrings([if m then v else x for (x, m) in c.strs.zip(c.missing)], none)
    }
    if c.kind == KIND_BOOL && value.kind == KIND_BOOL {
        let v := value.flag
        return Column.ofBools([if m then v else x for (x, m) in c.bools.zip(c.missing)], none)
    }
    c.copy()
}

// gatherGaps gathers positions, where a negative position gives a missing entry.
function gatherGaps(c : Column, positions : List[Int]) : Column {
    if c.size == 0 { return Column.empty(c.kind, positions.length()) }
    let safe := positions.map(p => if p < 0 then 0 else p).toList()
    let taken := c.gather(safe)
    let gone := [m || p < 0 for (m, p) in taken.missing.zip(positions)]
    if taken.kind == KIND_INT { return Column.ofInts(taken.ints, gone) }
    Column(taken.kind, taken.ints, taken.floats, taken.bools, taken.strs, gone, taken.size)
}

function shiftColumn(c : Column, periods : Int) : Column =
    gatherGaps(
        c,
        [i - periods for i in range(c.size)].map(p => if p < 0 || p >= c.size then -1 else p).toList(),
    )

function diffColumn(c : Column, periods : Int) : Column =
    if c.isNumeric() then arithmetic(OP_SUB, c, shiftColumn(c, periods)) else c.copy()

function pctChangeColumn(c : Column, periods : Int) : Column {
    if !c.isNumeric() { return c.copy() }
    let ratio := arithmetic(OP_DIV, c, shiftColumn(c, periods))
    arithmeticWithInt(OP_SUB, ratio, 1, false)
}

function roundColumn(c : Column, decimals : Int) : Column {
    if c.kind == KIND_INT { return c.copy() }
    if !c.isNumeric() { return c.copy() }
    let scale := 10.0.pow(decimals.toDouble())
    Column.ofFloats(c.toFloats().map(x => (x * scale).round() / scale).toList(), c.missing)
}

function clipColumn(c : Column, low : double, high : double) : Column {
    if !c.isNumeric() { return c.copy() }
    let clipped := c.toFloats().map(x => x.max(low).min(high)).toList()
    if c.kind == KIND_INT { Column.ofInts(clipped.map(x => wholeInt(x)).toList(), c.missing) } else {
        Column.ofFloats(clipped, c.missing)
    }
}

function runningTotals(c : Column, op : Int) : Column {
    let xs := c.toFloats()
    let mut current := nanValue()
    let mut seen := false
    let mut out : Array[double] = Array.empty()
    for ((x, m) in xs.zip(c.missing)) {
        if m {
            out.append(nanValue())
        } else {
            if !seen {
                current = x
                seen = true
            } else if op == 0 {
                current = current + x
            } else if op == 1 {
                current = current * x
            } else if op == 2 {
                current = current.max(x)
            } else {
                current = current.min(x)
            }
            out.append(current)
        }
    }
    let totals := out.toList()
    if c.kind == KIND_INT {
        Column.ofInts(totals.map(x => wholeInt(x)).toList(), c.missing)
    } else {
        Column.ofFloats(totals, c.missing)
    }
}

// rankColumn ranks the present entries. Ties average by default; min, max, first and dense
// are also available. Missing entries keep their place as missing.
function rankColumn(c : Column, ascending : Bool, method : String, pct : Bool) : Column {
    let order := orderBy(c, indexRange(c.size), ascending)
    let gone := c.missing.toArray()
    let keys := c.keys().toArray()
    let mut present : Array[Int] = Array.empty()
    for (i in order) {
        if !gone[i] { present.append(i) }
    }
    let places := present.toList().toArray()
    let mut ranks := Array(c.size, 0.0)
    let n := places.length()
    let mut start := 0
    let mut dense := 0
    while start < n {
        let mut stop := start
        while stop + 1 < n && keys[places[stop + 1]] == keys[places[start]] { stop = stop + 1 }
        dense = dense + 1
        if method == "first" {
            let tied := pick(indexRange(n), [start + i for i in range(stop - start + 1)]).sorted()
            let positions := tied.toArray()
            for (k in range(positions.length())) {
                ranks[places[positions[k]]] = (start + 1 + k).toDouble()
            }
        } else if method == "min" {
            for (k in range(start, stop + 1)) { ranks[places[k]] = (start + 1).toDouble() }
        } else if method == "max" {
            for (k in range(start, stop + 1)) { ranks[places[k]] = (stop + 1).toDouble() }
        } else if method == "dense" {
            for (k in range(start, stop + 1)) { ranks[places[k]] = dense.toDouble() }
        } else {
            let average := (start + stop + 2).toDouble() / 2.0
            for (k in range(start, stop + 1)) { ranks[places[k]] = average }
        }
        start = stop + 1
    }
    if pct && n > 0 {
        for (i in range(c.size)) {
            if !gone[i] { ranks[i] = ranks[i] / n.toDouble() }
        }
    }
    Column.ofFloats(ranks.toList(), c.missing)
}

// interpolateColumn fills an interior gap by drawing a straight line between the nearest
// present entries. A trailing gap takes the last present value; a leading gap stays missing.
function interpolateColumn(c : Column) : Column {
    let xs := c.toFloats().toArray()
    let gone := c.missing.toArray()
    let n := xs.length()
    let mut out := Array(n, nanValue())
    let mut filled := Array(n, true)
    let mut previous := -1
    for (i in range(n)) {
        if !gone[i] {
            out[i] = xs[i]
            filled[i] = false
            previous = i
        } else if previous >= 0 {
            let mut next := -1
            for (j in range(i + 1, n)) {
                if !gone[j] && next < 0 { next = j }
            }
            if next < 0 {
                out[i] = xs[previous]
            } else {
                let span := (next - previous).toDouble()
                out[i] =
                    xs[previous] + (xs[next] - xs[previous]) * ((i - previous).toDouble() / span)
            }
            filled[i] = false
        }
    }
    Column.ofFloats(out.toList(), filled.toList())
}

function windowed(c : Column, window : Int, needed : Int, statistic : Int) : Column {
    let xs := c.toFloats().toArray()
    let n := xs.length()
    let mut out : Array[double] = Array.empty()
    for (i in range(n)) {
        let start := max(0, i - window + 1)
        let present := [xs[j] for j in range(start, i + 1) if xs[j] == xs[j]]
        if statistic == 5 {
            // pandas validates count against the rows the window covers, then
            // reports how many of those rows are present.
            out.append(
                if min(i + 1, window) < needed then nanValue() else present.length().toDouble(),
            )
        } else if present.length() < needed {
            out.append(nanValue())
        } else if statistic == 0 {
            out.append(meanOf(present))
        } else if statistic == 1 {
            out.append(present.sum())
        } else if statistic == 2 {
            out.append(match present.min() { Some(v) => v, None => nanValue() })
        } else if statistic == 3 {
            out.append(match present.max() { Some(v) => v, None => nanValue() })
        } else if statistic == 4 {
            out.append(sqrt(varianceOf(present, 1)))
        } else if statistic == 6 {
            out.append(quantileOf(present, 0.5))
        } else if statistic == 7 {
            out.append(varianceOf(present, 1))
        } else if statistic == 8 {
            out.append(semOf(present))
        } else if statistic == 9 {
            out.append(skewOf(present))
        } else if statistic == 10 {
            out.append(kurtosisOf(present))
        } else {
            out.append(meanOf(present))
        }
    }
    Column.floats(out.toList())
}

// rollingMean keeps one running sum, so a window costs one addition and one
// subtraction per row instead of rebuilding and rescanning a list.
// Numeric rolling means run over the contiguous column storage in C; the
// Kestrel loop below remains for other kinds.
function rollingMean(c : Column, window : Int, needed : Int) : Column =
    if c.isNumeric() then __columnRollingMean(c, window, needed)
    else rollingMeanSlow(c, window, needed)

function rollingMeanSlow(c : Column, window : Int, needed : Int) : Column {
    let xs := c.toFloats().toArray()
    let gone := c.missing.toArray()
    let n := xs.length()
    let mut total := 0.0
    let mut count := 0
    let mut out : Array[double] = Array.empty()
    for (i in range(n)) {
        if !gone[i] {
            total = total + xs[i]
            count = count + 1
        }
        let old := i - window
        if old >= 0 && !gone[old] {
            total = total - xs[old]
            count = count - 1
        }
        out.append(if count < needed then nanValue() else total / count.toDouble())
    }
    Column.floats(out.toList())
}

function rollingSum(c : Column, window : Int, needed : Int) : Column {
    let xs := c.toFloats().toArray()
    let gone := c.missing.toArray()
    let n := xs.length()
    let mut total := 0.0
    let mut count := 0
    let mut out : Array[double] = Array.empty()
    for (i in range(n)) {
        if !gone[i] {
            total = total + xs[i]
            count = count + 1
        }
        let old := i - window
        if old >= 0 && !gone[old] {
            total = total - xs[old]
            count = count - 1
        }
        out.append(if count < needed then nanValue() else total)
    }
    Column.floats(out.toList())
}

function rollingCount(c : Column, window : Int, needed : Int) : Column {
    let gone := c.missing.toArray()
    let n := gone.length()
    let mut count := 0
    let mut out : Array[double] = Array.empty()
    for (i in range(n)) {
        if !gone[i] { count = count + 1 }
        let old := i - window
        if old >= 0 && !gone[old] { count = count - 1 }
        // pandas decides count's validity from window occupancy, not from the
        // number of present observations: once `needed` rows fit in the window,
        // the reported value is just how many of them are present.
        let filled := min(i + 1, window)
        out.append(if filled < needed then nanValue() else count.toDouble())
    }
    Column.floats(out.toList())
}

function windowedQuantile(c : Column, window : Int, needed : Int, q : double) : Column {
    let xs := c.toFloats().toArray()
    let n := xs.length()
    let mut out : Array[double] = Array.empty()
    for (i in range(n)) {
        let start := max(0, i - window + 1)
        let present := [xs[j] for j in range(start, i + 1) if xs[j] == xs[j]]
        out.append(if present.length() < needed then nanValue() else quantileOf(present, q))
    }
    Column.floats(out.toList())
}

function windowedApply(c : Column, window : Int, needed : Int, f : List[double] -> double) : Column {
    let xs := c.toFloats().toArray()
    let n := xs.length()
    let mut out : Array[double] = Array.empty()
    for (i in range(n)) {
        let start := max(0, i - window + 1)
        let present := [xs[j] for j in range(start, i + 1) if xs[j] == xs[j]]
        out.append(if present.length() < needed then nanValue() else f(present))
    }
    Column.floats(out.toList())
}

// ewmColumn computes one exponentially weighted statistic for every row.
function ewmColumn(
    c : Column,
    alpha : double,
    adjust : Bool,
    minPeriods : Int,
    statistic : Int,
    bias : Bool,
) : Column {
    let xs := c.toFloats().toArray()
    let gone := c.missing.toArray()
    let n := xs.length()
    let mut out : Array[double] = Array.empty()
    for (i in range(n)) {
        if gone[i] {
            out.append(nanValue())
        } else {
            let mut count := 0
            let mut sumW := 0.0
            let mut sumW2 := 0.0
            let mut sumWX := 0.0
            let mut first := -1
            for (j in range(i + 1)) {
                if !gone[j] {
                    if first < 0 { first = j }
                    let weight :=
                        if adjust then (1.0 - alpha).pow((i - j).toDouble())
                        else if j == first then (1.0 - alpha).pow((i - j).toDouble())
                        else alpha * (1.0 - alpha).pow((i - j).toDouble())
                    count = count + 1
                    sumW = sumW + weight
                    sumW2 = sumW2 + weight * weight
                    sumWX = sumWX + weight * xs[j]
                }
            }
            if count < minPeriods || sumW == 0.0 {
                out.append(nanValue())
            } else {
                let mean := sumWX / sumW
                let mut deviation := 0.0
                for (j in range(i + 1)) {
                    if !gone[j] {
                        let weight :=
                            if adjust then (1.0 - alpha).pow((i - j).toDouble())
                            else if j == first then (1.0 - alpha).pow((i - j).toDouble())
                            else alpha * (1.0 - alpha).pow((i - j).toDouble())
                        deviation = deviation + weight * (xs[j] - mean) * (xs[j] - mean)
                    }
                }
                if statistic == 0 {
                    out.append(mean)
                } else if statistic == 1 {
                    out.append(sumWX)
                } else if statistic == 2 || statistic == 3 {
                    let variance := if bias then deviation / sumW else {
                        let denominator := sumW - (sumW2 / sumW)
                        if denominator <= 0.0 then nanValue() else deviation / denominator
                    }
                    out.append(if statistic == 3 then sqrt(variance) else variance)
                } else {
                    out.append(count.toDouble())
                }
            }
        }
    }
    Column.floats(out.toList())
}

// ---------------------------------------------------------------- series

public class Series {
    has (
        Text,
        Addable,
        Subtractable,
        Multipliable,
        Divisible,
        Negatable,
        RightAddable[double],
        RightSubtractable[double],
        RightMultipliable[double],
        RightDivisible[double],
        RightAddable[Int],
        RightSubtractable[Int],
        RightMultipliable[Int],
        RightDivisible[Int],
    )

    public final name : String
    public final data : Column
    public final index : Column
    public final indexName : String

    new(name : String, move data : Column, move index : Column, indexName : String) {
        this.name = name
        this.data = data
        this.index = index
        this.indexName = indexName
    }

    new(values : List[Int], name : String = "") {
        this.name = name
        this.data = Column.ints(values)
        this.index = Column.ints(indexRange(values.length()))
        this.indexName = ""
    }

    new(values : List[double], name : String = "") {
        this.name = name
        this.data = Column.floats(values)
        this.index = Column.ints(indexRange(values.length()))
        this.indexName = ""
    }

    new(values : List[String], name : String = "") {
        this.name = name
        this.data = Column.strings(values)
        this.index = Column.ints(indexRange(values.length()))
        this.indexName = ""
    }

    new(values : List[Bool], name : String = "") {
        this.name = name
        this.data = Column.bools(values)
        this.index = Column.ints(indexRange(values.length()))
        this.indexName = ""
    }

    // ---- basics

    public function copy() : Series =
        Series(this.name, this.data.copy(), this.index.copy(), this.indexName)
    public function length() : Int = this.data.size
    public function size() : Int = this.data.size
    public function ndim() : Int = 1
    public function isEmpty() : Bool = this.data.size == 0
    public function dtype() : String = this.data.dtype()

    public function derive(move data : Column) : Series =
        Series(this.name, data, this.index.copy(), this.indexName)

    public function take(positions : List[Int]) : Series =
        Series(this.name, this.data.gather(positions), this.index.gather(positions), this.indexName)

    // toScalars lifts every entry out of the column, missing entries included.
    public function toScalars() : List[Scalar] =
        [scalarAt(this.data, i) for i in range(this.data.size)]

    // items pairs each index label with its value.
    public function items() : List[(Scalar, Scalar)] =
        [(scalarAt(this.index, i), scalarAt(this.data, i)) for i in range(this.data.size)]

    public function equals(other : Series) : Bool =
        this.data.keys() == other.data.keys() && this.index.keys() == other.index.keys()

    public function rename(name : String) : Series =
        Series(name, this.data.copy(), this.index.copy(), this.indexName)

    public function withIndex(labels : List[String]) : Series =
        Series(this.name, this.data.copy(), Column.strings(labels), this.indexName)

    public function withIndex(labels : List[Int]) : Series =
        Series(this.name, this.data.copy(), Column.ints(labels), this.indexName)

    public function withIndexColumn(labels : Column) : Series =
        Series(this.name, this.data.copy(), labels.copy(), this.indexName)

    public function named(indexName : String) : Series =
        Series(this.name, this.data.copy(), this.index.copy(), indexName)

    public function toInts() : List[Int] = toKind(this.data, KIND_INT).ints
    public function toFloats() : List[double] = this.data.toFloats()
    public function toStrings() : List[String] = this.data.texts()
    public function toBools() : List[Bool] = toKind(this.data, KIND_BOOL).bools
    public function indexLabels() : List[String] = this.index.texts()
    public function missingMask() : List[Bool] = this.data.missing

    public function astype(dtype : String) : Series {
        let kind :=
            if dtype == "int64" || dtype == "int" then KIND_INT
            else if dtype == "float64" || dtype == "float" || dtype == "double" then KIND_FLOAT
            else if dtype == "bool" then KIND_BOOL else KIND_STR
        this.derive(toKind(this.data, kind))
    }

    // ---- selection

    public function head(n : Int = 5) : Series {
        let count := if n >= 0 then min(n, this.data.size) else max(0, this.data.size + n)
        this.take(indexRange(count))
    }

    public function tail(n : Int = 5) : Series {
        if n < 0 {
            let skip := min(-n, this.data.size)
            return this.take([skip + i for i in range(this.data.size - skip)])
        }
        let count := min(n, this.data.size)
        this.take([this.data.size - count + i for i in range(count)])
    }

    public function slice(start : Int, stop : Int) : Series {
        let from := max(0, start)
        let to := min(stop, this.data.size)
        this.take([from + i for i in range(max(0, to - from))])
    }

    public function iloc(position : Int) : Scalar {
        let at := normalizeIndex(position, this.data.size)
        if at < 0 { return Scalar.missing() }
        scalarAt(this.data, at)
    }

    public function iloc(positions : List[Int]) : Series =
        this.takeGaps(normalizeIndexes(positions, this.data.size))

    // iat is the scalar form of iloc.
    public function iat(position : Int) : Scalar = this.iloc(position)

    // takeGaps keeps the row at each position; a negative position becomes missing.
    public function takeGaps(positions : List[Int]) : Series =
        Series(
            this.name,
            gatherGaps(this.data, positions),
            gatherGaps(this.index, positions),
            this.indexName,
        )

    public function positionOf(label : Int) : Option[Int] =
        this.index.keys().index("n" + label.text())
    public function positionOf(label : String) : Option[Int] = this.index.keys().index("s" + label)
    public function positionOf(label : double) : Option[Int] =
        this.index.keys().index(floatKey(label))
    public function positionOf(label : Bool) : Option[Int] =
        this.index.keys().index(if label then "b1" else "b0")

    public function loc(label : Int) : Scalar =
        match this.positionOf(label) { Some(p) => scalarAt(this.data, p), None => Scalar.missing() }

    public function loc(label : String) : Scalar =
        match this.positionOf(label) { Some(p) => scalarAt(this.data, p), None => Scalar.missing() }

    public function loc(label : double) : Scalar =
        match this.positionOf(label) { Some(p) => scalarAt(this.data, p), None => Scalar.missing() }

    public function loc(label : Bool) : Scalar =
        match this.positionOf(label) { Some(p) => scalarAt(this.data, p), None => Scalar.missing() }

    // at and iat are the label and position spellings for one cell.
    public function at(label : Int) : Scalar = this.loc(label)
    public function at(label : String) : Scalar = this.loc(label)
    public function at(label : double) : Scalar = this.loc(label)
    public function at(label : Bool) : Scalar = this.loc(label)

    // filter keeps the rows where the mask is true: pandas s[mask].
    public function filter(mask : Series) : Series =
        this.take(truePositions(presentMask(mask.data)))

    public function where(mask : Series, other : Scalar) : Series {
        let kept := presentMask(mask.data)
        this.derive(whereInColumn(this.data, kept, other, false))
    }

    public function where(mask : Series, other : Series) : Series {
        let kept := presentMask(mask.data).toArray()

        let mut items : Array[Scalar] = Array.empty()
        for (i in range(this.data.size)) {
            items.append(
                if kept[i] || other.data.size == 0 then scalarAt(this.data, i)
                    else scalarAt(other.data, min(i, other.data.size - 1)),
            )
        }
        this.derive(columnOfScalars(items.toList()))
    }

    public function mask(mask : Series, other : Scalar) : Series {
        let kept := presentMask(mask.data)
        this.derive(whereInColumn(this.data, kept, other, true))
    }

    // ---- sorting

    public function sortValues(ascending : Bool = true, naPosition : String = "last") : Series =
        this.take(
            orderByWithNa(this.data, indexRange(this.data.size), ascending, naPosition == "first"),
        )

    public function sortIndex(ascending : Bool = true, naPosition : String = "last") : Series =
        this.take(
            orderByWithNa(this.index, indexRange(this.data.size), ascending, naPosition == "first"),
        )

    public function nlargest(n : Int = 5) : Series = this.sortValues(ascending = false).head(n)
    public function nsmallest(n : Int = 5) : Series = this.sortValues().head(n)

    public function resetIndex() : Series =
        Series(this.name, this.data.copy(), Column.ints(indexRange(this.data.size)), "")

    // ---- arithmetic

    public function add(other : Series) : Series =
        this.derive(arithmetic(OP_ADD, this.data, other.data))
    public function subtract(other : Series) : Series =
        this.derive(arithmetic(OP_SUB, this.data, other.data))
    public function multiply(other : Series) : Series =
        this.derive(arithmetic(OP_MUL, this.data, other.data))
    public function divide(other : Series) : Series =
        this.derive(arithmetic(OP_DIV, this.data, other.data))
    public function floorDivide(other : Series) : Series =
        this.derive(arithmetic(OP_FLOORDIV, this.data, other.data))
    public function mod(other : Series) : Series =
        this.derive(arithmetic(OP_MOD, this.data, other.data))
    public function pow(other : Series) : Series =
        this.derive(arithmetic(OP_POW, this.data, other.data))

    public function add(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_ADD, this.data, other, false))
    public function subtract(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_SUB, this.data, other, false))
    public function multiply(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_MUL, this.data, other, false))
    public function divide(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_DIV, this.data, other, false))
    public function floorDivide(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_FLOORDIV, this.data, other, false))
    public function mod(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_MOD, this.data, other, false))
    public function pow(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_POW, this.data, other, false))

    public function add(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_ADD, this.data, other, false))
    public function subtract(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_SUB, this.data, other, false))
    public function multiply(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_MUL, this.data, other, false))
    public function divide(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_DIV, this.data, other, false))
    public function floorDivide(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_FLOORDIV, this.data, other, false))
    public function mod(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_MOD, this.data, other, false))
    public function pow(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_POW, this.data, other, false))

    public function add(other : String) : Series =
        this.derive(
            Column.ofStrings(this.data.strs.map(s => s + other).toList(), this.data.missing),
        )

    public function rightAdd(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_ADD, this.data, other, true))
    public function rightSubtract(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_SUB, this.data, other, true))
    public function rightMultiply(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_MUL, this.data, other, true))
    public function rightDivide(other : double) : Series =
        this.derive(arithmeticWithFloat(OP_DIV, this.data, other, true))
    public function rightAdd(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_ADD, this.data, other, true))
    public function rightSubtract(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_SUB, this.data, other, true))
    public function rightMultiply(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_MUL, this.data, other, true))
    public function rightDivide(other : Int) : Series =
        this.derive(arithmeticWithInt(OP_DIV, this.data, other, true))

    public function negate() : Series = this.derive(arithmeticWithInt(OP_MUL, this.data, -1, false))
    public function abs() : Series =
        if this.data.kind ==
            KIND_INT then this.derive(
                Column.ofInts(this.data.ints.map(x => x.abs()).toList(), this.data.missing),
            )
        else this.derive(
            Column.ofFloats(this.data.toFloats().map(x => x.abs()).toList(), this.data.missing),
        )

    public function round(decimals : Int = 0) : Series {
        let scale := 10.0.pow(decimals.toDouble())
        if this.data.kind == KIND_INT { return this.copy() }
        this.derive(
            Column.ofFloats(
                this.data.toFloats().map(x => (x * scale).round() / scale).toList(),
                this.data.missing,
            ),
        )
    }

    public function sqrt() : Series =
        this.derive(
            Column.ofFloats(this.data.toFloats().map(x => sqrt(x)).toList(), this.data.missing),
        )

    public function clip(low : double, high : double) : Series {
        let clipped := this.data.toFloats().map(x => x.max(low).min(high)).toList()
        if this.data.kind == KIND_INT {
            this.derive(Column.ofInts(clipped.map(x => wholeInt(x)).toList(), this.data.missing))
        } else {
            this.derive(Column.ofFloats(clipped, this.data.missing))
        }
    }

    public function clip(low : Int, high : Int) : Series =
        this.clip(low.toDouble(), high.toDouble())

    // item reads one value; without a position it asks for the only entry.
    public function item(position : Int = 0) : Scalar {
        if this.data.size == 0 { return Scalar.missing() }
        this.iloc(position)
    }

    public function isUnique() : Bool =
        firstOccurrences(this.data.keys().toList()).length() == this.data.size

    // isMonotonic reports whether the present entries never reverse direction.
    public function isMonotonic(increasing : Bool = true) : Bool {
        if this.data.missing.any(m => m) { return false }
        let valid := [i for (i, m) in indexRange(this.data.size).zip(this.data.missing) if !m]
        if this.data.isNumeric() {
            let xs := this.data.toFloats().toArray()
            for (k in range(1, valid.length())) {
                let order := xs[valid.toArray()[k]].compare(xs[valid.toArray()[k - 1]])
                if increasing && order < 0 { return false }
                if !increasing && order > 0 { return false }
            }
            return true
        }
        if this.data.kind == KIND_BOOL {
            let xs := this.data.bools.toArray()
            for (k in range(1, valid.length())) {
                let order :=
                    (if xs[valid.toArray()[k]] then 1 else 0) -
                        (if xs[valid.toArray()[k - 1]] then 1 else 0)
                if increasing && order < 0 { return false }
                if !increasing && order > 0 { return false }
            }
            return true
        }
        let xs := this.data.strs.toArray()
        for (k in range(1, valid.length())) {
            let order := xs[valid.toArray()[k]].compare(xs[valid.toArray()[k - 1]])
            if increasing && order < 0 { return false }
            if !increasing && order > 0 { return false }
        }
        true
    }

    // repeat gives every entry consecutive copies, keeping its index label.
    public function repeat(times : Int) : Series {
        if times <= 0 { return this.take([]) }
        let mut positions : Array[Int] = Array.empty()
        for (i in range(this.data.size)) {
            for (k in range(times)) { positions.append(i) }
        }
        this.take(positions.toList())
    }

    // ---- comparison and logic; each gives a Bool series

    public function eq(other : Series) : Series =
        this.derive(compareColumns(CMP_EQ, this.data, other.data))
    public function ne(other : Series) : Series =
        this.derive(compareColumns(CMP_NE, this.data, other.data))
    public function lt(other : Series) : Series =
        this.derive(compareColumns(CMP_LT, this.data, other.data))
    public function le(other : Series) : Series =
        this.derive(compareColumns(CMP_LE, this.data, other.data))
    public function gt(other : Series) : Series =
        this.derive(compareColumns(CMP_GT, this.data, other.data))
    public function ge(other : Series) : Series =
        this.derive(compareColumns(CMP_GE, this.data, other.data))

    public function eq(other : double) : Series =
        this.derive(compareWithFloat(CMP_EQ, this.data, other))
    public function ne(other : double) : Series =
        this.derive(compareWithFloat(CMP_NE, this.data, other))
    public function lt(other : double) : Series =
        this.derive(compareWithFloat(CMP_LT, this.data, other))
    public function le(other : double) : Series =
        this.derive(compareWithFloat(CMP_LE, this.data, other))
    public function gt(other : double) : Series =
        this.derive(compareWithFloat(CMP_GT, this.data, other))
    public function ge(other : double) : Series =
        this.derive(compareWithFloat(CMP_GE, this.data, other))

    public function eq(other : Int) : Series =
        this.derive(compareWithFloat(CMP_EQ, this.data, other.toDouble()))
    public function ne(other : Int) : Series =
        this.derive(compareWithFloat(CMP_NE, this.data, other.toDouble()))
    public function lt(other : Int) : Series =
        this.derive(compareWithFloat(CMP_LT, this.data, other.toDouble()))
    public function le(other : Int) : Series =
        this.derive(compareWithFloat(CMP_LE, this.data, other.toDouble()))
    public function gt(other : Int) : Series =
        this.derive(compareWithFloat(CMP_GT, this.data, other.toDouble()))
    public function ge(other : Int) : Series =
        this.derive(compareWithFloat(CMP_GE, this.data, other.toDouble()))

    public function eq(other : String) : Series =
        this.derive(compareWithString(CMP_EQ, this.data, other))
    public function ne(other : String) : Series =
        this.derive(compareWithString(CMP_NE, this.data, other))
    public function lt(other : String) : Series =
        this.derive(compareWithString(CMP_LT, this.data, other))
    public function le(other : String) : Series =
        this.derive(compareWithString(CMP_LE, this.data, other))
    public function gt(other : String) : Series =
        this.derive(compareWithString(CMP_GT, this.data, other))
    public function ge(other : String) : Series =
        this.derive(compareWithString(CMP_GE, this.data, other))

    public function eq(other : Bool) : Series =
        this.derive(compareWithBool(CMP_EQ, this.data, other))
    public function ne(other : Bool) : Series =
        this.derive(compareWithBool(CMP_NE, this.data, other))

    public function both(other : Series) : Series =
        if this.data.kind == KIND_BOOL &&
            other.data.kind == KIND_BOOL then this.derive(__columnBoth(this.data, other.data))
        else this.derive(
            Column.bools([x && y for (x, y) in presentMask(this.data).zip(presentMask(other.data))]),
        )
    public function either(other : Series) : Series =
        this.derive(
            Column.bools([x || y for (x, y) in presentMask(this.data).zip(presentMask(other.data))]),
        )
    public function invert() : Series =
        this.derive(Column.bools(presentMask(this.data).map(x => !x).toList()))

    public function between(low : double, high : double) : Series = this.ge(low).both(this.le(high))
    public function between(low : Int, high : Int) : Series = this.ge(low).both(this.le(high))
    public function between(low : String, high : String) : Series = this.ge(low).both(this.le(high))

    public function isIn(values : List[Int]) : Series =
        this.isInKeys(values.map(v => "n" + v.text()).toList())
    public function isIn(values : List[double]) : Series =
        this.isInKeys(values.map(v => floatKey(v)).toList())
    public function isIn(values : List[String]) : Series =
        this.isInKeys(values.map(v => "s" + v).toList())
    public function isIn(values : List[Bool]) : Series =
        this.isInKeys(values.map(v => if v then "b1" else "b0").toList())

    function isInKeys(wanted : List[String]) : Series {
        let set := keySet(wanted)
        this.derive(Column.bools(this.data.keys().map(k => set.contains(k)).toList()))
    }

    // ---- missing values

    public function isNa() : Series = this.derive(Column.bools(this.data.missing))
    public function notNa() : Series =
        this.derive(Column.bools(this.data.missing.map(m => !m).toList()))
    public function fillNa(value : double) : Series =
        this.derive(fillColumn(this.data, Scalar.ofFloat(value)))
    public function fillNa(value : Int) : Series =
        this.derive(
            fillColumn(
                this.data,
                if this.data.kind == KIND_FLOAT then Scalar.ofFloat(value.toDouble())
                    else Scalar.ofInt(value),
            ),
        )
    public function fillNa(value : String) : Series =
        this.derive(fillColumn(this.data, Scalar.ofString(value)))
    public function fillNa(value : Bool) : Series =
        this.derive(fillColumn(this.data, Scalar.ofBool(value)))
    public function fillNa(value : Scalar) : Series = this.derive(fillColumn(this.data, value))

    public function dropNa() : Series =
        this.take(truePositions(this.data.missing.map(m => !m).toList()))

    // ffill carries the last valid entry forward; bfill carries the next one back.
    public function ffill() : Series {
        let gone := this.data.missing.toArray()
        let mut last := -1
        let mut sources : Array[Int] = Array.empty()
        for (i in range(gone.length())) {
            if !gone[i] { last = i }
            sources.append(last)
        }
        this.derive(gatherGaps(this.data, sources.toList()))
    }

    public function bfill() : Series {
        let gone := this.data.missing.toArray()
        let n := gone.length()
        let mut next := -1
        let mut sources : Array[Int] = Array.empty()
        for (k in range(n)) {
            let i := n - 1 - k
            if !gone[i] { next = i }
            sources.append(next)
        }
        this.derive(gatherGaps(this.data, pick(sources.toList(), reversedPositions(n))))
    }

    // interpolate draws a straight line between present numbers across each gap.
    public function interpolate() : Series = this.derive(interpolateColumn(this.data))

    // ---- reductions

    public function count() : Int = countValid(this.data)
    public function sum() : Scalar = sumColumn(this.data)
    public function min() : Scalar = extremum(this.data, false)
    public function max() : Scalar = extremum(this.data, true)
    public function mean() : Scalar = Scalar.ofFloat(meanOf(validFloats(this.data)))
    public function median() : Scalar = Scalar.ofFloat(quantileOf(validFloats(this.data), 0.5))
    public function quantile(q : double) : Scalar =
        Scalar.ofFloat(quantileOf(validFloats(this.data), q))
    public function quantile(qs : List[double]) : Series {
        let values := qs.map(q => quantileOf(validFloats(this.data), q)).toList()
        Series(this.name, Column.floats(values), Column.floats(qs), "")
    }
    public function std(ddof : Int = 1) : Scalar =
        Scalar.ofFloat(sqrt(varianceOf(validFloats(this.data), ddof)))
    public function variance(ddof : Int = 1) : Scalar =
        Scalar.ofFloat(varianceOf(validFloats(this.data), ddof))
    public function sem(ddof : Int = 1) : Scalar = Scalar.ofFloat(semOf(validFloats(this.data)))
    public function skew() : Scalar = Scalar.ofFloat(skewOf(validFloats(this.data)))
    public function kurt() : Scalar = Scalar.ofFloat(kurtosisOf(validFloats(this.data)))
    public function prod() : Scalar =
        Scalar.ofFloat(validFloats(this.data).fold(1.0, (a, b) => a * b))
    public function any() : Bool = truthyColumn(this.data).any(x => x)
    public function all() : Bool = truthyPresent(this.data).all(x => x)

    public function nunique() : Int =
        firstOccurrences(this.data.keys().toList()).length() -
            (if countValid(this.data) < this.data.size then 1 else 0)

    public function idxMax() : Scalar = this.extremeLabel(true)
    public function idxMin() : Scalar = this.extremeLabel(false)

    public function argMax() : Int = this.extremePosition(true)
    public function argMin() : Int = this.extremePosition(false)

    function extremePosition(wantMax : Bool) : Int {
        let valid := [i for (i, m) in indexRange(this.data.size).zip(this.data.missing) if !m]
        if valid.length() == 0 { return -1 }
        match orderBy(this.data, valid, !wantMax).first() { Some(p) => p, None => -1 }
    }

    function extremeLabel(wantMax : Bool) : Scalar {
        let at := this.extremePosition(wantMax)
        if at < 0 { return Scalar.missing() }
        scalarAt(this.index, at)
    }

    // ---- value sets

    public function unique() : Series {
        let firsts := firstOccurrences(this.data.keys().toList())
        Series(this.name, this.data.gather(firsts), Column.ints(indexRange(firsts.length())), "")
    }

    public function duplicated(keep : String = "first") : Series =
        this.derive(Column.bools(duplicateFlags(this.data.keys().toList(), keep)))

    public function dropDuplicates(keep : String = "first") : Series =
        this.take(keepPositions(this.data.keys().toList(), keep))

    public function valueCounts(
        ascending : Bool = false,
        normalize : Bool = false,
        sort : Bool = true,
        dropNa : Bool = true,
    ) : Series {
        // Text columns skip the key strings and the per-group position lists:
        // the values themselves are the map keys.
        if this.data.kind == KIND_STR && dropNa {
            let (codes, width) := __columnCodes(this.data)
            let codeAt := codes.toArray()
            let tally := __columnCodeCounts(codes, width).toArray()
            let gone := this.data.missing.toArray()
            let mut firstSeen := Array(width, -1)
            for (i in range(codeAt.length())) {
                let c := codeAt[i]
                if firstSeen[c] < 0 { firstSeen[c] = i }
            }
            let mut kept : Array[Int] = Array.empty()
            for (c in range(width)) {
                if !gone[firstSeen[c]] { kept.append(c) }
            }
            let keptCodes := kept.toList()
            let counts := [tally[c] for c in keptCodes]
            let firsts := [firstSeen[c] for c in keptCodes]
            let order : List[Int] =
                if sort then indexRange(counts.length()).sorted(
                    key = i => if ascending then counts.toArray()[i] else -counts.toArray()[i],
                )
                else indexRange(counts.length())
            let firstTable := firsts.toArray()
            let positions := [firstTable[i] for i in order]
            let valuesOut :=
                if normalize then if counts.length() == 0 then Column.floats([])
                else Column.floats(
                    pick(counts, order).map(c => c.toDouble() / counts.sum().toDouble()).toList(),
                )
                else Column.ints(pick(counts, order))
            return Series(
                if normalize then "proportion" else "count",
                valuesOut,
                this.data.gather(positions),
                this.name,
            )
        }
        let groups := groupRuns(this.data.keys().toList())
        let wanted :=
            if dropNa then groups.filter(group => !this.data.missing.toArray()[firstOf(group)]).toList()
            else groups
        let counts := wanted.map(group => group.length()).toList()
        let firsts := wanted.map(group => firstOf(group)).toList()
        let order : List[Int] =
            if sort then indexRange(counts.length()).sorted(
                key = i => if ascending then counts.toArray()[i] else -counts.toArray()[i],
            )
            else indexRange(counts.length())
        let table := firsts.toArray()
        let positions := [table[i] for i in order]
        let values :=
            if normalize then if counts.length() == 0 then Column.floats([])
            else Column.floats(
                pick(counts, order).map(c => c.toDouble() / counts.sum().toDouble()).toList(),
            )
            else Column.ints(pick(counts, order))
        Series(
            if normalize then "proportion" else "count",
            values,
            this.data.gather(positions),
            this.name,
        )
    }

    public function mode() : Series {
        let counts := this.valueCounts()
        if counts.length() == 0 { return counts }
        let top := counts.data.ints.toArray()[0]
        let winners := truePositions(counts.data.ints.map(c => c == top).toList())
        Series(
            this.name,
            counts.index.gather(winners),
            Column.ints(indexRange(winners.length())),
            "",
        )
    }

    // ---- running and shifted values

    public function cumSum() : Series = this.derive(runningTotals(this.data, 0))
    public function cumProd() : Series = this.derive(runningTotals(this.data, 1))
    public function cumMax() : Series = this.derive(runningTotals(this.data, 2))
    public function cumMin() : Series = this.derive(runningTotals(this.data, 3))

    public function shift(periods : Int = 1) : Series =
        this.derive(
            gatherGaps(
                this.data,
                [i - periods for i in range(this.data.size)].map(
                    p => if p < 0 || p >= this.data.size then -1 else p,
                ).toList(),
            ),
        )

    public function diff(periods : Int = 1) : Series = this.subtract(this.shift(periods))

    public function pctChange(periods : Int = 1) : Series =
        this.divide(this.shift(periods)).subtract(1)

    public function rolling(window : Int, minPeriods : Int = -1) : Rolling =
        Rolling(this.copy(), window, if minPeriods < 0 then window else minPeriods)

    public function expanding(minPeriods : Int = 1) : Expanding = Expanding(this.copy(), minPeriods)

    // ewm builds an exponentially weighted window. The smoothing factor must lie in (0, 1].
    public function ewm(alpha : double, adjust : Bool = true, minPeriods : Int = 0) : EWM =
        EWM(this.copy(), alpha, adjust, minPeriods)

    public function ewmSpan(span : Int, adjust : Bool = true, minPeriods : Int = 0) : EWM =
        EWM(
            this.copy(),
            if span <= 0 then 1.0 else 2.0 / (span.toDouble() + 1.0),
            adjust,
            minPeriods,
        )

    public function ewmHalfLife(halflife : double, adjust : Bool = true, minPeriods : Int = 0) : EWM =
        EWM(
            this.copy(),
            if halflife <= 0.0 then 1.0 else 1.0 - 0.5.pow(1.0 / halflife),
            adjust,
            minPeriods,
        )

    // rank gives each entry its place in sorted order. Ties average by default; method may
    // be "average", "min", "max", "first" or "dense". pct scales ranks to (0, 1].
    public function rank(
        ascending : Bool = true,
        method : String = "average",
        pct : Bool = false,
    ) : Series = this.derive(rankColumn(this.data, ascending, method, pct))

    // ---- element-wise functions

    public function apply(f : double -> double) : Series =
        this.derive(Column.ofFloats(this.data.toFloats().map(f).toList(), this.data.missing))

    public function applyInt(f : Int -> Int) : Series =
        this.derive(
            Column.ofInts(toKind(this.data, KIND_INT).ints.map(f).toList(), this.data.missing),
        )

    public function applyString(f : String -> String) : Series =
        this.derive(Column.ofStrings(this.data.texts().map(f).toList(), this.data.missing))

    public function applyBool(f : double -> Bool) : Series =
        this.derive(Column.bools(this.data.toFloats().map(f).toList()))

    // map lifts each cell to a Scalar, applies f, and lets the result choose the column kind.
    public function map(f : Scalar -> Scalar) : Series =
        this.derive(columnOfScalars(this.toScalars().map(f).toList()))

    public function replace(old : String, replacement : String) : Series =
        this.derive(
            Column.ofStrings(
                this.data.strs.map(s => if s == old then replacement else s).toList(),
                this.data.missing,
            ),
        )

    public function replace(old : Int, replacement : Int) : Series =
        if this.data.kind ==
            KIND_INT then this.derive(
                Column.ofInts(
                    this.data.ints.map(x => if x == old then replacement else x).toList(),
                    this.data.missing,
                ),
            )
        else this.replace(old.toDouble(), replacement.toDouble())

    public function replace(old : double, replacement : double) : Series =
        this.derive(
            Column.ofFloats(
                this.data.toFloats().map(x => if x == old then replacement else x).toList(),
                this.data.missing,
            ),
        )

    public function replace(old : Bool, replacement : Bool) : Series =
        this.derive(
            Column.ofBools(
                this.data.bools.map(x => if x == old then replacement else x).toList(),
                this.data.missing,
            ),
        )

    public function replace(old : Scalar, replacement : Scalar) : Series =
        this.derive(replaceInColumn(this.data, old, replacement))

    public function replaceMany(pairs : List[(Scalar, Scalar)]) : Series {
        let mut out : Column = this.data.copy()
        for (pair in pairs) {
            match pair {
                (old, replacement) => { out = replaceInColumn(out, old, replacement) },
            }
        }
        this.derive(out)
    }

    public function str() : StringMethods = StringMethods(this.copy())

    // mapValues looks each text up in a fixed table; an absent key becomes missing.
    public function mapValues(mapping : Map[String, String]) : Series {
        let texts := this.data.strs
        let gone :=
            [
                m ||
                    match mapping.get(t) { Some(_) => false, None => true } for (t, m) in texts.zip(
                        this.data.missing,
                    )
            ]
        let mapped := [match mapping.get(t) { Some(value) => value, None => "" } for t in texts]
        this.derive(Column.ofStrings(mapped, gone))
    }

    // splitToFrame expands each text into separate columns, one per split part.
    public function splitToFrame(separator : String) : DataFrame {
        let texts := this.data.strs
        let parts := texts.map(t => t.split(separator)).toList()
        let mut width := 0
        for (row in parts) { width = max(width, row.length()) }
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (k in range(width)) {
            names.append(k.text())
            let gone := [m || k >= row.length() for (row, m) in parts.zip(this.data.missing)]
            let values := [if k < row.length() then row.toArray()[k] else "" for row in parts]
            out.append(Column.ofStrings(values, gone))
        }
        DataFrame(names.toList(), out, this.index.copy(), this.indexName)
    }

    // ---- related values

    public function cov(other : Series, ddof : Int = 1) : Scalar =
        Scalar.ofFloat(covarianceColumns(this.data, other.data, ddof))

    public function corr(other : Series) : Scalar =
        Scalar.ofFloat(correlationColumns(this.data, other.data))

    // autocorr is the correlation of the series with its own lagged values.
    public function autocorr(lag : Int = 1) : Scalar {
        let xs := this.data.toFloats()
        let n := xs.length() - lag
        if lag < 0 || n < 2 { return Scalar.ofFloat(nanValue()) }
        let left := Series([xs.toArray()[lag + i] for i in range(n)])
        let right := Series([xs.toArray()[i] for i in range(n)])
        Scalar.ofFloat(correlation(left, right))
    }

    // factorize gives each distinct present value an integer code, in first-seen order, and
    // returns the codes and the distinct values. Missing entries get code -1.
    public function factorize() : (Series, Series) {
        let keys := this.data.keys().toList()
        let firsts := [i for i in firstOccurrences(keys) if !this.data.missing.toArray()[i]]
        let uniques := this.data.gather(firsts)
        let uniqueCount := uniques.size
        let uniqueKeys := uniques.keys()
        let lookup : MutMap[String, Int] = MutMap()
        for ((code, key) in uniqueKeys.enumerate()) {
            let own := key
            lookup.put(own, code)
        }
        let gone := this.data.missing.toArray()
        let keyArray := keys.toArray()
        let codes :=
            [
                if gone[i] then -1
                    else match lookup.get(keyArray[i]) { Some(code) => code, None => -1 } for i in range(
                        this.data.size,
                    )
            ]
        (
            Series("", Column.ints(codes), this.index.copy(), this.indexName),
            Series(this.name, uniques, Column.ints(indexRange(uniqueCount)), ""),
        )
    }

    public function toCsv(
        separator : String = ",",
        header : Bool = true,
        includeIndex : Bool = true,
    ) : String {
        let mut lines : Array[String] = Array.empty()
        if header {
            lines.append(
                joinLists([csvField(this.indexName, separator)], [csvField(this.name, separator)]).join(
                    separator,
                ),
            )
        }
        let exact :=
            if this.data.kind == KIND_FLOAT then this.data.floats.map(x => x.text()).toList()
            else this.data.texts()
        let indexTexts := this.index.texts()
        let gone := this.data.missing.toArray()
        for (i in range(this.data.size)) {
            let value := if gone[i] then "" else csvField(exact.toArray()[i], separator)
            let label := csvField(indexTexts.toArray()[i], separator)
            lines.append(if includeIndex then label + separator + value else value)
        }
        lines.toList().join("\n") + "\n"
    }

    public function toTensor() : DynTensor[double] =
        Tensor(this.data.toFloats(), shape = (this.data.size,))

    // concat stacks series one below the other, keeping each series' own values.
    public static function concat(parts : List[Series]) : Series {
        let mut name := ""
        let mut indexName := ""
        let mut data := Column.ints([])
        let mut index := Column.ints([])
        let mut first := true
        let mut sameName := true
        for (part in parts) {
            if first {
                name = part.name
                indexName = part.indexName
                data = part.data.copy()
                index = part.index.copy()
                first = false
            } else {
                if part.name != name { sameName = false }
                data = joinMixed(data, part.data.copy())
                index = joinMixed(index, part.index.copy())
            }
        }
        Series(if sameName then name else "", data, index, indexName)
    }

    public function append(other : Series) : Series = Series.concat([this.copy(), other.copy()])

    // combineFirst keeps this series and fills its missing entries from other.
    public function combineFirst(other : Series) : Series {
        let left := this.data.missing.toArray()
        let n := min(this.data.size, other.data.size)
        let items :=
            [
                if i < n && left[i] then scalarAt(other.data, i)
                    else scalarAt(this.data, i) for i in range(this.data.size)
            ]
        this.derive(columnOfScalars(items))
    }

    // update keeps other's present entries and this series' entries elsewhere.
    public function update(other : Series) : Series {
        let right := other.data.missing.toArray()
        let n := min(this.data.size, other.data.size)
        let items :=
            [
                if i < n && !right[i] then scalarAt(other.data, i)
                    else scalarAt(this.data, i) for i in range(this.data.size)
            ]
        this.derive(columnOfScalars(items))
    }

    // ---- summaries

    public function describe() : Series {
        if this.data.isNumeric() {
            let xs := validFloats(this.data)
            let labels := ["count", "mean", "std", "min", "25%", "50%", "75%", "max"]
            let values :=
                [
                    xs.length().toDouble(),
                    meanOf(xs),
                    sqrt(varianceOf(xs, 1)),
                    quantileOf(xs, 0.0),
                    quantileOf(xs, 0.25),
                    quantileOf(xs, 0.5),
                    quantileOf(xs, 0.75),
                    quantileOf(xs, 1.0),
                ]
            return Series(this.name, Column.floats(values), Column.strings(labels), "")
        }
        let counts := this.valueCounts()
        let top := match counts.index.texts().first() { Some(t) => t, None => "NaN" }
        let freq := match counts.data.ints.first() { Some(c) => c.text(), None => "0" }
        Series(
            this.name,
            Column.strings([this.count().text(), this.nunique().text(), top, freq]),
            Column.strings(["count", "unique", "top", "freq"]),
            "",
        )
    }

    public function toFrame() : DataFrame = DataFrame([this.copy()])

    // ---- display

    public function text() : String {
        let n := this.data.size
        let lines := seriesLines(this.index.texts(), this.data.texts(), this.data.isNumeric())
        let header := if this.indexName == "" then [] else [this.indexName]
        let label := if this.name == "" then "" else "Name: " + this.name + ", "
        let length := if n > MAX_ROWS then "Length: " + n.text() + ", " else ""
        let footer := label + length + "dtype: " + this.data.dtype()
        if n == 0 {
            return "Series([], " +
                (if this.name == "" then "" else "Name: " + this.name + ", ") +
                "dtype: " + this.data.dtype() + ")"
        }
        joinLists(joinLists(header, lines), [footer]).join("\n")
    }

    public function html() : String {
        tableHtml(
            [if this.name == "" then "0" else this.name],
            this.index.texts(),
            [this.data.texts()],
            this.indexName,
        )
    }
}

// ---------------------------------------------------------------- rolling windows

public class Rolling {
    public final series : Series
    public final window : Int
    public final minPeriods : Int

    new(move series : Series, window : Int) {
        this.series = series
        this.window = window
        this.minPeriods = window
    }

    new(move series : Series, window : Int, minPeriods : Int) {
        this.series = series
        this.window = window
        this.minPeriods = minPeriods
    }

    public function mean() : Series =
        this.series.derive(rollingMean(this.series.data, this.window, this.minPeriods))
    public function sum() : Series =
        this.series.derive(rollingSum(this.series.data, this.window, this.minPeriods))
    public function min() : Series =
        this.series.derive(windowed(this.series.data, this.window, this.minPeriods, 2))
    public function max() : Series =
        this.series.derive(windowed(this.series.data, this.window, this.minPeriods, 3))
    public function std() : Series =
        this.series.derive(windowed(this.series.data, this.window, this.minPeriods, 4))
    public function variance() : Series =
        this.series.derive(windowed(this.series.data, this.window, this.minPeriods, 7))
    public function median() : Series =
        this.series.derive(windowed(this.series.data, this.window, this.minPeriods, 6))
    public function count() : Series =
        this.series.derive(rollingCount(this.series.data, this.window, this.minPeriods))
    public function sem() : Series =
        this.series.derive(windowed(this.series.data, this.window, this.minPeriods, 8))
    public function skew() : Series =
        this.series.derive(windowed(this.series.data, this.window, this.minPeriods, 9))
    public function kurt() : Series =
        this.series.derive(windowed(this.series.data, this.window, this.minPeriods, 10))
    public function quantile(q : double) : Series =
        this.series.derive(windowedQuantile(this.series.data, this.window, this.minPeriods, q))
    public function apply(f : List[double] -> double) : Series =
        this.series.derive(windowedApply(this.series.data, this.window, this.minPeriods, f))
}

// Expanding applies a statistic to every entry from the start through the current row.
public class Expanding {
    public final series : Series
    public final minPeriods : Int

    new(move series : Series, minPeriods : Int) {
        this.series = series
        this.minPeriods = minPeriods
    }

    function window() : Int = max(1, this.series.data.size)

    public function mean() : Series =
        this.series.derive(windowed(this.series.data, this.window(), this.minPeriods, 0))
    public function sum() : Series =
        this.series.derive(windowed(this.series.data, this.window(), this.minPeriods, 1))
    public function min() : Series =
        this.series.derive(windowed(this.series.data, this.window(), this.minPeriods, 2))
    public function max() : Series =
        this.series.derive(windowed(this.series.data, this.window(), this.minPeriods, 3))
    public function std() : Series =
        this.series.derive(windowed(this.series.data, this.window(), this.minPeriods, 4))
    public function variance() : Series =
        this.series.derive(windowed(this.series.data, this.window(), this.minPeriods, 7))
    public function median() : Series =
        this.series.derive(windowed(this.series.data, this.window(), this.minPeriods, 6))
    public function count() : Series =
        this.series.derive(windowed(this.series.data, this.window(), this.minPeriods, 5))
    public function sem() : Series =
        this.series.derive(windowed(this.series.data, this.window(), this.minPeriods, 8))
    public function quantile(q : double) : Series =
        this.series.derive(windowedQuantile(this.series.data, this.window(), this.minPeriods, q))
    public function apply(f : List[double] -> double) : Series =
        this.series.derive(windowedApply(this.series.data, this.window(), this.minPeriods, f))
}

// EWM holds exponentially weighted settings; missing entries stay missing and do not update
// the running weights.
public class EWM {
    public final series : Series
    public final alpha : double
    public final adjust : Bool
    public final minPeriods : Int

    new(move series : Series, alpha : double, adjust : Bool, minPeriods : Int) {
        this.series = series
        this.alpha = alpha
        this.adjust = adjust
        this.minPeriods = minPeriods
    }

    function values(statistic : Int, bias : Bool) : Column =
        ewmColumn(this.series.data, this.alpha, this.adjust, this.minPeriods, statistic, bias)

    public function mean() : Series = this.series.derive(this.values(0, true))
    public function sum() : Series = this.series.derive(this.values(1, true))
    public function variance(bias : Bool = false) : Series =
        this.series.derive(this.values(2, bias))
    public function std(bias : Bool = false) : Series = this.series.derive(this.values(3, bias))
    public function count() : Series = this.series.derive(this.values(4, true))
}

// ---------------------------------------------------------------- string methods

public class StringMethods {
    public final series : Series

    new(move series : Series) {
        this.series = series
    }

    function mapped(f : String -> String) : Series =
        this.series.derive(
            Column.ofStrings(this.series.data.strs.map(f).toList(), this.series.data.missing),
        )

    function tested(f : String -> Bool) : Series =
        this.series.derive(
            Column.ofBools(this.series.data.strs.map(f).toList(), this.series.data.missing),
        )

    public function upper() : Series = this.mapped(s => s.toUpper())
    public function lower() : Series = this.mapped(s => s.toLower())
    public function swapcase() : Series = this.mapped(s => swapCaseText(s))
    public function strip() : Series = this.mapped(s => s.trim())
    public function stripLeading() : Series = this.mapped(s => trimLeading(s))
    public function stripTrailing() : Series = this.mapped(s => trimTrailing(s))
    public function replace(old : String, replacement : String) : Series =
        this.mapped(s => s.replace(old, replacement))
    public function capitalize() : Series =
        this.mapped(
            s =>
                if s.length() == 0 then s
                else s[0].toUpper() + sliceString(s, 1, s.length()).toLower(),
        )
    public function title() : Series = this.mapped(s => titleCase(s))
    public function slice(start : Int, stop : Int) : Series =
        this.mapped(s => sliceString(s, min(start, s.length()), min(stop, s.length())))
    public function sliceReplace(start : Int, stop : Int, replacement : String) : Series =
        this.mapped(
            s =>
                sliceString(s, 0, min(start, s.length())) +
                    replacement + sliceString(s, min(stop, s.length()), s.length()),
        )
    public function cat(other : String) : Series = this.mapped(s => s + other)
    public function repeat(times : Int) : Series = this.mapped(s => repeatText(s, max(0, times)))
    public function pad(width : Int) : Series = this.mapped(s => padLeft(s, width))
    public function ljust(width : Int) : Series = this.mapped(s => padRight(s, width))
    public function rjust(width : Int) : Series = this.mapped(s => padLeft(s, width))
    public function center(width : Int) : Series = this.mapped(s => centerText(s, width))
    public function zfill(width : Int) : Series =
        this.mapped(s => repeatText("0", max(0, width - s.length())) + s)
    public function contains(part : String) : Series = this.tested(s => s.contains(part))
    public function startsWith(part : String) : Series = this.tested(s => s.startsWith(part))
    public function endsWith(part : String) : Series = this.tested(s => s.endsWith(part))
    public function isEmpty() : Series = this.tested(s => s.length() == 0)

    public function len() : Series =
        this.series.derive(
            Column.ofInts(
                this.series.data.strs.map(s => s.length()).toList(),
                this.series.data.missing,
            ),
        )

    public function count(part : String) : Series =
        this.series.derive(
            Column.ofInts(
                this.series.data.strs.map(s => textCount(s, part)).toList(),
                this.series.data.missing,
            ),
        )

    public function find(part : String) : Series =
        this.series.derive(
            Column.ofInts(
                this.series.data.strs.map(s => findPart(s, part)).toList(),
                this.series.data.missing,
            ),
        )

    public function rfind(part : String) : Series =
        this.series.derive(
            Column.ofInts(
                this.series.data.strs.map(s => rfindPart(s, part)).toList(),
                this.series.data.missing,
            ),
        )

    // get keeps the character at one position; a position outside a text is missing.
    public function get(position : Int) : Series {
        let texts := this.series.data.strs
        let gone :=
            [
                m ||
                    position < 0 ||
                    position >= t.length() for (t, m) in texts.zip(this.series.data.missing)
            ]
        this.series.derive(
            Column.ofStrings(
                [
                    if t.length() == 0 then ""
                        else t[min(max(position, 0), t.length() - 1)] for t in texts
                ],
                gone,
            ),
        )
    }

    // splitPart splits each text at a separator and keeps the part at the given position.
    public function splitPart(separator : String, position : Int) : Series =
        this.mapped(s => nthPart(s.split(separator), position))
}

function nthPart(parts : List[String], position : Int) : String {
    let items := parts.toArray()
    if position >= 0 && position < items.length() { items[position] } else { "" }
}

function findPart(text : String, part : String) : Int {
    if part.length() == 0 { return 0 }
    if part.length() > text.length() { return -1 }
    for (i in range(text.length() - part.length() + 1)) {
        if sliceString(text, i, i + part.length()) == part { return i }
    }
    -1
}

function rfindPart(text : String, part : String) : Int {
    if part.length() == 0 { return text.length() }
    if part.length() > text.length() { return -1 }
    for (i in range(text.length() - part.length(), -1, -1)) {
        if sliceString(text, i, i + part.length()) == part { return i }
    }
    -1
}

function textCount(text : String, part : String) : Int {
    if part.length() == 0 { return text.length() + 1 }
    let mut at := 0
    let mut total := 0
    while at + part.length() <= text.length() {
        if sliceString(text, at, at + part.length()) == part {
            total = total + 1
            at = at + part.length()
        } else {
            at = at + 1
        }
    }
    total
}

function repeatText(text : String, times : Int) : String {
    let mut out : Array[String] = Array.empty()
    for (i in range(times)) { out.append(text) }
    out.toList().join("")
}

function centerText(text : String, width : Int) : String {
    let total := max(0, width - text.length())
    let left := total / 2
    spaces(left) + text + spaces(total - left)
}

function trimLeading(text : String) : String {
    let mut start := 0
    while start < text.length() &&
        (text[start] == " " || text[start] == "\t" || text[start] == "\n" || text[start] == "\r") {
            start = start + 1
        }
    sliceString(text, start, text.length())
}

function trimTrailing(text : String) : String {
    let mut stop := text.length()
    while stop > 0 &&
        (
            text[stop - 1] == " " ||
                text[stop - 1] == "\t" || text[stop - 1] == "\n" || text[stop - 1] == "\r"
        ) {
            stop = stop - 1
        }
    sliceString(text, 0, stop)
}

function swapCaseText(text : String) : String {
    let mut out : Array[String] = Array.empty()
    for (i in range(text.length())) {
        let ch := text[i]
        if ch.toUpper() != ch {
            out.append(ch.toLower())
        } else if ch.toLower() != ch {
            out.append(ch.toUpper())
        } else {
            out.append(ch)
        }
    }
    out.toList().join("")
}

function titleCase(text : String) : String {
    let mut out : Array[String] = Array.empty()
    let mut startOfWord := true
    for (i in range(text.length())) {
        let ch := text[i]
        if startOfWord { out.append(ch.toUpper()) } else { out.append(ch.toLower()) }
        startOfWord = ch == " " || ch == "-" || ch == "_"
    }
    out.toList().join("")
}

// ---------------------------------------------------------------- aggregation by name

// aggregate reduces a whole column with a statistic given by name, as agg("mean") does.
// aggregateGroups accumulates one statistic per group in one pass over the column.
function aggregateGroups(c : Column, owner : Array[Int], groups : Int, statistic : String) : Column {
    let counts := Array(groups, 0)
    let gone := c.missing.toArray()
    if statistic == "count" {
        for (i in range(c.size)) {
            if !gone[i] { counts[owner[i]] = counts[owner[i]] + 1 }
        }
        return Column.ofInts([counts[g] for g in range(groups)], [false for g in range(groups)])
    }
    if statistic == "mean" {
        let sums := Array(groups, 0.0)
        if c.kind == KIND_INT {
            let xs := c.ints
            for (i in range(c.size)) {
                if !gone[i] {
                    let g := owner[i]
                    counts[g] = counts[g] + 1
                    sums[g] = sums[g] + xs.at(i).toDouble()
                }
            }
        } else {
            let xs := c.floats
            for (i in range(c.size)) {
                if !gone[i] {
                    let g := owner[i]
                    counts[g] = counts[g] + 1
                    sums[g] = sums[g] + xs.at(i)
                }
            }
        }
        return Column.floats(
            [
                if counts[g] == 0 then nanValue()
                    else sums[g] / counts[g].toDouble() for g in range(groups)
            ],
        )
    }
    // A whole-number column keeps an exact whole-number sum. Accumulating in a
    // double would round values above 2^53, so Int sums stay Int.
    if c.kind == KIND_INT {
        let sums := Array(groups, 0)
        let xs := c.ints
        for (i in range(c.size)) {
            if !gone[i] {
                let g := owner[i]
                sums[g] = sums[g] + xs.at(i)
            }
        }
        return Column.ofInts([sums[g] for g in range(groups)], [false for g in range(groups)])
    }
    let sums := Array(groups, 0.0)
    let xs := c.floats
    for (i in range(c.size)) {
        if !gone[i] {
            let g := owner[i]
            sums[g] = sums[g] + xs.at(i)
        }
    }
    Column.floats([sums[g] for g in range(groups)])
}

function aggregate(c : Column, statistic : String) : Scalar {
    if statistic == "sum" { return sumColumn(c) }
    if statistic == "mean" { return Scalar.ofFloat(meanOf(validFloats(c))) }
    if statistic == "min" { return extremum(c, false) }
    if statistic == "max" { return extremum(c, true) }
    if statistic == "count" { return Scalar.ofInt(countValid(c)) }
    if statistic == "size" { return Scalar.ofInt(c.size) }
    if statistic == "median" { return Scalar.ofFloat(quantileOf(validFloats(c), 0.5)) }
    if statistic == "std" { return Scalar.ofFloat(sqrt(varianceOf(validFloats(c), 1))) }
    if statistic == "var" { return Scalar.ofFloat(varianceOf(validFloats(c), 1)) }
    if statistic == "sem" { return Scalar.ofFloat(semOf(validFloats(c))) }
    if statistic == "skew" { return Scalar.ofFloat(skewOf(validFloats(c))) }
    if statistic == "kurt" { return Scalar.ofFloat(kurtosisOf(validFloats(c))) }
    if statistic == "any" { return Scalar.ofBool(truthyColumn(c).any(x => x)) }
    if statistic == "all" { return Scalar.ofBool(truthyPresent(c).all(x => x)) }
    if statistic == "prod" { return Scalar.ofFloat(validFloats(c).fold(1.0, (a, b) => a * b)) }
    if statistic == "nunique" {
        let keys := c.keys()
        let distinct := firstOccurrences(keys).length()
        return Scalar.ofInt(distinct - (if countValid(c) < c.size then 1 else 0))
    }
    if statistic == "first" {
        let valid := [i for (i, m) in indexRange(c.size).zip(c.missing) if !m]
        return match valid.first() { Some(i) => scalarAt(c, i), None => Scalar.missing() }
    }
    if statistic == "last" {
        let valid := [i for (i, m) in indexRange(c.size).zip(c.missing) if !m]
        return match valid.last() { Some(i) => scalarAt(c, i), None => Scalar.missing() }
    }
    Scalar.missing()
}

// statisticNeedsNumbers says whether the named statistic only makes sense for number columns.
function statisticNeedsNumbers(statistic : String) : Bool =
    statistic == "sum" ||
        statistic == "mean" ||
        statistic == "median" ||
        statistic == "std" ||
        statistic == "var" ||
        statistic == "prod" || statistic == "sem" || statistic == "skew" || statistic == "kurt"

// columnOfScalars builds one column from a list of scalars, widening Int to double when mixed.
function columnOfScalars(items : List[Scalar]) : Column {
    let missing := items.map(s => s.isMissing()).toList()
    let present := items.filter(s => !s.isMissing()).toList()
    let anyFloat := present.any(s => s.kind == KIND_FLOAT)
    let anyString := present.any(s => s.kind == KIND_STR)
    let anyBool := present.any(s => s.kind == KIND_BOOL)
    let anyInt := present.any(s => s.kind == KIND_INT)
    if anyString || (anyBool && (anyFloat || anyInt)) {
        return Column.ofStrings(items.map(s => s.text()).toList(), missing)
    }
    if anyBool { return Column.ofBools(items.map(s => s.flag).toList(), missing) }
    if anyFloat || (!anyInt && present.length() == 0) {
        return Column.ofFloats(items.map(s => s.asDouble()).toList(), missing)
    }
    Column.ofInts(items.map(s => s.whole).toList(), missing)
}

// ---------------------------------------------------------------- csv

function dropCsvRows(rows : List[List[String]], count : Int) : List[List[String]] {
    let items := rows.toArray()
    [items[i] for i in range(min(max(count, 0), items.length()), items.length())]
}

function takeCsvRows(rows : List[List[String]], count : Int) : List[List[String]] {
    let items := rows.toArray()
    [items[i] for i in range(min(max(count, 0), items.length()))]
}

// parseCsvLines reads CSV text line by line. A line that ends inside a quoted field is
// joined to the next one, so a quoted newline stays inside its field. Scanning per line
// avoids indexing a large String once per character.
function parseCsvRecords(physical : List[String], separator : String) : List[List[String]] {
    let mut rows : Array[List[String]] = Array.empty()
    let mut pending := ""
    let mut quoted := false
    let mut hasPending := false
    for (line in physical) {
        let clean := if line.contains("\r") then line.replace("\r", "") else line
        if !quoted && !hasPending && !clean.contains("\"") {
            let fields := clean.split(separator)
            let blank :=
                match fields.first() {
                    Some(first) => fields.length() == 1 && first.trim().length() == 0,
                    None => true,
                }
            if !blank { rows.append(fields) }
            continue
        }
        if hasPending {
            pending = pending + "\n" + clean
        } else {
            pending = clean
            hasPending = true
        }
        // An escaped pair of quotes contributes two to this count, so only an odd
        // count changes whether the record ends inside a quoted field.
        let quotes := clean.split("\"").length() - 1
        if quotes % 2 == 1 { quoted = !quoted }
        if !quoted {
            let fields := splitCsvLine(pending, separator)
            let blank :=
                match fields.first() {
                    Some(first) => fields.length() == 1 && first.trim().length() == 0,
                    None => true,
                }
            if !blank { rows.append(fields) }
            pending = ""
            hasPending = false
        }
    }
    if hasPending {
        let fields := splitCsvLine(pending, separator)
        let blank :=
            match fields.first() {
                Some(first) => fields.length() == 1 && first.trim().length() == 0,
                None => true,
            }
        if !blank { rows.append(fields) }
    }
    rows.toList()
}

// parseCsvFlat keeps fields in one flat array while preserving the record
// boundaries. It avoids allocating a List object for every CSV row.
function parseCsvFlat(physical : List[String], separator : String) : (Array[String], Int, Int) {
    let mut fields : Array[String] = Array.empty()
    let mut width := 0
    let mut rows := 0
    let mut pending := ""
    let mut quoted := false
    let mut hasPending := false
    let mut appendFields := (row : Array[String]) => {
        for (field in row) {
            if rows == 0 { width = width + 1 }
            fields.append(field)
        }
        rows = rows + 1
    }
    for (line in physical) {
        let clean := if line.contains("\r") then line.replace("\r", "") else line
        if !quoted && !hasPending && !clean.contains("\"") {
            let parts := clean.splitArray(separator)
            let blank := parts.length() == 1 && parts[0].trim().length() == 0
            if !blank { appendFields(parts) }
            continue
        }
        if hasPending {
            pending = pending + "\n" + clean
        } else {
            pending = clean
            hasPending = true
        }
        let quotes := clean.split("\"").length() - 1
        if quotes % 2 == 1 { quoted = !quoted }
        if !quoted {
            let parts := splitCsvLine(pending, separator)
            let blank :=
                match parts.first() {
                    Some(first) => parts.length() == 1 && first.trim().length() == 0,
                    None => true,
                }
            if !blank { appendFields(parts.toArray()) }
            pending = ""
            hasPending = false
        }
    }
    if hasPending {
        let parts := splitCsvLine(pending, separator)
        let blank :=
            match parts.first() {
                Some(first) => parts.length() == 1 && first.trim().length() == 0,
                None => true,
            }
        if !blank { appendFields(parts.toArray()) }
    }
    (fields, width, rows)
}

function parseCsvRows(text : String, separator : String) : List[List[String]] =
    parseCsvRecords(text.split("\n"), separator)

// splitCsvLine cuts one line at commas, honouring double quotes.
function splitCsvLine(line : String, separator : String) : List[String] {
    if !line.contains("\"") { return line.split(separator) }
    let mut fields : Array[String] = Array.empty()
    let mut current : Array[String] = Array.empty()
    let mut quoted := false
    let mut i := 0
    let n := line.length()
    while i < n {
        let ch := line[i]
        if quoted {
            if ch == "\"" && i + 1 < n && line[i + 1] == "\"" {
                current.append("\"")
                i = i + 1
            } else if ch == "\"" {
                quoted = false
            } else {
                current.append(ch)
            }
        } else if ch == "\"" {
            quoted = true
        } else if ch == separator {
            fields.append(current.toList().join(""))
            current = Array.empty()
        } else {
            current.append(ch)
        }
        i = i + 1
    }
    fields.append(current.toList().join(""))
    fields.toList()
}

function isMissingText(text : String) : Bool =
    text == "" ||
        text == "NaN" ||
        text == "nan" ||
        text == "NA" || text == "N/A" || text == "null" || text == "NULL" || text == "None"

function isIntText(text : String) : Bool = match parseInt(text) { n => true, _ => false }

function isFloatText(text : String) : Bool = match parseDouble(text) { x => true, _ => false }

function isBoolText(text : String) : Bool =
    text == "True" || text == "False" || text == "true" || text == "false"

// columnFromTexts guesses the narrowest kind that holds every non-missing text.
function digitChar(ch : String) : Bool = ch.compare("0") >= 0 && ch.compare("9") <= 0

// numericShape says whether a CSV field looks like an integer (1), a float (2),
// or neither (0). It inspects the short token instead of trying both parsers.
function numericShape(text : String) : Int {
    let n := text.length()
    if n == 0 { return 0 }
    let mut i := 0
    if text[i] == "-" || text[i] == "+" { i = i + 1 }
    let mut digits := 0
    let mut dot := false
    let mut exponent := false
    if i < n && text[i] == "." {
        dot = true
        i = i + 1
        while i < n && digitChar(text[i]) { i = i + 1; digits = digits + 1 }
    } else {
        while i < n && digitChar(text[i]) { i = i + 1; digits = digits + 1 }
        if i < n && text[i] == "." {
            dot = true
            i = i + 1
            while i < n && digitChar(text[i]) { i = i + 1; digits = digits + 1 }
        }
    }
    if digits == 0 { return 0 }
    if i < n && (text[i] == "e" || text[i] == "E") {
        exponent = true
        i = i + 1
        if i < n && (text[i] == "-" || text[i] == "+") { i = i + 1 }
        let mut expDigits := 0
        while i < n && digitChar(text[i]) { i = i + 1; expDigits = expDigits + 1 }
        if expDigits == 0 { return 0 }
    }
    if i != n { return 0 }
    if dot || exponent then 2 else 1
}

function columnFromTexts(texts : List[String]) : Column {
    let missing := texts.map(t => isMissingText(t)).toList()
    let present := [t for (t, m) in texts.zip(missing) if !m]
    if present.length() > 0 {
        // Every present cell must fit the chosen kind. One numeric cell next to
        // a text cell makes the column text, not a number.
        let mut allInts := true
        let mut allNumeric := true
        for (t in present) {
            let shape := numericShape(t)
            if shape != 1 { allInts = false }
            if shape == 0 { allNumeric = false }
        }
        if allInts {
            return Column.ofInts(
                [
                    if m then 0
                        else match parseInt(t) { n => n, _ => 0 } for (t, m) in texts.zip(missing)
                ],
                missing,
            )
        }
        if allNumeric {
            return Column.ofFloats(
                [
                    if m then 0.0
                        else match parseDouble(t) { x => x, _ => 0.0 } for (t, m) in texts.zip(
                            missing,
                        )
                ],
                missing,
            )
        }
        if present.all(t => isBoolText(t)) {
            return Column.ofBools([t == "True" || t == "true" for t in texts], missing)
        }
    }
    Column.ofStrings(texts, missing)
}

function csvField(text : String, separator : String) : String {
    if charAt(text, separator) >= 0 || charAt(text, "\"") >= 0 || charAt(text, "\n") >= 0 {
        "\"" + text.replace("\"", "\"\"") + "\""
    } else {
        text
    }
}

function joinMixed(a : Column, b : Column) : Column {
    if a.kind == b.kind { return a.join(b) }
    if a.isNumeric() && b.isNumeric() { return toKind(a, KIND_FLOAT).join(toKind(b, KIND_FLOAT)) }
    toKind(a, KIND_STR).join(toKind(b, KIND_STR))
}

// coalesce keeps the first column's entries and fills its missing ones from the second.
function coalesce(a : Column, b : Column) : Column {
    if a.kind != b.kind { return a.copy() }
    let gone := [x && y for (x, y) in a.missing.zip(b.missing)]
    let first := a.missing.toArray()
    let n := a.size
    if a.kind == KIND_INT {
        let xs := a.ints.toArray()
        let ys := b.ints.toArray()
        return Column.ofInts([if first[i] then ys[i] else xs[i] for i in range(n)], gone)
    }
    if a.kind == KIND_FLOAT {
        let xs := a.floats.toArray()
        let ys := b.floats.toArray()
        return Column.ofFloats([if first[i] then ys[i] else xs[i] for i in range(n)], gone)
    }
    if a.kind == KIND_BOOL {
        let xs := a.bools.toArray()
        let ys := b.bools.toArray()
        return Column.ofBools([if first[i] then ys[i] else xs[i] for i in range(n)], gone)
    }
    let xs := a.strs.toArray()
    let ys := b.strs.toArray()
    Column.ofStrings([if first[i] then ys[i] else xs[i] for i in range(n)], gone)
}

// ---------------------------------------------------------------- data frames

// A failure of a data frame operation: a column that is not there, or an unusable argument.
public enum DataError extends Error {
    MissingColumn(String)
    BadArgument(String)
}

public class DataFrame {
    has Text

    public final names : List[String]
    private var store : Array[Column]
    public final index : Column
    public final indexName : String
    // The name printed over the index, such as the column that pivotTable spread across the top.
    public var columnsLabel : String

    new(names : List[String], move cols : Array[Column], move index : Column, indexName : String) {
        this.columnsLabel = ""
        this.names = names
        this.store = cols
        this.index = index
        this.indexName = indexName
    }

    // DataFrame(series) builds a frame from named series; they should share a length.
    new(series : List[Series]) {
        let mut cols : Array[Column] = Array.empty()
        let mut names : Array[String] = Array.empty()
        let mut size := 0
        let mut labels := Column.ints([])
        let mut i := 0
        for (s in series) {
            cols.append(s.data.copy())
            names.append(if s.name == "" then i.text() else s.name)
            if i == 0 {
                size = s.data.size
                labels = s.index.copy()
            }
            i = i + 1
        }
        this.names = names.toList()
        this.store = cols
        this.index = labels
        this.indexName = ""
        this.columnsLabel = ""
    }

    new(columns : List[(String, List[Int])]) {
        let mut cols : Array[Column] = Array.empty()
        let mut names : Array[String] = Array.empty()
        let mut size := 0
        for ((name, values) in columns) {
            cols.append(Column.ints(values))
            names.append(name)
            size = values.length()
        }
        this.names = names.toList()
        this.store = cols
        this.index = Column.ints(indexRange(size))
        this.indexName = ""
        this.columnsLabel = ""
    }

    new(columns : List[(String, List[double])]) {
        let mut cols : Array[Column] = Array.empty()
        let mut names : Array[String] = Array.empty()
        let mut size := 0
        for ((name, values) in columns) {
            cols.append(Column.floats(values))
            names.append(name)
            size = values.length()
        }
        this.names = names.toList()
        this.store = cols
        this.index = Column.ints(indexRange(size))
        this.indexName = ""
        this.columnsLabel = ""
    }

    new(columns : List[(String, List[String])]) {
        let mut cols : Array[Column] = Array.empty()
        let mut names : Array[String] = Array.empty()
        let mut size := 0
        for ((name, values) in columns) {
            cols.append(Column.strings(values))
            names.append(name)
            size = values.length()
        }
        this.names = names.toList()
        this.store = cols
        this.index = Column.ints(indexRange(size))
        this.indexName = ""
        this.columnsLabel = ""
    }

    new(columns : List[(String, List[Bool])]) {
        let mut cols : Array[Column] = Array.empty()
        let mut names : Array[String] = Array.empty()
        let mut size := 0
        for ((name, values) in columns) {
            cols.append(Column.bools(values))
            names.append(name)
            size = values.length()
        }
        this.names = names.toList()
        this.store = cols
        this.index = Column.ints(indexRange(size))
        this.indexName = ""
        this.columnsLabel = ""
    }

    // firstMissing names the first of these columns that the frame lacks, or gives "".
    function firstMissing(wanted : List[String]) : String {
        for (name in wanted) {
            if !this.names.contains(name) { return name }
        }
        ""
    }

    // ---- shape and lookup

    public function length() : Int = this.index.size
    public function width() : Int = this.names.length()
    public function shape() : (Int, Int) = (this.index.size, this.names.length())
    public function isEmpty() : Bool = this.index.size == 0 || this.names.length() == 0
    public function columns() : List[String] = this.names
    public function hasColumn(name : String) : Bool = this.names.contains(name)
    public function ndim() : Int = 2
    public function size() : Int = this.index.size * this.names.length()
    public function equals(other : DataFrame) : Bool {
        if this.names != other.names { return false }
        if this.index.keys() != other.index.keys() { return false }
        for (name in this.names) {
            if this.keyColumn(name).keys() != other.keyColumn(name).keys() { return false }
        }
        true
    }

    function position(name : String) : Int =
        match this.names.index(name) { Some(i) => i, None => -1 }

    public function copy() : DataFrame = this.transformColumns(0, 0, Scalar.missing())

    public static function empty() : DataFrame {
        let none : Array[Column] = Array.empty()
        DataFrame([], none, Column.ints([]), "")
    }

    function relabel(names : List[String]) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (c in this.store) { out.append(c.copy()) }
        DataFrame(names, out, this.index.copy(), this.indexName)
    }

    // transformColumns rebuilds every column: mode 0 copies, 1 converts to `kind`, 2 marks
    // missing entries, 3 marks present ones, 4 fills missing entries with `value`.
    function transformColumns(mode : Int, kind : Int, value : Scalar) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (c in this.store) {
            if mode == 1 {
                out.append(toKind(c, kind))
            } else if mode == 2 {
                out.append(Column.bools(c.missing))
            } else if mode == 3 {
                out.append(Column.bools(c.missing.map(m => !m).toList()))
            } else if mode == 4 {
                let compatible :=
                    (c.kind == KIND_FLOAT && value.isNumeric()) ||
                        (c.kind == KIND_INT && value.kind == KIND_INT) ||
                        (c.kind == KIND_STR && value.kind == KIND_STR) ||
                        (c.kind == KIND_BOOL && value.kind == KIND_BOOL)
                if compatible {
                    out.append(fillColumn(c, value))
                } else if c.kind == KIND_FLOAT && value.kind == KIND_INT {
                    out.append(fillColumn(c, Scalar.ofFloat(value.asDouble())))
                } else {
                    out.append(c.copy())
                }
            } else {
                out.append(c.copy())
            }
        }
        DataFrame(this.names, out, this.index.copy(), this.indexName)
    }

    public function dtypes() : Series {
        let mut kinds : Array[String] = Array.empty()
        for (c in this.store) { kinds.append(c.dtype()) }
        Series(kinds.toList()).withIndex(this.names)
    }

    // keyColumn gives a copy of a column's storage by name; the name must exist.
    public function keyColumn(name : String) : Column {
        let at := this.position(name)
        if at < 0 { return Column.empty(KIND_FLOAT, this.index.size) }
        this.store[at].copy()
    }

    // keyCodes factorizes one key column for a multi-key group-by.
    public function keyCodes(name : String) : (List[Int], Int) = {
        columnCodes(this.keyColumn(name))
    }

    function seriesAt(at : Int) : Series =
        Series(this.names.toArray()[at], this.store[at].copy(), this.index.copy(), this.indexName)

    public function col(name : String) : Series or Error {
        let gone := this.firstMissing([name])
        if gone != "" { return MissingColumn(gone) }
        this.seriesAt(this.position(name))
    }

    public function get(name : String) : Option[Series] =
        if this.hasColumn(name) then Some(this.seriesAt(this.position(name))) else None

    // items pairs every column name with its Series.
    public function items() : List[(String, Series)] =
        [(name, this.seriesAt(this.position(name))) for name in this.names]

    public function select(selected : List[String]) : DataFrame or Error {
        let gone := this.firstMissing(selected)
        if gone != "" { return MissingColumn(gone) }
        let mut out : Array[Column] = Array.empty()
        for (name in selected) { out.append(this.store[this.position(name)].copy()) }
        DataFrame(selected, out, this.index.copy(), this.indexName)
    }

    function numericNames() : List[String] {
        let mut out : Array[String] = Array.empty()
        for (i in range(this.store.length())) {
            let c := this.store[i]
            if c.isNumeric() { out.append(this.names.toArray()[i]) }
        }
        out.toList()
    }

    // ---- row selection

    public function take(positions : List[Int]) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (c in this.store) { out.append(c.gather(positions)) }
        DataFrame(this.names, out, this.index.gather(positions), this.indexName)
    }

    public function head(n : Int = 5) : DataFrame {
        let count := if n >= 0 then min(n, this.index.size) else max(0, this.index.size + n)
        this.take(indexRange(count))
    }

    public function tail(n : Int = 5) : DataFrame {
        if n < 0 {
            let skip := min(-n, this.index.size)
            return this.take([skip + i for i in range(this.index.size - skip)])
        }
        let count := min(n, this.index.size)
        this.take([this.index.size - count + i for i in range(count)])
    }

    public function slice(start : Int, stop : Int) : DataFrame {
        let from := max(0, start)
        let to := min(stop, this.index.size)
        this.take([from + i for i in range(max(0, to - from))])
    }

    public function iloc(positions : List[Int]) : DataFrame =
        this.takeGaps(normalizeIndexes(positions, this.index.size))

    public function takeGaps(positions : List[Int]) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (c in this.store) { out.append(gatherGaps(c, positions)) }
        DataFrame(this.names, out, gatherGaps(this.index, positions), this.indexName)
    }

    public function iloc(position : Int) : Series {
        let at := normalizeIndex(position, this.index.size)
        this.row(if at < 0 then 0 else at)
    }

    // row gives one row as a Series indexed by the column names.
    public function row(position : Int) : Series {
        let items := [scalarAt(this.store[i], position) for i in range(this.store.length())]
        Series("", columnOfScalars(items), Column.strings(this.names), "")
    }

    // at reads one cell by row label and column name; iat uses a column position.
    public function at(row : Int, column : String) : Scalar or Error {
        let gone := this.firstMissing([column])
        if gone != "" { return MissingColumn(gone) }
        if row < 0 || row >= this.index.size {
            return BadArgument("row " + row.text() + " is outside the frame")
        }
        scalarAt(this.store[this.position(column)], row)
    }

    public function iat(row : Int, column : Int) : Scalar or Error {
        let at := normalizeIndex(row, this.index.size)
        if at < 0 { return BadArgument("row " + row.text() + " is outside the frame") }
        if column < 0 || column >= this.store.length() {
            return BadArgument("column " + column.text() + " is outside the frame")
        }
        scalarAt(this.store[column], at)
    }

    // iterrows pairs each index label with a row Series.
    public function iterrows() : List[(Scalar, Series)] =
        [(scalarAt(this.index, i), this.row(i)) for i in range(this.index.size)]

    public function filter(mask : Series) : DataFrame =
        this.take(truePositions(presentMask(mask.data)))

    public function loc(label : Int) : DataFrame =
        this.take(truePositions(this.index.keys().map(k => k == "n" + label.text()).toList()))
    public function loc(label : String) : DataFrame =
        this.take(truePositions(this.index.keys().map(k => k == "s" + label).toList()))

    // ---- sorting

    public function sortValues(
        by : String,
        ascending : Bool = true,
        naPosition : String = "last",
    ) : DataFrame or Error {
        let gone := this.firstMissing([by])
        if gone != "" { return MissingColumn(gone) }
        this.take(
            orderByWithNa(
                this.store[this.position(by)],
                indexRange(this.index.size),
                ascending,
                naPosition == "first",
            ),
        )
    }

    public function sortValues(
        by : List[String],
        ascending : Bool = true,
        naPosition : String = "last",
    ) : DataFrame or Error {
        let gone := this.firstMissing(by)
        if gone != "" { return MissingColumn(gone) }
        let mut order := indexRange(this.index.size)
        for (name in reversedStrings(by)) {
            order =
                orderByWithNa(
                    this.store[this.position(name)],
                    order,
                    ascending,
                    naPosition == "first",
                )
        }
        this.take(order)
    }

    public function sortValues(
        by : List[String],
        ascending : List[Bool],
        naPosition : String = "last",
    ) : DataFrame or Error {
        let gone := this.firstMissing(by)
        if gone != "" { return MissingColumn(gone) }
        let mut order := indexRange(this.index.size)
        let names := by.toArray()
        let flags := ascending.toArray()
        for (k in range(by.length())) {
            let i := by.length() - 1 - k
            order =
                orderByWithNa(
                    this.store[this.position(names[i])],
                    order,
                    if i < flags.length() then flags[i] else true,
                    naPosition == "first",
                )
        }
        this.take(order)
    }

    public function sortIndex(ascending : Bool = true, naPosition : String = "last") : DataFrame =
        this.take(
            orderByWithNa(this.index, indexRange(this.index.size), ascending, naPosition == "first"),
        )

    public function nlargest(n : Int, by : String) : DataFrame or Error {
        let gone := this.firstMissing([by])
        if gone != "" { return MissingColumn(gone) }
        this.take(this.keyColumn(by).topPositions(n, false))
    }

    public function nsmallest(n : Int, by : String) : DataFrame or Error {
        let gone := this.firstMissing([by])
        if gone != "" { return MissingColumn(gone) }
        this.take(this.keyColumn(by).topPositions(n, true))
    }

    // ---- reshaping columns

    public function drop(column : String) : DataFrame = this.drop([column])

    public function drop(removed : List[String]) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (i in range(this.store.length())) {
            let c := this.store[i]
            let name := this.names.toArray()[i]
            if !removed.contains(name) {
                names.append(name)
                out.append(c.copy())
            }
        }
        DataFrame(names.toList(), out, this.index.copy(), this.indexName)
    }

    public function dropRows(positions : List[Int]) : DataFrame {
        let gone := positionSet(normalizeIndexes(positions, this.index.size))
        this.take([i for i in range(this.index.size) if !gone.contains(i)])
    }

    public function rename(old : String, replacement : String) : DataFrame =
        this.relabel(this.names.map(n => if n == old then replacement else n).toList())

    public function renameColumns(mapping : Map[String, String]) : DataFrame {
        this.relabel(this.names.map(n => match mapping.get(n) { Some(m) => m, None => n }).toList())
    }

    // withColumn adds a column, or replaces the one with that name.
    public function assign(name : String, series : Series) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        let mut replaced := false
        for (i in range(this.store.length())) {
            let c := this.store[i]
            let existing := this.names.toArray()[i]
            names.append(existing)
            if existing == name {
                out.append(series.data.copy())
                replaced = true
            } else {
                out.append(c.copy())
            }
        }
        if !replaced {
            names.append(name)
            out.append(series.data.copy())
        }
        DataFrame(names.toList(), out, this.index.copy(), this.indexName)
    }

    public function assign(name : String, values : List[Int]) : DataFrame =
        this.assign(name, Series(values))
    public function assign(name : String, values : List[double]) : DataFrame =
        this.assign(name, Series(values))
    public function assign(name : String, values : List[String]) : DataFrame =
        this.assign(name, Series(values))
    public function assign(name : String, values : List[Bool]) : DataFrame =
        this.assign(name, Series(values))

    // A scalar assign broadcasts one value to every row.
    public function assign(name : String, value : Int) : DataFrame =
        this.assign(name, Series([value for i in range(this.index.size)], name = name))
    public function assign(name : String, value : double) : DataFrame =
        this.assign(name, Series([value for i in range(this.index.size)], name = name))
    public function assign(name : String, value : String) : DataFrame =
        this.assign(name, Series([value for i in range(this.index.size)], name = name))
    public function assign(name : String, value : Bool) : DataFrame =
        this.assign(name, Series([value for i in range(this.index.size)], name = name))

    public function setIndex(name : String) : DataFrame or Error {
        let gone := this.firstMissing([name])
        if gone != "" { return MissingColumn(gone) }
        let kept := this.drop(name)
        let mut out : Array[Column] = Array.empty()
        for (c in kept.store) { out.append(c.copy()) }
        DataFrame(kept.names, out, this.store[this.position(name)].copy(), name)
    }

    public function resetIndex(drop : Bool = false) : DataFrame {
        let fresh := Column.ints(indexRange(this.index.size))
        if drop {
            let mut kept : Array[Column] = Array.empty()
            for (c in this.store) { kept.append(c.copy()) }
            return DataFrame(this.names, kept, fresh, "")
        }
        let label := if this.indexName == "" then "index" else this.indexName
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        names.append(label)
        out.append(this.index.copy())
        for (i in range(this.store.length())) {
            let c := this.store[i]
            names.append(this.names.toArray()[i])
            out.append(c.copy())
        }
        DataFrame(names.toList(), out, fresh, "")
    }

    public function astype(dtype : String) : DataFrame {
        let kind :=
            if dtype == "int64" || dtype == "int" then KIND_INT
            else if dtype == "float64" || dtype == "float" || dtype == "double" then KIND_FLOAT
            else if dtype == "bool" then KIND_BOOL else KIND_STR
        this.transformColumns(1, kind, Scalar.missing())
    }

    // selectDtypes keeps the columns whose dtype matches: "number", "int64", "float64",
    // "bool" or "str".
    public function selectDtypes(dtype : String) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (i in range(this.store.length())) {
            let c := this.store[i]
            let wanted :=
                if dtype == "number" || dtype == "numeric" then c.isNumeric()
                else if dtype == "int64" || dtype == "int" then c.kind == KIND_INT
                else if dtype == "float64" ||
                    dtype == "float" || dtype == "double" then c.kind == KIND_FLOAT
                else if dtype == "bool" then c.kind == KIND_BOOL
                else if dtype == "str" ||
                    dtype == "string" || dtype == "object" then c.kind == KIND_STR
                else false
            if wanted {
                names.append(this.names.toArray()[i])
                out.append(c.copy())
            }
        }
        DataFrame(names.toList(), out, this.index.copy(), this.indexName)
    }

    // numericTransform applies one numeric-only operation. Modes: 0 round, 1 abs, 2 clip,
    // 3 diff, 4 pctChange, 5 cumSum, 6 cumProd, 7 cumMax, 8 cumMin, 9 rank, 10 interpolate.
    function numericTransform(
        mode : Int,
        decimals : Int,
        low : double,
        high : double,
        periods : Int,
        ascending : Bool,
        method : String,
        pct : Bool,
    ) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (c in this.store) {
            if !c.isNumeric() {
                out.append(c.copy())
            } else if mode == 0 {
                out.append(roundColumn(c, decimals))
            } else if mode == 1 {
                if c.kind == KIND_INT {
                    out.append(Column.ofInts(c.ints.map(x => x.abs()).toList(), c.missing))
                } else {
                    out.append(Column.ofFloats(c.toFloats().map(x => x.abs()).toList(), c.missing))
                }
            } else if mode == 2 {
                out.append(clipColumn(c, low, high))
            } else if mode == 3 {
                out.append(diffColumn(c, periods))
            } else if mode == 4 {
                out.append(pctChangeColumn(c, periods))
            } else if mode == 5 {
                out.append(runningTotals(c, 0))
            } else if mode == 6 {
                out.append(runningTotals(c, 1))
            } else if mode == 7 {
                out.append(runningTotals(c, 2))
            } else if mode == 8 {
                out.append(runningTotals(c, 3))
            } else if mode == 9 {
                out.append(rankColumn(c, ascending, method, pct))
            } else {
                out.append(interpolateColumn(c))
            }
        }
        DataFrame(this.names, out, this.index.copy(), this.indexName)
    }

    public function round(decimals : Int = 0) : DataFrame =
        this.numericTransform(0, decimals, 0.0, 0.0, 1, true, "average", false)

    public function abs() : DataFrame =
        this.numericTransform(1, 0, 0.0, 0.0, 1, true, "average", false)

    public function clip(low : double, high : double) : DataFrame =
        this.numericTransform(2, 0, low, high, 1, true, "average", false)

    public function shift(periods : Int = 1) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (c in this.store) { out.append(shiftColumn(c, periods)) }
        DataFrame(this.names, out, this.index.copy(), this.indexName)
    }

    public function diff(periods : Int = 1) : DataFrame =
        this.numericTransform(3, 0, 0.0, 0.0, periods, true, "average", false)

    public function pctChange(periods : Int = 1) : DataFrame =
        this.numericTransform(4, 0, 0.0, 0.0, periods, true, "average", false)

    public function cumSum() : DataFrame =
        this.numericTransform(5, 0, 0.0, 0.0, 1, true, "average", false)
    public function cumProd() : DataFrame =
        this.numericTransform(6, 0, 0.0, 0.0, 1, true, "average", false)
    public function cumMax() : DataFrame =
        this.numericTransform(7, 0, 0.0, 0.0, 1, true, "average", false)
    public function cumMin() : DataFrame =
        this.numericTransform(8, 0, 0.0, 0.0, 1, true, "average", false)

    public function rank(
        ascending : Bool = true,
        method : String = "average",
        pct : Bool = false,
    ) : DataFrame = this.numericTransform(9, 0, 0.0, 0.0, 1, ascending, method, pct)

    public function interpolate() : DataFrame =
        this.numericTransform(10, 0, 0.0, 0.0, 1, true, "average", false)

    // where keeps an entry where the mask frame is true; mask does the opposite. A column
    // missing from the mask is treated as false.
    public function where(mask : DataFrame, other : Scalar) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (name in this.names) {
            let c := this.store[this.position(name)]
            let kept :=
                if mask.hasColumn(name) then presentMask(mask.keyColumn(name))
                else Column.noneMissing(this.index.size)
            out.append(whereInColumn(c, kept, other, false))
        }
        DataFrame(this.names, out, this.index.copy(), this.indexName)
    }

    public function where(mask : DataFrame) : DataFrame = this.where(mask, Scalar.missing())

    public function mask(mask : DataFrame, other : Scalar) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (name in this.names) {
            let c := this.store[this.position(name)]
            let kept :=
                if mask.hasColumn(name) then presentMask(mask.keyColumn(name))
                else Column.noneMissing(this.index.size)
            out.append(whereInColumn(c, kept, other, true))
        }
        DataFrame(this.names, out, this.index.copy(), this.indexName)
    }

    public function mask(mask : DataFrame) : DataFrame = this.mask(mask, Scalar.missing())

    function replacedColumns(old : Scalar, replacement : Scalar) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (c in this.store) { out.append(replaceInColumn(c, old, replacement)) }
        DataFrame(this.names, out, this.index.copy(), this.indexName)
    }

    public function replace(old : String, replacement : String) : DataFrame =
        this.replacedColumns(Scalar.ofString(old), Scalar.ofString(replacement))

    public function replace(old : Int, replacement : Int) : DataFrame =
        this.replacedColumns(Scalar.ofInt(old), Scalar.ofInt(replacement))

    public function replace(old : double, replacement : double) : DataFrame =
        this.replacedColumns(Scalar.ofFloat(old), Scalar.ofFloat(replacement))

    public function replace(old : Bool, replacement : Bool) : DataFrame =
        this.replacedColumns(Scalar.ofBool(old), Scalar.ofBool(replacement))

    public function replace(old : Scalar, replacement : Scalar) : DataFrame =
        this.replacedColumns(old, replacement)

    public function apply(f : double -> double) : DataFrame = this.mapNumeric(f)

    // insert adds a column at a position, shifting the later columns right.
    public function insert(position : Int, name : String, series : Series) : DataFrame or Error {
        if this.hasColumn(name) { return BadArgument("column " + name + " already exists") }
        if position < 0 || position > this.names.length() {
            return BadArgument("column position " + position.text() + " is outside the frame")
        }
        if series.length() != this.index.size {
            return BadArgument(
                "column " +
                    name +
                    " has " + series.length().text() + " rows, expected " + this.index.size.text(),
            )
        }
        let mut order : Array[String] = Array.empty()
        let existing := this.names.toArray()
        let mut i := 0
        while i <= existing.length() {
            if i == position { order.append(name) }
            if i < existing.length() { order.append(existing[i]) }
            i = i + 1
        }
        this.assign(name, series).select(order.toList())
    }

    // ---- missing values

    public function isNa() : DataFrame = this.transformColumns(2, 0, Scalar.missing())
    public function notNa() : DataFrame = this.transformColumns(3, 0, Scalar.missing())

    public function fillNa(value : double) : DataFrame =
        this.transformColumns(4, 0, Scalar.ofFloat(value))
    public function fillNa(value : Int) : DataFrame =
        this.transformColumns(4, 0, Scalar.ofInt(value))
    public function fillNa(value : String) : DataFrame =
        this.transformColumns(4, 0, Scalar.ofString(value))
    public function fillNa(value : Bool) : DataFrame =
        this.transformColumns(4, 0, Scalar.ofBool(value))

    // dropNa keeps the rows with enough present entries. how="any" removes a row with any
    // missing entry, how="all" removes only a row whose entries are all missing, and thresh
    // keeps rows with at least that many present entries.
    public function dropNa(how : String = "any", thresh : Int = 0) : DataFrame =
        this.dropMissing(this.names, how, thresh)

    public function dropNa(
        subset : List[String],
        how : String = "any",
        thresh : Int = 0,
    ) : DataFrame or Error {
        let gone := this.firstMissing(subset)
        if gone != "" { return MissingColumn(gone) }
        this.dropMissing(subset, how, thresh)
    }

    function presentInRow(row : Int, subset : List[String]) : Int {
        let mut present := 0
        for (name in subset) {
            let c := this.store[this.position(name)]
            if !c.missing.toArray()[row] { present = present + 1 }
        }
        present
    }

    function keepMissingRow(row : Int, subset : List[String], how : String, thresh : Int) : Bool {
        let present := this.presentInRow(row, subset)
        if thresh > 0 { return present >= thresh }
        if how == "all" { return present > 0 }
        present == subset.length()
    }

    function dropMissing(subset : List[String], how : String, thresh : Int) : DataFrame {
        let keep := [this.keepMissingRow(i, subset, how, thresh) for i in range(this.index.size)]
        this.take([i for (i, k) in indexRange(this.index.size).zip(keep) if k])
    }

    // ---- duplicates

    function rowKeys(subset : List[String]) : List[String] {
        let columns := [this.keyColumn(name) for name in subset]
        let mut keys : Array[String] = Array.empty()
        for (i in range(this.index.size)) {
            let mut key := ""
            for (c in columns) {
                key = key + "|" + c.keys().toArray()[i]
            }
            keys.append(key)
        }
        keys.toList()
    }

    public function duplicated(keep : String = "first") : Series =
        Series(duplicateFlags(this.rowKeys(this.names), keep)).withIndexColumn(this.index)

    public function dropDuplicates(keep : String = "first") : DataFrame =
        this.take(keepPositions(this.rowKeys(this.names), keep))

    public function dropDuplicates(subset : List[String], keep : String = "first") : DataFrame or
        Error {
            let gone := this.firstMissing(subset)
            if gone != "" { return MissingColumn(gone) }
            this.take(keepPositions(this.rowKeys(subset), keep))
        }

    // ---- reductions over columns; each gives a Series indexed by the column names

    function reduceColumns(statistic : String) : Series {
        let numbersOnly := statisticNeedsNumbers(statistic)
        let wanted :=
            [i for i in range(this.store.length()) if !numbersOnly || this.store[i].isNumeric()]
        let items := [aggregate(this.store[i], statistic) for i in wanted]
        let labels := pick(this.names, wanted)
        Series("", columnOfScalars(items), Column.strings(labels), "")
    }

    public function agg(statistic : String) : Series = this.reduceColumns(statistic)
    public function sum() : Series = this.reduceColumns("sum")
    public function prod() : Series = this.reduceColumns("prod")
    public function mean() : Series = this.reduceColumns("mean")
    public function median() : Series = this.reduceColumns("median")
    public function min() : Series = this.reduceColumns("min")
    public function max() : Series = this.reduceColumns("max")
    public function count() : Series = this.reduceColumns("count")
    public function std() : Series = this.reduceColumns("std")
    public function variance() : Series = this.reduceColumns("var")
    public function sem() : Series = this.reduceColumns("sem")
    public function skew() : Series = this.reduceColumns("skew")
    public function kurt() : Series = this.reduceColumns("kurt")
    public function any() : Series = this.reduceColumns("any")
    public function all() : Series = this.reduceColumns("all")
    public function nunique() : Series = this.reduceColumns("nunique")

    public function idxMax() : Series {
        let items := [this.seriesAt(i).idxMax() for i in range(this.store.length())]
        Series("", columnOfScalars(items), Column.strings(this.names), "")
    }

    public function idxMin() : Series {
        let items := [this.seriesAt(i).idxMin() for i in range(this.store.length())]
        Series("", columnOfScalars(items), Column.strings(this.names), "")
    }

    // mode gives one column per input column. When columns have different numbers of
    // modes, the shorter ones are padded with missing entries.
    public function mode() : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        let mut lengths : Array[Int] = Array.empty()
        let mut widest := 0
        for (i in range(this.store.length())) {
            let modes := this.seriesAt(i).mode()
            names.append(this.names.toArray()[i])
            out.append(modes.data.copy())
            lengths.append(modes.length())
            widest = max(widest, modes.length())
        }
        let mut padded : Array[Column] = Array.empty()
        let mut i := 0
        for (c in out) {
            let positions := [if k < lengths.toArray()[i] then k else -1 for k in range(widest)]
            let filled := c.copy()
            padded.append(gatherGaps(filled, positions))
            i = i + 1
        }
        DataFrame(names.toList(), padded, Column.ints(indexRange(widest)), "")
    }

    // agg(spec) applies one named statistic per column and labels each result
    // "column_statistic", as pandas does with a list of tuples.
    function specLabels(spec : List[(String, String)]) : List[String] {
        let mut names : Array[String] = Array.empty()
        for ((name, statistic) in spec) {
            if this.hasColumn(name) {
                let c := this.store[this.position(name)]
                if !statisticNeedsNumbers(statistic) || c.isNumeric() {
                    names.append(name + "_" + statistic)
                }
            }
        }
        names.toList()
    }

    function specValues(spec : List[(String, String)]) : List[Scalar] {
        [
            aggregate(this.store[this.position(name)], statistic) for (name, statistic) in spec if this.hasColumn(
                name,
            ) &&
                (!statisticNeedsNumbers(statistic) || this.store[this.position(name)].isNumeric())
        ]
    }

    public function agg(spec : List[(String, String)]) : Series =
        Series(
            "",
            columnOfScalars(this.specValues(spec)),
            Column.strings(this.specLabels(spec)),
            "",
        )

    public function quantile(q : double) : Series {
        let wanted := this.numericNames()
        let values :=
            [
                Scalar.ofFloat(quantileOf(validFloats(this.store[this.position(name)]), q)) for name in wanted
            ]
        Series(q.text(), columnOfScalars(values), Column.strings(wanted), "")
    }

    function quantileColumn(name : String, qs : List[double]) : Column {
        let c := this.store[this.position(name)]
        Column.floats(qs.map(q => quantileOf(validFloats(c), q)).toList())
    }

    public function quantile(qs : List[double]) : DataFrame {
        let wanted := this.numericNames()
        let mut out : Array[Column] = Array.empty()
        for (name in wanted) { out.append(this.quantileColumn(name, qs)) }
        DataFrame(wanted, out, Column.floats(qs), "")
    }

    public function describe() : DataFrame {
        let numeric := this.numericNames()
        let wanted := if numeric.length() > 0 then numeric else this.names
        let mut out : Array[Column] = Array.empty()
        let mut labels := Column.strings([])
        for (name in wanted) {
            let summary := this.seriesAt(this.position(name)).describe()
            out.append(summary.data.copy())
            labels = summary.index.copy()
        }
        DataFrame(wanted, out, labels, "")
    }

    // corr gives the Pearson correlation of every pair of numeric columns.
    public function corr() : DataFrame {
        let wanted := this.numericNames()
        let mut out : Array[Column] = Array.empty()
        for (a in wanted) {
            let mut values : Array[double] = Array.empty()
            for (b in wanted) {
                values.append(
                    correlationColumns(this.store[this.position(a)], this.store[this.position(b)]),
                )
            }
            out.append(Column.floats(values.toList()))
        }
        DataFrame(wanted, out, Column.strings(wanted), "")
    }

    public function cov(ddof : Int = 1) : DataFrame {
        let wanted := this.numericNames()
        let mut out : Array[Column] = Array.empty()
        for (a in wanted) {
            let mut values : Array[double] = Array.empty()
            for (b in wanted) {
                values.append(
                    covarianceColumns(
                        this.store[this.position(a)],
                        this.store[this.position(b)],
                        ddof,
                    ),
                )
            }
            out.append(Column.floats(values.toList()))
        }
        DataFrame(wanted, out, Column.strings(wanted), "")
    }

    // corrwith correlates each numeric column with the same-named column in another frame.
    public function corrwith(other : DataFrame) : Series {
        let wanted :=
            [
                name for name in this.numericNames() if other.hasColumn(name) &&
                    other.keyColumn(name).isNumeric()
            ]
        let values :=
            [
                correlationColumns(this.store[this.position(name)], other.keyColumn(name)) for name in wanted
            ]
        Series("", Column.floats(values), Column.strings(wanted), "")
    }

    // valueCounts counts the distinct values of one column.
    public function valueCounts(column : String, normalize : Bool = false) : Series or Error {
        let gone := this.firstMissing([column])
        if gone != "" { return MissingColumn(gone) }
        this.seriesAt(this.position(column)).valueCounts(normalize = normalize)
    }

    // valueCounts over several columns gives one row per distinct combination, in
    // descending count order.
    public function valueCounts(
        subset : List[String] = [],
        normalize : Bool = false,
    ) : DataFrame or Error {
        let wanted := if subset.length() == 0 then this.names else subset
        let gone := this.firstMissing(wanted)
        if gone != "" { return MissingColumn(gone) }
        let runs := groupRuns(this.rowKeys(wanted))
        let counts := runs.map(group => group.length()).toList()
        let firsts := runs.map(group => firstOf(group)).toList()
        let order := indexRange(counts.length()).sorted(key = i => -counts.toArray()[i])
        let chosen := [firsts.toArray()[i] for i in order]
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in wanted) {
            names.append(name)
            out.append(this.keyColumn(name).gather(chosen))
        }
        names.append(if normalize then "proportion" else "count")
        out.append(
            if normalize then Column.floats(
                pick(counts, order).map(c => c.toDouble() / this.index.size.toDouble()).toList(),
            )
                else Column.ints(pick(counts, order)),
        )
        DataFrame(names.toList(), out, Column.ints(indexRange(order.length())), "")
    }

    // ---- grouping and combining

    public function groupBy(key : String) : GroupBy or Error {
        let gone := this.firstMissing([key])
        if gone != "" { return MissingColumn(gone) }
        GroupBy(this.copy(), [key])
    }

    public function groupBy(keys : List[String]) : GroupBy or Error {
        let gone := this.firstMissing(keys)
        if gone != "" { return MissingColumn(gone) }
        GroupBy(this.copy(), keys)
    }

    public function merge(
        other : DataFrame,
        on : String,
        how : String = "inner",
        leftSuffix : String = "_x",
        rightSuffix : String = "_y",
    ) : DataFrame or Error {
        let gone := this.firstMissing([on])
        let goneRight := other.firstMissing([on])
        if gone != "" { return MissingColumn(gone) }
        if goneRight != "" { return MissingColumn(goneRight) }
        mergeFrames(this, other, [on], [on], how, leftSuffix, rightSuffix)
    }

    public function merge(
        other : DataFrame,
        on : List[String],
        how : String = "inner",
        leftSuffix : String = "_x",
        rightSuffix : String = "_y",
    ) : DataFrame or Error {
        let gone := this.firstMissing(on)
        let goneRight := other.firstMissing(on)
        if gone != "" { return MissingColumn(gone) }
        if goneRight != "" { return MissingColumn(goneRight) }
        mergeFrames(this, other, on, on, how, leftSuffix, rightSuffix)
    }

    public function merge(
        other : DataFrame,
        leftOn : String,
        rightOn : String,
        how : String = "inner",
        leftSuffix : String = "_x",
        rightSuffix : String = "_y",
    ) : DataFrame or Error {
        let gone := this.firstMissing([leftOn])
        let goneRight := other.firstMissing([rightOn])
        if gone != "" { return MissingColumn(gone) }
        if goneRight != "" { return MissingColumn(goneRight) }
        mergeFrames(this, other, [leftOn], [rightOn], how, leftSuffix, rightSuffix)
    }

    // concat stacks frames one below the other. Columns are matched by name.
    public static function concat(frames : List[DataFrame]) : DataFrame {
        let mut names : Array[String] = Array.empty()
        for (frame in frames) {
            for (name in frame.names) {
                if !names.toList().contains(name) { names.append(name) }
            }
        }
        let mut out : Array[Column] = Array.empty()
        let mut index := Column.ints([])
        let mut first := true
        for (frame in frames) {
            index = if first then frame.index.copy() else joinMixed(index, frame.index)
            first = false
        }
        for (name in names.toList()) {
            let mut stacked := Column.ints([])
            let mut started := false
            for (frame in frames) {
                let piece :=
                    if frame.hasColumn(name) then frame.store[frame.position(name)].copy()
                    else Column.empty(KIND_FLOAT, frame.length())
                stacked = if started then joinMixed(stacked, piece) else piece
                started = true
            }
            out.append(stacked)
        }
        DataFrame(names.toList(), out, index, "")
    }

    public function append(other : DataFrame) : DataFrame =
        DataFrame.concat([this.copy(), other.copy()])

    // concatColumns places frames side by side. This library is positional, so every frame
    // must have the same row count and the column names must be distinct.
    public static function concatColumns(frames : List[DataFrame]) : DataFrame or Error {
        if frames.length() == 0 { return DataFrame.empty() }
        let rows := match frames.first() { Some(f) => f.length(), None => 0 }
        let labels := match frames.first() { Some(f) => f.index.copy(), None => Column.ints([]) }
        let labelName := match frames.first() { Some(f) => f.indexName, None => "" }
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (frame in frames) {
            if frame.length() != rows { return BadArgument("concatColumns needs equal row counts") }
            for (name in frame.names) {
                if names.toList().contains(name) {
                    return BadArgument("column " + name + " appears twice")
                }
                names.append(name)
                out.append(frame.keyColumn(name))
            }
        }
        DataFrame(names.toList(), out, labels, labelName)
    }

    // pivotTable lays one column's values across the top, aggregating a third column.
    public function pivotTable(
        index : String,
        columns : String,
        values : String,
        aggfunc : String = "mean",
    ) : DataFrame or Error {
        let gone := this.firstMissing([index, columns, values])
        if gone != "" { return MissingColumn(gone) }
        let rowKeys := this.seriesAt(this.position(index))
        let columnKeys := this.seriesAt(this.position(columns))
        let (rowCodes, rowDistinct, rowWidth) := distinctFirsts(rowKeys.data)
        let (columnCodes, columnDistinct, columnWidth) := distinctFirsts(columnKeys.data)
        let rowGroups := orderBy(rowKeys.data, rowDistinct, true)
        let columnGroups := orderBy(columnKeys.data, columnDistinct, true)
        let rowLabels := rowKeys.data.gather(rowGroups)
        let columnLabels := columnKeys.data.gather(columnGroups).texts()
        let source := this.store[this.position(values)].copy()
        if aggfunc == "count" || ((aggfunc == "sum" || aggfunc == "mean") && source.isNumeric()) {
            let out :=
                pivotFastColumns(
                    source,
                    rowCodes,
                    columnCodes,
                    rowWidth,
                    columnWidth,
                    rowGroups,
                    columnGroups,
                    aggfunc,
                )
            let mut pivoted := DataFrame(columnLabels, out, rowLabels, index)
            pivoted.columnsLabel = columns
            return pivoted
        }
        let rowOf :=
            if rowKeys.data.kind == KIND_STR then rowKeys.data.strs.toList()
            else rowKeys.data.keys()
        let columnOf :=
            if columnKeys.data.kind == KIND_STR then columnKeys.data.strs.toList()
            else columnKeys.data.keys()
        let mut out : Array[Column] = Array.empty()
        for ((cl, cp) in columnLabels.zip(columnGroups)) {
            let items := [pivotCell(source, rowOf, columnOf, rp, cp, aggfunc) for rp in rowGroups]
            out.append(columnOfScalars(items))
        }
        let mut pivoted := DataFrame(columnLabels, out, rowLabels, index)
        pivoted.columnsLabel = columns
        pivoted
    }

    // melt turns wide columns into rows: one row per (original row, value column).
    public function melt(
        idVars : List[String] = [],
        valueVars : List[String] = [],
        varName : String = "variable",
        valueName : String = "value",
    ) : DataFrame or Error {
        let gone := this.firstMissing(joinLists(idVars, valueVars))
        if gone != "" { return MissingColumn(gone) }
        let values :=
            if valueVars.length() == 0 then [name for name in this.names if !idVars.contains(name)]
            else valueVars
        let rows := this.index.size * values.length()
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in idVars) {
            names.append(name)
            out.append(this.keyColumn(name).tile(values.length()))
        }
        names.append(varName)
        out.append(__columnRepeatNames(values, this.index.size))
        let mut valueColumn := Column.empty(KIND_FLOAT, 0)
        let mut started := false
        for (name in values) {
            let piece := this.store[this.position(name)].copy()
            valueColumn =
                if started then if valueColumn.kind == piece.kind then valueColumn.concat(piece)
                else joinMixed(valueColumn, piece) else piece
            started = true
        }
        names.append(valueName)
        out.append(valueColumn)
        DataFrame(names.toList(), out, Column.ids(rows), "")
    }

    // pivot spreads one column's distinct values across the top. Unlike pivotTable, it
    // refuses duplicate (index, column) pairs instead of aggregating them.
    public function pivot(index : String, columns : String, values : String) : DataFrame or Error {
        let gone := this.firstMissing([index, columns, values])
        if gone != "" { return MissingColumn(gone) }
        let pairs := this.rowKeys([index, columns])
        if firstOccurrences(pairs).length() != pairs.length() {
            return BadArgument(
                "pivot needs unique (" +
                    index + ", " + columns + ") pairs; use pivotTable to aggregate duplicates",
            )
        }
        this.pivotTable(index, columns, values, "first")
    }

    // crosstab counts the rows for every (index, columns) pair.
    public function crosstab(index : String, columns : String) : DataFrame or Error {
        let gone := this.firstMissing([index, columns])
        if gone != "" { return MissingColumn(gone) }
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        names.append(index)
        out.append(this.keyColumn(index))
        names.append(columns)
        out.append(this.keyColumn(columns))
        names.append("__kesdas_count")
        out.append(Column.ints([1 for i in range(this.index.size)]))
        let counted := DataFrame(names.toList(), out, this.index.copy(), this.indexName)
        let table := counted.pivotTable(index, columns, "__kesdas_count", "sum")?
        let filled := table.fillNa(0).astype("int64")
        filled.columnsLabel = table.columnsLabel
        filled
    }

    // getDummies replaces the selected text and Bool columns with one Bool column per
    // observed value. An empty selection uses every text and Bool column.
    public function getDummies(
        columns : List[String] = [],
        prefix : String = "",
        dropFirst : Bool = false,
        dummyNa : Bool = false,
    ) : DataFrame or Error {
        let gone := this.firstMissing(columns)
        if gone != "" { return MissingColumn(gone) }
        let chosen :=
            if columns.length() ==
                0 then [
                    name for name in this.names if this.store[this.position(name)].kind ==
                            KIND_STR ||
                        this.store[this.position(name)].kind == KIND_BOOL
                ]
            else columns
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in this.names) {
            if !chosen.contains(name) {
                names.append(name)
                out.append(this.store[this.position(name)].copy())
            }
        }
        for (name in chosen) {
            let c := this.store[this.position(name)]
            let texts := c.texts()
            let present := [t for (t, m) in texts.zip(c.missing) if !m]
            let labels := sortedDistinct(present)
            let base := if prefix == "" then name else prefix
            let mut start := 0
            if dropFirst && labels.length() > 0 { start = 1 }
            for ((labelIndex, label) in labels.enumerate()) {
                if labelIndex >= start {
                    names.append(base + "_" + label)
                    out.append(Column.bools([t == label && !m for (t, m) in texts.zip(c.missing)]))
                }
            }
            if dummyNa && c.missing.any(m => m) {
                names.append(base + "_nan")
                out.append(Column.bools(c.missing))
            }
        }
        DataFrame(names.toList(), out, this.index.copy(), this.indexName)
    }

    // transpose swaps rows and columns. All columns must share one kind, so the values
    // keep their type; a mixed frame returns BadArgument instead of silently becoming text.
    public function transpose() : DataFrame or Error {
        if this.store.length() == 0 { return DataFrame.empty() }
        let kind := this.store[0].kind
        let mut numeric := true
        for (c in this.store) {
            if !c.isNumeric() { numeric = false }
        }
        if !numeric {
            for (c in this.store) {
                if c.kind != kind { return BadArgument("transpose needs columns of one kind") }
            }
        }
        let mut out : Array[Column] = Array.empty()
        for (r in range(this.index.size)) {
            let items := [scalarAt(this.store[c], r) for c in range(this.store.length())]
            out.append(columnOfScalars(items))
        }
        DataFrame(
            this.index.texts(),
            out,
            Column.strings(this.names),
            if this.columnsLabel == "" then "" else this.columnsLabel,
        )
    }

    // ---- conversion

    public function toTensor() : DynTensor[double] {
        let mut flat : Array[double] = Array.empty()
        let wanted := this.numericNames()
        for (i in range(this.index.size)) {
            for (name in wanted) {
                flat.append(this.store[this.position(name)].toFloats().toArray()[i])
            }
        }
        Tensor(flat.toList(), shape = (this.index.size, wanted.length()))
    }

    public function toCsv(
        separator : String = ",",
        header : Bool = true,
        includeIndex : Bool = false,
    ) : String {
        let mut lines : Array[String] = Array.empty()
        let cells := this.csvCells(separator)
        if header {
            let labels :=
                if includeIndex then joinLists(
                    [csvField(this.indexName, separator)],
                    this.names.map(n => csvField(n, separator)).toList(),
                )
                else this.names.map(n => csvField(n, separator)).toList()
            lines.append(labels.join(separator))
        }
        let indexTexts := this.index.texts()
        for (r in range(this.index.size)) {
            let fields := cells.map(column => column.toArray()[r]).toList()
            let withIndex :=
                if includeIndex then joinLists(
                    [csvField(indexTexts.toArray()[r], separator)],
                    fields,
                )
                else fields
            lines.append(withIndex.join(separator))
        }
        lines.toList().join("\n") + "\n"
    }

    function csvCells(separator : String) : List[List[String]] {
        let mut out : Array[List[String]] = Array.empty()
        for (c in this.store) {
            let exact :=
                if c.kind == KIND_FLOAT then c.floats.map(x => x.text()).toList() else c.texts()
            out.append(
                [if m then "" else csvField(t, separator) for (t, m) in exact.zip(c.missing)],
            )
        }
        out.toList()
    }

    public static function parseCsv(
        text : String,
        separator : String = ",",
        header : Bool = true,
        skipRows : Int = 0,
        nRows : Int = -1,
    ) : DataFrame {
        let rows := dropCsvRows(parseCsvRows(text, separator), skipRows)
        match rows.first() {
            None => DataFrame.empty(),
            Some(firstRow) => {
                let names :=
                    if header then firstRow.map(n => n.trim()).toList()
                    else [i.text() for i in range(firstRow.length())]
                let rawBody := if header then dropCsvRows(rows, 1) else rows
                let body := if nRows >= 0 then takeCsvRows(rawBody, nRows) else rawBody
                let mut out : Array[Column] = Array.empty()
                for (k in range(names.length())) {
                    out.append(columnFromTexts(body.map(row => nthField(row, k)).toList()))
                }
                DataFrame(names, out, Column.ints(indexRange(body.length())), "")
            },
        }
    }

    public static function parseCsvLines(
        lines : List[String],
        separator : String = ",",
        header : Bool = true,
        skipRows : Int = 0,
        nRows : Int = -1,
    ) : DataFrame {
        let (flat, width, rowCount) := parseCsvFlat(lines, separator)
        let first := skipRows
        if first >= rowCount || width == 0 { return DataFrame.empty() }
        let names :=
            if header then [flat[first * width + k].trim() for k in range(width)]
            else [i.text() for i in range(width)]
        let bodyStart := if header then first + 1 else first
        let bodyEnd := if nRows >= 0 then min(rowCount, bodyStart + nRows) else rowCount
        let n := max(0, bodyEnd - bodyStart)
        let mut out : Array[Column] = Array.empty()
        for (k in range(width)) {
            let texts := [flat[(bodyStart + r) * width + k] for r in range(n)]
            out.append(columnFromTexts(texts))
        }
        DataFrame(names, out, Column.ints(indexRange(n)), "")
    }

    // ---- display

    function columnTexts() : List[List[String]] {
        let mut out : Array[List[String]] = Array.empty()
        for (c in this.store) { out.append(c.texts()) }
        out.toList()
    }

    public function text() : String {
        if this.names.length() == 0 || this.index.size == 0 {
            return "Empty DataFrame\nColumns: [" +
                this.names.join(", ") + "]\nIndex: [" + this.index.texts().join(", ") + "]"
        }
        let collapse := [c.kind == KIND_STR || c.texts().all(v => v == "NaN") for c in this.store]
        let lines :=
            tableLines(
                this.names,
                this.index.texts(),
                this.columnTexts(),
                this.indexName,
                this.columnsLabel,
                collapse,
            )
        let body := lines.join("\n")
        if this.index.size > MAX_ROWS {
            body +
                "\n\n[" +
                this.index.size.text() + " rows x " + this.names.length().text() + " columns]"
        } else {
            body
        }
    }

    public function html() : String {
        if this.names.length() == 0 || this.index.size == 0 {
            return "<div><p>Empty DataFrame</p><p>Columns: [" +
                htmlEscape(this.names.join(", ")) + "]</p></div>"
        }
        let table := tableHtml(this.names, this.index.texts(), this.columnTexts(), this.indexName)
        if this.index.size > MAX_ROWS {
            table +
                "<p>" +
                this.index.size.text() + " rows × " + this.names.length().text() + " columns</p>"
        } else {
            table
        }
    }

    // cell reads one entry by row position and column name.
    public function cell(row : Int, column : String) : Scalar or Error {
        let gone := this.firstMissing([column])
        if gone != "" { return MissingColumn(gone) }
        if row < 0 || row >= this.index.size {
            return BadArgument(
                "row " + row.text() + " is outside 0 to " + (this.index.size - 1).text(),
            )
        }
        scalarAt(this.store[this.position(column)], row)
    }

    // mapNumeric applies a function to every number column and keeps the others.
    public function mapNumeric(f : double -> double) : DataFrame {
        let mut out : Array[Column] = Array.empty()
        for (c in this.store) {
            if c.isNumeric() {
                out.append(Column.ofFloats(c.toFloats().map(f).toList(), c.missing))
            } else {
                out.append(c.copy())
            }
        }
        DataFrame(this.names, out, this.index.copy(), this.indexName)
    }

    public function rolling(window : Int, minPeriods : Int = -1) : FrameRolling =
        FrameRolling(this.copy(), window, if minPeriods < 0 then window else minPeriods)

    public function expanding(minPeriods : Int = 1) : FrameExpanding =
        FrameExpanding(this.copy(), minPeriods)

    public function ewm(alpha : double, adjust : Bool = true, minPeriods : Int = 0) : FrameEWM =
        FrameEWM(this.copy(), alpha, adjust, minPeriods)

    // saveCsv writes the frame to a file.
    public function saveCsv(
        path : String,
        separator : String = ",",
        includeIndex : Bool = false,
    ) : void or Error with Effects {
        using w := create(path)?{
            w.writeLine(this.toCsv(separator = separator, includeIndex = includeIndex).trim())?
        }
    }

    public function info() : void with Effects {
        let n := this.index.size
        let counts :=
            [countValid(this.store[i]).text() + " non-null" for i in range(this.store.length())]
        let kinds := [this.store[i].dtype() for i in range(this.store.length())]
        let nameWidth := max(6, widest(this.names))
        let countWidth := max(14, widest(counts))
        let last := if n == 0 then "" else " to " + this.index.texts().toArray()[n - 1]
        print("<class 'kesdas.DataFrame'>")
        print(
            "RangeIndex: " +
                n.text() +
                " entries, " + (if n == 0 then "" else this.index.texts().toArray()[0]) + last,
        )
        print("Data columns (total " + this.names.length().text() + " columns):")
        print(
            " #   " +
                padRight("Column", nameWidth) +
                "  " + padRight("Non-Null Count", countWidth) + "  Dtype",
        )
        print(
            "---  " +
                padRight("------", nameWidth) +
                "  " + padRight("--------------", countWidth) + "  -----",
        )
        for (i in range(this.names.length())) {
            print(
                " " +
                    padRight(i.text(), 3) +
                    " " +
                    padRight(this.names.toArray()[i], nameWidth) +
                    "  " + padRight(counts.toArray()[i], countWidth) + "  " + kinds.toArray()[i],
            )
        }
        let groups := sortedDistinct(kinds)
        let summary :=
            [
                label +
                    "(" + [k for k in kinds if k == label].length().text() + ")" for label in groups
            ]
        print("dtypes: " + summary.join(", "))
    }
}

// pivotFastColumns fills the pivot matrix in one pass. It handles the common
// sum, mean and count statistics; the general path below keeps the rest.
function pivotFastColumns(
    source : Column,
    rowCodes : List[Int],
    columnCodes : List[Int],
    rowWidth : Int,
    columnWidth : Int,
    rowGroups : List[Int],
    columnGroups : List[Int],
    statistic : String,
) : Array[Column] {
    let rows := rowGroups.length()
    let columns := columnGroups.length()
    let sums := Array(rows * columns, 0.0)
    let counts := Array(rows * columns, 0)
    let rowCode := rowCodes.toArray()
    let columnCode := columnCodes.toArray()
    let rowAt := Array(rowWidth, -1)
    for ((g, p) in rowGroups.enumerate()) { rowAt[rowCode[p]] = g }
    let columnAt := Array(columnWidth, -1)
    for ((g, p) in columnGroups.enumerate()) { columnAt[columnCode[p]] = g }
    let gone := source.missing.toArray()
    if statistic == "count" {
        // count works for every column kind; it never reads the value arrays.
        for (i in range(min(rowCode.length(), columnCode.length()))) {
            if !gone[i] {
                let r := rowAt[rowCode[i]]
                let c := columnAt[columnCode[i]]
                if r >= 0 && c >= 0 {
                    let at := r * columns + c
                    counts[at] = counts[at] + 1
                }
            }
        }
    } else if source.kind == KIND_INT {
        let xs := source.ints.toArray()
        for (i in range(min(rowCode.length(), columnCode.length()))) {
            if !gone[i] {
                let r := rowAt[rowCode[i]]
                let c := columnAt[columnCode[i]]
                if r >= 0 && c >= 0 {
                    let at := r * columns + c
                    counts[at] = counts[at] + 1
                    sums[at] = sums[at] + xs[i].toDouble()
                }
            }
        }
    } else {
        let xs := source.floats.toArray()
        for (i in range(min(rowCode.length(), columnCode.length()))) {
            if !gone[i] {
                let r := rowAt[rowCode[i]]
                let c := columnAt[columnCode[i]]
                if r >= 0 && c >= 0 {
                    let at := r * columns + c
                    counts[at] = counts[at] + 1
                    sums[at] = sums[at] + xs[i]
                }
            }
        }
    }
    let mut out : Array[Column] = Array.empty()
    for (c in range(columns)) {
        let items :=
            [
                if counts[r * columns + c] == 0 then Scalar.missing()
                    else if statistic == "count" then Scalar.ofInt(counts[r * columns + c])
                    else if statistic ==
                        "mean" then Scalar.ofFloat(
                            sums[r * columns + c] / counts[r * columns + c].toDouble(),
                        )
                    else if source.kind ==
                        KIND_INT then Scalar.ofInt(wholeInt(sums[r * columns + c]))
                    else Scalar.ofFloat(sums[r * columns + c]) for r in range(rows)
            ]
        out.append(columnOfScalars(items))
    }
    out
}

function pivotCell(
    source : Column,
    rowOf : List[String],
    columnOf : List[String],
    rp : Int,
    cp : Int,
    aggfunc : String,
) : Scalar {
    let rows := rowOf.toArray()
    let cols := columnOf.toArray()
    let cells := [i for i in range(rows.length()) if rows[i] == rows[rp] && cols[i] == cols[cp]]
    if cells.length() == 0 { Scalar.missing() } else { aggregate(source.gather(cells), aggfunc) }
}

// readCsv reads a CSV file into a frame: the first line names the columns, and each column
// takes the narrowest kind that fits its entries.
function readCsvSlow(
    path : String,
    separator : String,
    header : Bool,
    skipRows : Int,
    nRows : Int,
) : DataFrame or Error with Effects {
    let mut lines : Array[String] = Array.empty()
    using f := open(path)?{
        let mut reading := true
        while reading {
            match f.readLine() {
                line => { lines.append(line) },
                _ => { reading = false },
            }
        }
    }?
    DataFrame.parseCsvLines(lines.toList(), separator, header, skipRows, nRows)
}

function readCsvNative(
    path : String,
    separator : String,
    header : Bool,
    skipRows : Int,
    nRows : Int,
) : (List[String], List[Column], String) with Effects =
    __kesdasReadCsv(path, separator, header, skipRows, nRows)

// readCsv takes the native columnar path for ordinary unquoted CSV. Quoted
// records fall back to the general line parser so RFC 4180 quoting stays exact.
public function readCsv(
    path : String,
    separator : String = ",",
    header : Bool = true,
    skipRows : Int = 0,
    nRows : Int = -1,
) : DataFrame or Error with Effects {
    let (names, columns, problem) := readCsvNative(path, separator, header, skipRows, nRows)
    let mut frame := DataFrame.empty()
    if problem == "__KESDAS_CSV_FALLBACK__" {
        frame = readCsvSlow(path, separator, header, skipRows, nRows)?
    } else if problem.length() > 0 {
        return RuntimeError.Message(problem)
    } else if columns.length() == 0 {
        frame = DataFrame.empty()
    } else {
        let first := match columns.first() {
            Some(column) => column,
            None => return DataFrame.empty(),
        }
        let n := first.size
        let mut store : Array[Column] = Array.empty()
        for (column in columns) { store.append(column.copy()) }
        frame = DataFrame(names, store, Column.ints(indexRange(n)), "")
    }
    frame
}

function sortedDistinct(items : List[String]) : List[String] {
    let set : MutSet[String] = MutSet()
    let mut out : Array[String] = Array.empty()
    for (item in items) {
        if !set.contains(item) {
            // MutSet.add takes the String from the loop variable, so append it first.
            out.append(item)
            let own := item
            set.add(own)
        }
    }
    out.toList().sorted()
}

function nthField(row : List[String], k : Int) : String {
    let items := row.toArray()
    if k < items.length() { items[k] } else { "" }
}

function reversedStrings(xs : List[String]) : List[String] =
    pick(xs, reversedPositions(xs.length()))

function rowRepresentatives(series : Series) : List[Int] = {
    let column := series.data
    // Text representatives need no prefixed key strings.
    let keys := if column.kind == KIND_STR then column.strs.toList() else column.keys()
    orderBy(column, firstOccurrences(keys), true)
}

function correlation(a : Series, b : Series) : double = __columnCorrelation(a.data, b.data)

function joinAll(groups : List[List[Int]]) : List[Int] {
    let mut out : Array[Int] = Array.empty()
    for (group in groups) {
        for (i in group) { out.append(i) }
    }
    out.toList()
}

function sortedPositions(positions : List[Int]) : List[Int] = positions.sorted()

// ---------------------------------------------------------------- frame rolling windows

// FrameRolling applies a rolling statistic to every numeric column.
public class FrameRolling {
    public var frame : DataFrame
    public final window : Int
    public final minPeriods : Int

    new(move frame : DataFrame, window : Int, minPeriods : Int) {
        this.frame = frame
        this.window = window
        this.minPeriods = minPeriods
    }

    function result(statistic : Int) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in this.frame.names) {
            let c := this.frame.keyColumn(name)
            if c.isNumeric() {
                names.append(name)
                out.append(
                    if statistic == 0 then rollingMean(c, this.window, this.minPeriods)
                        else if statistic == 1 then rollingSum(c, this.window, this.minPeriods)
                        else if statistic == 5 then rollingCount(c, this.window, this.minPeriods)
                        else windowed(c, this.window, this.minPeriods, statistic),
                )
            }
        }
        DataFrame(names.toList(), out, this.frame.index.copy(), this.frame.indexName)
    }

    public function mean() : DataFrame = this.result(0)
    public function sum() : DataFrame = this.result(1)
    public function min() : DataFrame = this.result(2)
    public function max() : DataFrame = this.result(3)
    public function std() : DataFrame = this.result(4)
    public function count() : DataFrame = this.result(5)
    public function median() : DataFrame = this.result(6)
    public function variance() : DataFrame = this.result(7)
    public function sem() : DataFrame = this.result(8)
    public function skew() : DataFrame = this.result(9)
    public function kurt() : DataFrame = this.result(10)

    public function quantile(q : double) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in this.frame.names) {
            let c := this.frame.keyColumn(name)
            if c.isNumeric() {
                names.append(name)
                out.append(windowedQuantile(c, this.window, this.minPeriods, q))
            }
        }
        DataFrame(names.toList(), out, this.frame.index.copy(), this.frame.indexName)
    }
}

// ---------------------------------------------------------------- frame expanding and EWM

public class FrameExpanding {
    public var frame : DataFrame
    public final minPeriods : Int

    new(move frame : DataFrame, minPeriods : Int) {
        this.frame = frame
        this.minPeriods = minPeriods
    }

    function result(statistic : Int) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in this.frame.names) {
            let c := this.frame.keyColumn(name)
            if c.isNumeric() {
                names.append(name)
                out.append(windowed(c, max(1, c.size), this.minPeriods, statistic))
            }
        }
        DataFrame(names.toList(), out, this.frame.index.copy(), this.frame.indexName)
    }

    public function mean() : DataFrame = this.result(0)
    public function sum() : DataFrame = this.result(1)
    public function min() : DataFrame = this.result(2)
    public function max() : DataFrame = this.result(3)
    public function std() : DataFrame = this.result(4)
    public function count() : DataFrame = this.result(5)
    public function median() : DataFrame = this.result(6)
    public function variance() : DataFrame = this.result(7)
    public function sem() : DataFrame = this.result(8)
    public function quantile(q : double) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in this.frame.names) {
            let c := this.frame.keyColumn(name)
            if c.isNumeric() {
                names.append(name)
                out.append(windowedQuantile(c, max(1, c.size), this.minPeriods, q))
            }
        }
        DataFrame(names.toList(), out, this.frame.index.copy(), this.frame.indexName)
    }
}

public class FrameEWM {
    public var frame : DataFrame
    public final alpha : double
    public final adjust : Bool
    public final minPeriods : Int

    new(move frame : DataFrame, alpha : double, adjust : Bool, minPeriods : Int) {
        this.frame = frame
        this.alpha = alpha
        this.adjust = adjust
        this.minPeriods = minPeriods
    }

    function result(statistic : Int, bias : Bool) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in this.frame.names) {
            let c := this.frame.keyColumn(name)
            if c.isNumeric() {
                names.append(name)
                out.append(ewmColumn(c, this.alpha, this.adjust, this.minPeriods, statistic, bias))
            }
        }
        DataFrame(names.toList(), out, this.frame.index.copy(), this.frame.indexName)
    }

    public function mean() : DataFrame = this.result(0, true)
    public function sum() : DataFrame = this.result(1, true)
    public function variance(bias : Bool = false) : DataFrame = this.result(2, bias)
    public function std(bias : Bool = false) : DataFrame = this.result(3, bias)
    public function count() : DataFrame = this.result(4, true)
}

// ---------------------------------------------------------------- merge

public class GroupBy {
    public var frame : DataFrame
    public final keys : List[String]
    private final groups : List[List[Int]]
    private final codes : List[Int]
    private final codeRank : List[Int]
    private final hasCodes : Bool

    new(move frame : DataFrame, keys : List[String]) {
        this.keys = keys
        let mut singleCodes : List[Int] = []
        let mut singleRank : List[Int] = []
        let mut hasSingleCodes := false
        let mut singleWidth := 0
        let runs := if keys.length() == 1 {
            let only := match keys.first() { Some(name) => name, None => "" }
            let (found, foundWidth) := frame.keyCodes(only)
            singleCodes = found
            singleWidth = foundWidth
            hasSingleCodes = true
            groupRunsCodesWidth(found, foundWidth)
        } else {
            let mut codes : List[Int] = []
            let mut first := true
            for (name in keys) {
                let (raw, width) := frame.keyCodes(name)
                if first {
                    codes = raw
                    first = false
                } else {
                    let previous := codes.toArray()
                    codes = [p * width + c for (p, c) in previous.zip(raw)]
                }
            }
            groupRunsCodes(codes)
        }
        // Groups come out ordered by key value, as pandas sorts them by default.
        let firsts := runs.map(group => firstOf(group)).toList()
        let mut order := indexRange(firsts.length())
        let representatives := firsts.toArray()
        for (name in reversedStrings(keys)) {
            let column := frame.keyColumn(name)
            let ordered := orderBy(column.gather(firsts), order, true)
            order = ordered
        }
        let table := runs.toArray()
        this.groups = [table[i] for i in order]
        if hasSingleCodes {
            let at := singleCodes.toArray()
            let fs := firsts.toArray()
            let ord := order.toArray()
            let mut rank := Array(singleWidth, 0)
            for (g in range(ord.length())) { rank[at[fs[ord[g]]]] = g }
            singleRank = rank.toList()
        }
        this.codes = singleCodes
        this.codeRank = singleRank
        this.hasCodes = hasSingleCodes
        this.frame = frame
    }

    public function count() : Int = this.groups.length()

    public function aggregate(statistic : String) : DataFrame {
        let wanted := this.valueNames()
        if statistic == "sum" || statistic == "mean" || statistic == "count" {
            let mut names : Array[String] = Array.empty()
            let mut out : Array[Column] = Array.empty()
            for (name in wanted) {
                let column := this.frame.keyColumn(name)
                if !statisticNeedsNumbers(statistic) || column.isNumeric() {
                    names.append(name)
                    if this.hasCodes &&
                            statistic !=
                                "count" then out.append(
                                    __columnGroupStat(
                                        column,
                                        this.codes,
                                        this.codeRank,
                                        this.groups.length(),
                                        if statistic == "sum" then 0 else 1,
                                    ),
                                )
                        else if this.hasCodes then out.append(
                            __columnGroupStat(
                                column,
                                this.codes,
                                this.codeRank,
                                this.groups.length(),
                                2,
                            ),
                        )
                        else out.append(
                            aggregateGroups(
                                column,
                                this.ownerArray(),
                                this.groups.length(),
                                statistic,
                            ),
                        )
                }
            }
            return this.assemble(names.toList(), out)
        }
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in wanted) {
            let column := this.frame.keyColumn(name)
            if !statisticNeedsNumbers(statistic) || column.isNumeric() {
                names.append(name)
                out.append(
                    columnOfScalars(
                        [aggregate(column.gather(group), statistic) for group in this.groups],
                    ),
                )
            }
        }
        this.assemble(names.toList(), out)
    }

    function valueNames() : List[String] = [n for n in this.frame.names if !this.keys.contains(n)]

    // assemble puts the key values in the index (one key) or in leading columns (several keys).
    function assemble(names : List[String], move values : Array[Column]) : DataFrame {
        let firsts := this.groups.map(group => firstOf(group)).toList()
        if this.keys.length() == 1 {
            let label := match this.keys.first() { Some(k) => k, None => "" }
            return DataFrame(names, values, this.frame.keyColumn(label).gather(firsts), label)
        }
        let mut allNames : Array[String] = Array.empty()
        let mut all : Array[Column] = Array.empty()
        for (k in this.keys) {
            allNames.append(k)
            all.append(this.frame.keyColumn(k).gather(firsts))
        }
        for ((n, i) in names.zip(indexRange(names.length()))) {
            allNames.append(n)
            all.append(values[i].copy())
        }
        DataFrame(allNames.toList(), all, Column.ints(indexRange(firsts.length())), "")
    }

    public function sum() : DataFrame = this.aggregate("sum")
    public function mean() : DataFrame = this.aggregate("mean")
    public function median() : DataFrame = this.aggregate("median")
    public function min() : DataFrame = this.aggregate("min")
    public function max() : DataFrame = this.aggregate("max")
    public function std() : DataFrame = this.aggregate("std")
    public function variance() : DataFrame = this.aggregate("var")
    public function first() : DataFrame = this.aggregate("first")
    public function last() : DataFrame = this.aggregate("last")
    public function nunique() : DataFrame = this.aggregate("nunique")
    public function prod() : DataFrame = this.aggregate("prod")
    public function counts() : DataFrame = this.aggregate("count")

    // size gives the number of rows in each group.
    public function size() : Series {
        let sizes := this.groups.map(group => group.length()).toList()
        let firsts := this.groups.map(group => firstOf(group)).toList()
        if this.keys.length() == 1 {
            let label := match this.keys.first() { Some(k) => k, None => "" }
            return Series("", Column.ints(sizes), this.frame.keyColumn(label).gather(firsts), label)
        }
        Series("", Column.ints(sizes), Column.ints(indexRange(sizes.length())), "")
    }

    // ---- group inspection and row-wise group operations

    function ownerArray() : Array[Int] {
        let owner := Array(this.frame.length(), 0)
        for ((g, group) in this.groups.enumerate()) {
            for (i in group) { owner[i] = g }
        }
        owner
    }

    function owners() : List[Int] = this.ownerArray().toList()

    function edgeRows(n : Int, fromEnd : Bool) : DataFrame {
        let mut picked : Array[Int] = Array.empty()
        for (group in this.groups) {
            let count := if n >= 0 then min(n, group.length()) else max(0, group.length() + n)
            let start := if fromEnd then group.length() - count else 0
            for (k in range(count)) { picked.append(group.toArray()[start + k]) }
        }
        this.frame.take(sortedPositions(picked.toList()))
    }

    public function head(n : Int = 5) : DataFrame = this.edgeRows(n, false)
    public function tail(n : Int = 5) : DataFrame = this.edgeRows(n, true)

    // nth keeps the entry at one position inside every group, skipping short groups.
    public function nth(n : Int) : DataFrame {
        let mut picked : Array[Int] = Array.empty()
        for (group in this.groups) {
            let at := if n < 0 then group.length() + n else n
            if at >= 0 && at < group.length() { picked.append(group.toArray()[at]) }
        }
        this.frame.take(sortedPositions(picked.toList()))
    }

    // cumCount numbers the rows inside each group, starting at zero.
    public function cumCount(ascending : Bool = true) : Series {
        let counts := Array(this.frame.length(), 0)
        for (group in this.groups) {
            let n := group.length()
            for ((k, i) in group.enumerate()) {
                counts[i] = if ascending then k else n - 1 - k
            }
        }
        Series("", Column.ints(counts.toList()), this.frame.index.copy(), this.frame.indexName)
    }

    // ngroup gives every row its group number, in the order groups are reported.
    public function ngroup() : Series =
        Series("", Column.ints(this.owners()), this.frame.index.copy(), this.frame.indexName)

    // getGroup returns the rows of one group. It needs exactly one grouping column.
    function groupFor(label : Scalar) : DataFrame or Error {
        if this.keys.length() != 1 {
            return BadArgument(
                "getGroup needs exactly one grouping column; this GroupBy has " +
                    this.keys.length().text(),
            )
        }
        let keyName := match this.keys.first() { Some(k) => k, None => "" }
        let keyColumn := this.frame.keyColumn(keyName)
        let target := scalarKey(label)
        let mut at := -1
        for ((g, group) in this.groups.enumerate()) {
            if scalarKey(scalarAt(keyColumn, firstOf(group))) == target { at = g }
        }
        if at < 0 { return BadArgument("no group with key " + label.text()) }
        this.frame.take(this.groups.toArray()[at])
    }

    public function getGroup(label : Int) : DataFrame or Error = this.groupFor(Scalar.ofInt(label))
    public function getGroup(label : String) : DataFrame or Error =
        this.groupFor(Scalar.ofString(label))
    public function getGroup(label : double) : DataFrame or Error =
        this.groupFor(Scalar.ofFloat(label))
    public function getGroup(label : Bool) : DataFrame or Error =
        this.groupFor(Scalar.ofBool(label))

    // transformAll gives every row the statistic of its group for every value column.
    public function transformAll(statistic : String) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for (name in this.valueNames()) {
            let column := this.frame.keyColumn(name)
            if !statisticNeedsNumbers(statistic) || column.isNumeric() {
                names.append(name)
                out.append(this.transform(name, statistic).data.copy())
            }
        }
        DataFrame(names.toList(), out, this.frame.index.copy(), this.frame.indexName)
    }

    // shift moves each group's values by periods rows without crossing group boundaries.
    public function shift(column : String, periods : Int = 1) : Series {
        let source := this.frame.keyColumn(column)
        let positions := Array(this.frame.length(), -1)
        for (group in this.groups) {
            for ((k, i) in group.enumerate()) {
                let from := k - periods
                if from >= 0 && from < group.length() { positions[i] = group.toArray()[from] }
            }
        }
        Series(
            column,
            gatherGaps(source, positions.toList()),
            this.frame.index.copy(),
            this.frame.indexName,
        )
    }

    public function diff(column : String, periods : Int = 1) : Series {
        let current := this.frame.keyColumn(column)
        let currentSeries := Series(column, current, this.frame.index.copy(), this.frame.indexName)
        if !currentSeries.data.isNumeric() { return currentSeries }
        currentSeries.subtract(this.shift(column, periods))
    }

    public function pctChange(column : String, periods : Int = 1) : Series {
        let current := this.frame.keyColumn(column)
        let currentSeries := Series(column, current, this.frame.index.copy(), this.frame.indexName)
        if !currentSeries.data.isNumeric() { return currentSeries }
        currentSeries.divide(this.shift(column, periods)).subtract(1)
    }

    function groupCumulative(column : String, op : Int) : Series {
        let source := this.frame.keyColumn(column)
        let xs := source.toFloats().toArray()
        let gone := source.missing.toArray()
        let out := Array(this.frame.length(), nanValue())
        for (group in this.groups) {
            let mut current := nanValue()
            let mut seen := false
            for (i in group) {
                if !gone[i] {
                    if !seen {
                        current = xs[i]
                        seen = true
                    } else if op == 0 {
                        current = current + xs[i]
                    } else if op == 1 {
                        current = current * xs[i]
                    } else if op == 2 {
                        current = current.max(xs[i])
                    } else {
                        current = current.min(xs[i])
                    }
                    out[i] = current
                }
            }
        }
        let values :=
            if source.kind ==
                KIND_INT then Column.ofInts(out.map(x => wholeInt(x)).toList(), gone.toList())
            else Column.ofFloats(out.toList(), gone.toList())
        Series(column, values, this.frame.index.copy(), this.frame.indexName)
    }

    public function cumSum(column : String) : Series = this.groupCumulative(column, 0)
    public function cumProd(column : String) : Series = this.groupCumulative(column, 1)
    public function cumMax(column : String) : Series = this.groupCumulative(column, 2)
    public function cumMin(column : String) : Series = this.groupCumulative(column, 3)

    public function rank(
        column : String,
        ascending : Bool = true,
        method : String = "average",
        pct : Bool = false,
    ) : Series {
        let source := this.frame.keyColumn(column)
        let gone := source.missing.toArray()
        let out := Array(this.frame.length(), 0.0)
        for (group in this.groups) {
            let part := source.gather(group)
            let ranks := rankColumn(part, ascending, method, pct).toFloats().toArray()
            for ((k, i) in group.enumerate()) { out[i] = ranks[k] }
        }
        Series(
            column,
            Column.ofFloats(out.toList(), gone.toList()),
            this.frame.index.copy(),
            this.frame.indexName,
        )
    }

    public function sem() : DataFrame = this.aggregate("sem")
    public function skew() : DataFrame = this.aggregate("skew")
    public function kurt() : DataFrame = this.aggregate("kurt")
    public function all() : DataFrame = this.aggregate("all")
    public function any() : DataFrame = this.aggregate("any")

    // quantile gives each numeric value column its group-wise quantile.
    function quantileColumn(name : String, q : double) : Column {
        let column := this.frame.keyColumn(name)
        columnOfScalars(
            [
                Scalar.ofFloat(quantileOf(validFloats(column.gather(group)), q)) for group in this.groups
            ],
        )
    }

    public function quantile(q : double) : DataFrame {
        let wanted := [name for name in this.valueNames() if this.frame.keyColumn(name).isNumeric()]
        let mut out : Array[Column] = Array.empty()
        for (name in wanted) { out.append(this.quantileColumn(name, q)) }
        this.assemble(wanted, out)
    }

    // agg applies a statistic to named columns: agg([("price", "mean"), ("qty", "sum")]).
    public function agg(spec : List[(String, String)]) : DataFrame {
        let mut names : Array[String] = Array.empty()
        let mut out : Array[Column] = Array.empty()
        for ((name, statistic) in spec) {
            if this.frame.hasColumn(name) {
                let column := this.frame.keyColumn(name)
                names.append(name + "_" + statistic)
                out.append(
                    columnOfScalars(
                        [aggregate(column.gather(group), statistic) for group in this.groups],
                    ),
                )
            }
        }
        this.assemble(names.toList(), out)
    }

    // apply keeps the rows of every group that a test accepts, such as groups larger than two.
    public function filterGroups(keep : Int -> Bool) : DataFrame {
        let kept := this.groups.filter(group => keep(group.length())).toList()
        let positions := joinAll(kept)
        this.frame.take(sortedPositions(positions))
    }

    // transform gives every row the statistic of its group, in the original row order.
    public function transform(column : String, statistic : String) : Series {
        let source := this.frame.keyColumn(column)
        let results :=
            columnOfScalars([aggregate(source.gather(group), statistic) for group in this.groups])
        let mut owner : Array[Int] = Array.generate(this.frame.length(), i => 0)
        for ((g, group) in this.groups.enumerate()) {
            for (i in group) { owner[i] = g }
        }
        Series(
            column,
            results.gather(owner.toList()),
            this.frame.index.copy(),
            this.frame.indexName,
        )
    }
}

function mergeRows(
    left : DataFrame,
    right : DataFrame,
    leftOn : List[String],
    rightOn : List[String],
    how : String,
    leftSuffix : String,
    rightSuffix : String,
    leftPositions : List[Int],
    rightPositions : List[Int],
) : DataFrame {
    let mut names : Array[String] = Array.empty()
    let mut columns : Array[Column] = Array.empty()
    for ((k, rk) in leftOn.zip(rightOn)) {
        names.append(k)
        let fromLeft := gatherGaps(left.keyColumn(k), leftPositions)
        let fromRight := gatherGaps(right.keyColumn(rk), rightPositions)
        columns.append(coalesce(fromLeft, fromRight))
    }
    for (name in left.names) {
        if !leftOn.contains(name) {
            names.append(
                if right.hasColumn(name) && !rightOn.contains(name) then name + leftSuffix else name,
            )
            columns.append(gatherGaps(left.keyColumn(name), leftPositions))
        }
    }
    for (name in right.names) {
        if !rightOn.contains(name) {
            names.append(
                if left.hasColumn(name) && !leftOn.contains(name) then name + rightSuffix else name,
            )
            columns.append(gatherGaps(right.keyColumn(name), rightPositions))
        }
    }
    let result :=
        DataFrame(names.toList(), columns, Column.ints(indexRange(leftPositions.length())), "")
    if how == "outer" {
        // pandas orders the rows of an outer merge by their keys.
        let mut order := indexRange(result.length())
        for (k in reversedStrings(leftOn)) {
            order = orderBy(result.keyColumn(k), order, true)
        }
        return result.take(order).resetIndex(drop = true)
    }
    result
}

function mergeFrames(
    left : DataFrame,
    right : DataFrame,
    leftOn : List[String],
    rightOn : List[String],
    how : String,
    leftSuffix : String,
    rightSuffix : String,
) : DataFrame {
    let leftKeys := compositeKeys(left, leftOn)
    let rightKeys := compositeKeys(right, rightOn)
    if how == "left" && leftOn.length() == 1 && rightOn.length() == 1 {
        let (lr, rr) := __mergeLeftPositions(leftKeys, rightKeys)
        return mergeRows(left, right, leftOn, rightOn, how, leftSuffix, rightSuffix, lr, rr)
    }
    let rightTable : MutMap[String, List[Int]] = MutMap()
    for (group in groupRuns(rightKeys)) {
        let own := rightKeys.toArray()[firstOf(group)]
        rightTable.put(own, group)
    }
    let leftTable : MutMap[String, List[Int]] = MutMap()
    if how == "right" {
        for (group in groupRuns(leftKeys)) {
            let own := leftKeys.at(firstOf(group))
            leftTable.put(own, group)
        }
    }
    let mut leftRows : Array[Int] = Array.empty()
    let mut rightRows : Array[Int] = Array.empty()
    if how == "right" {
        for ((j, key) in rightKeys.enumerate()) {
            match leftTable.get(key) {
                Some(matches) => {
                    for (i in matches) {
                        leftRows.append(i)
                        rightRows.append(j)
                    }
                },
                None => {
                    leftRows.append(-1)
                    rightRows.append(j)
                },
            }
        }
    } else {
        let seen : MutSet[Int] = MutSet()
        for ((i, key) in leftKeys.enumerate()) {
            match rightTable.get(key) {
                Some(matches) => {
                    for (j in matches) {
                        leftRows.append(i)
                        rightRows.append(j)
                        if how == "outer" { seen.add(j) }
                    }
                },
                None => {
                    if how == "left" || how == "outer" {
                        leftRows.append(i)
                        rightRows.append(-1)
                    }
                },
            }
        }
        if how == "outer" {
            for (j in range(right.length())) {
                if !seen.contains(j) {
                    leftRows.append(-1)
                    rightRows.append(j)
                }
            }
        }
    }
    mergeRows(
        left,
        right,
        leftOn,
        rightOn,
        how,
        leftSuffix,
        rightSuffix,
        leftRows.toList(),
        rightRows.toList(),
    )
}

function compositeKeys(frame : DataFrame, names : List[String]) : List[String] {
    if names.length() == 1 {
        let only := match names.first() { Some(name) => name, None => "" }
        return frame.keyColumn(only).keys()
    }
    let mut parts := Column.noneMissing(frame.length()).map(x => "").toList()
    for (name in names) {
        let texts := frame.keyColumn(name).keys()
        parts = [p + "|" + t for (p, t) in parts.zip(texts)]
    }
    parts
}

// std.encoding: Base64, hex, CRC-32 and SHA-256 over the UTF-8 bytes of a String.

const ALPHABET : String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function bytesOf(text : String) : List[Int] = [text.byteAt(i) for i in range(text.byteLength())]

public function base64Encode(text : String) : String {
    let bytes := bytesOf(text)
    let parts : Array[String] = Array.empty()
    let mut i := 0
    while i < bytes.length() {
        let chunk := bytes.slice(i, i + 3)
        let a := chunk.slice(0, 1).sum()
        let b := chunk.slice(1, 2).sum()
        let c := chunk.slice(2, 3).sum()
        let n := (a << 16) | (b << 8) | c
        parts.append(ALPHABET[(n >> 18) & 63])
        parts.append(ALPHABET[(n >> 12) & 63])
        parts.append(if chunk.length() > 1 then ALPHABET[(n >> 6) & 63] else "=")
        parts.append(if chunk.length() > 2 then ALPHABET[n & 63] else "=")
        i += 3
    }
    return parts.join("")
}

function sextet(b : Int) : Int =
    if b >= 65 && b <= 90 then b - 65
    else if b >= 97 && b <= 122 then b - 71
    else if b >= 48 && b <= 57 then b + 4 else if b == 43 then 62 else if b == 47 then 63 else -1

public function base64Decode(text : String) : String or Error {
    let clean := text.replace("\n", "").replace("\r", "")
    if clean.byteLength() % 4 != 0 {
        return Error("Base64 text length is not a multiple of 4")
    }
    let parts : Array[String] = Array.empty()
    let mut i := 0
    while i < clean.byteLength() {
        let mut n := 0
        let mut padding := 0
        for (j in range(4)) {
            let b := clean.byteAt(i + j)
            if b == 61 {
                if j < 2 || i + 4 != clean.byteLength() {
                    return Error("Base64 padding is only allowed at the end")
                }
                padding += 1
                n = n << 6
            } else {
                let value := sextet(b)
                if value < 0 || padding > 0 {
                    return Error("Base64 text has an invalid character")
                }
                n = (n << 6) | value
            }
        }
        if padding > 2 || padding == 2 && (n & 65535) != 0 || padding == 1 && (n & 255) != 0 {
            return Error("Base64 text has invalid padding bits")
        }
        parts.append(((n >> 16) & 255).chr())
        if padding < 2 {
            parts.append(((n >> 8) & 255).chr())
        }
        if padding < 1 {
            parts.append((n & 255).chr())
        }
        i += 4
    }
    return fromLatin1(parts.join(""))
}

// The decoders above build one character per byte; this turns those back into UTF-8 text.
function fromLatin1(text : String) : String or Error {
    let codes := [c.ord() for c in text.split("")]
    let parts : Array[String] = Array.empty()
    let mut i := 0
    while i < codes.length() {
        let b := codes.slice(i, i + 1).sum()
        let width :=
            if b < 128 then 1
            else if b >= 240 then 4 else if b >= 224 then 3 else if b >= 192 then 2 else 0
        if width == 0 || i + width > codes.length() {
            return Error("The decoded bytes are not valid UTF-8")
        }
        let mut code :=
            if width == 1 then b
            else if width == 2 then b & 31 else if width == 3 then b & 15 else b & 7
        for (k in range(1, width)) {
            let next := codes.slice(i + k, i + k + 1).sum()
            if next < 128 || next >= 192 {
                return Error("The decoded bytes are not valid UTF-8")
            }
            code = (code << 6) | (next & 63)
        }
        if width == 2 && code < 128 ||
            width == 3 && code < 2048 ||
            width == 4 && code < 65536 || code > 1114111 || code >= 55296 && code <= 57343 {
                return Error("The decoded bytes are not valid UTF-8")
            }
        parts.append(code.chr())
        i += width
    }
    return parts.join("")
}

public function hexEncode(text : String) : String = bytesOf(text).map(b => f"{b:02x}").join("")

public function hexDecode(text : String) : String or Error {
    if text.byteLength() % 2 != 0 {
        return Error("Hex text has an odd length")
    }
    let parts : Array[String] = Array.empty()
    let mut i := 0
    while i < text.byteLength() {
        let pair := text.byteSlice(i, i + 2)
        let high := "0123456789abcdef".find(pair.substring(0, 1).lower())
        let low := "0123456789abcdef".find(pair.substring(1, 2).lower())
        if high < 0 || low < 0 {
            return Error("Hex text has an invalid digit")
        }
        parts.append((high * 16 + low).chr())
        i += 2
    }
    return fromLatin1(parts.join(""))
}

// CRC-32 (IEEE 802.3), as zlib computes it.
public function crc32(text : String) : Int {
    let mut crc := 4294967295
    for (b in bytesOf(text)) {
        crc = crc ^ b
        for (k in range(8)) {
            crc = if (crc & 1) == 1 then (crc >> 1) ^ 3988292384 else crc >> 1
        }
    }
    return crc ^ 4294967295
}

const K : List[Int] =

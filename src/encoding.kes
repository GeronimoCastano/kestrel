function rotr(x : Int, n : Int) : Int = ((x >> n) | (x << (32 - n))) & 4294967295

// The SHA-256 digest of the text's UTF-8 bytes, as 64 lowercase hex digits.
public function sha256(text : String) : String {
    let bytes := bytesOf(text)
    let bits := bytes.length() * 8
    let padded : Array[Int] = Array.empty()
    for (b in bytes) {
        padded.append(b)
    }
    padded.append(128)
    while padded.length() % 64 != 56 {
        padded.append(0)
    }
    for (k in range(8)) {
        padded.append((bits >> (56 - 8 * k)) & 255)
    }
    let h : Array[Int] = Array.empty()
    for (
        v in [
            1779033703,
            3144134277,
            1013904242,
            2773480762,
            1359893119,
            2600822924,
            528734635,
            1541459225,
        ]
    ) {
        h.append(v)
    }
    let w : Array[Int] = Array(64, 0)
    let mut chunk := 0
    while chunk < padded.length() {
        for (t in range(16)) {
            let at := chunk + 4 * t
            w[t] =
                (padded[at] << 24) | (padded[at + 1] << 16) | (padded[at + 2] << 8) | padded[at + 3]
        }
        for (t in range(16, 64)) {
            let s0 := rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)
            let s1 := rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & 4294967295
        }
        let mut a := h[0]
        let mut b := h[1]
        let mut c := h[2]
        let mut d := h[3]
        let mut e := h[4]
        let mut f := h[5]
        let mut g := h[6]
        let mut hh := h[7]
        let mut t := 0
        for (k in K) {
            let s1 := rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch := (e & f) ^ ((e ^ 4294967295) & g)
            let temp1 := (hh + s1 + ch + k + w[t]) & 4294967295
            let s0 := rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj := (a & b) ^ (a & c) ^ (b & c)
            let temp2 := (s0 + maj) & 4294967295
            hh = g
            g = f
            f = e
            e = (d + temp1) & 4294967295
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & 4294967295
            t += 1
        }
        h[0] = (h[0] + a) & 4294967295
        h[1] = (h[1] + b) & 4294967295
        h[2] = (h[2] + c) & 4294967295
        h[3] = (h[3] + d) & 4294967295
        h[4] = (h[4] + e) & 4294967295
        h[5] = (h[5] + f) & 4294967295
        h[6] = (h[6] + g) & 4294967295
        h[7] = (h[7] + hh) & 4294967295
        chunk += 64
    }
    return h.toList().map(v => f"{v:08x}").join("")
}

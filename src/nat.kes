// Natural-number arithmetic as ordinary structural functions, with the first
// identities checked by the proof kernel. The built-in `+` and `*` stay
// available; these names give proofs something to unfold.
public function plus(a : Nat, b : Nat) : Nat = match a { Zero => b, Succ(k) => Succ(plus(k, b)) }

public function times(a : Nat, b : Nat) : Nat =
    match a { Zero => Zero, Succ(k) => plus(b, times(k, b)) }

@simp
public theorem plusZeroR(n : Nat) : plus(n, Zero) = n by {
    induction n {
        Zero => { rfl }
        Succ(k) ih => { simp [ih] }
    }
}

public theorem plusSuccR(n : Nat, m : Nat) : plus(n, Succ(m)) = Succ(plus(n, m)) by {
    induction n {
        Zero => { rfl }
        Succ(k) ih => { simp [ih] }
    }
}

@simp
public theorem timesZeroR(n : Nat) : times(n, Zero) = Zero by {
    induction n {
        Zero => { rfl }
        Succ(k) ih => { simp [ih] }
    }
}

// std.statistics: summaries of a List of doubles. Tensors have their own std.stats.

public function mean(xs : List[double]) : double or Error {
    if xs.isEmpty() {
        return Error("mean of an empty List")
    }
    return xs.sum() / xs.length().toDouble()
}

// The sample variance, dividing by n - 1.
public function variance(xs : List[double]) : double or Error {
    if xs.length() < 2 {
        return Error("variance needs at least two values")
    }
    let m := mean(xs)?
    return xs.map(x => (x - m) * (x - m)).sum() / (xs.length() - 1).toDouble()
}

public function stddev(xs : List[double]) : double or Error = variance(xs)?.sqrt()

// The value at fraction `q` of the sorted data, interpolating linearly as NumPy's default does.
public function quantile(xs : List[double], q : double) : double or Error {
    if xs.isEmpty() || q < 0.0 || q > 1.0 {
        return Error("quantile needs values and a fraction between 0 and 1")
    }
    let sorted := xs.sorted()
    let position := q * (sorted.length() - 1).toDouble()
    let below := position.floor()
    let index := match below.checkedToInt() { n => n, _ => 0 }
    let low := sorted.slice(index, index + 1).sum()
    let high := sorted.slice(index + 1, index + 2).sum()
    if index + 1 >= sorted.length() {
        return low
    }
    return low + (high - low) * (position - below)
}

public function median(xs : List[double]) : double or Error = quantile(xs, 0.5)

public function percentile(xs : List[double], p : double) : double or Error =
    quantile(xs, p / 100.0)

// The most frequent value; the smallest one when several tie.
public function mode(xs : List[double]) : double or Error {
    if xs.isEmpty() {
        return Error("mode of an empty List")
    }
    let sorted := xs.sorted()
    let mut best := 0.0
    let mut bestCount := 0
    let mut current := 0.0
    let mut run := 0
    for (x in sorted) {
        if run > 0 && x == current {
            run += 1
        } else {
            current = x
            run = 1
        }
        if run > bestCount {
            best = current
            bestCount = run
        }
    }
    return best
}

// Counts of values in `bins` equal-width bins from the minimum to the maximum.
public function histogram(xs : List[double], bins : Int) : List[Int] or Error {
    if xs.isEmpty() || bins < 1 {
        return Error("histogram needs values and at least one bin")
    }
    let low := xs.min().unwrapOr(0.0)
    let high := xs.max().unwrapOr(0.0)
    let width := if high > low then (high - low) / bins.toDouble() else 1.0
    let counts : Array[Int] = Array(bins, 0)
    for (x in xs) {
        let slot :=
            match ((x - low) / width).floor().checkedToInt() { n => n.clamp(0, bins - 1), _ => 0 }
        counts[slot] = counts[slot] + 1
    }
    return counts.toList()
}

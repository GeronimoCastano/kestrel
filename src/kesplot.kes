    public mut function plot(
        x : List[double],
        series : List[List[double]],
        labels : List[String] = [],
        colors : List[String] = [],
    ) : void {
        let mut i := 0
        for (values in series) {
            let label := if i < labels.length() then listAt(labels, i) else ""
            let color := if i < colors.length() then listAt(colors, i) else ""
            this.addLineValues(x, values, [], label, color, -1.0, "", "", -1.0, 1.0, "")
            i = i + 1
        }
        if labels.length() > 0 || series.length() > 1 { this.current.legendShown = true }
    }

    public mut function plot(
        series : List[List[double]],
        labels : List[String] = [],
        colors : List[String] = [],
    ) : void {
        let mut longest := 0
        for (values in series) {
            if values.length() > longest { longest = values.length() }
        }
        this.plot([i.toDouble() for i in range(longest)], series, labels, colors)
    }

    mut function addContourMatrix(
        matrix : List[List[double]],
        levels : List[double],
        rowLabels : List[String],
        colLabels : List[String],
        cmap : String,
        lineWidth : double,
        colorbar : Bool,
        colorbarLabel : String,
    ) : void {
        if matrix.length() == 0 { return }
        let rows := matrix.length()
        let cols := listAt(matrix, 0).length()
        if rows == 0 || cols == 0 { return }
        let bounds := Bounds()
        for (row in matrix) {
            for (value in row) { bounds.include(value) }
        }
        if !bounds.any { return }
        let low := bounds.low
        let high := if bounds.high > bounds.low then bounds.high else bounds.low + 1.0
        let chosen : List[double] = [value for value in levels if value > low && value < high]
        this.current.pieMode = false
        this.current.aspect = "equal"
        this.current.xMin = 0.0
        this.current.xMax = if cols <= 1 then 1.0 else (cols - 1).toDouble()
        this.current.yMin = 0.0
        this.current.yMax = if rows <= 1 then 1.0 else (rows - 1).toDouble()
        if colLabels.length() == cols {
            this.current.xTickPositions = [i.toDouble() for i in range(cols)]
            this.current.xTickLabels = colLabels
        }
        if rowLabels.length() == rows {
            this.current.yTickPositions = [(rows - 1 - i).toDouble() for i in range(rows)]
            this.current.yTickLabels = rowLabels
        }
        this.current.addContour(
            Contour(
                matrix,
                rowLabels,
                colLabels,
                chosen,
                cmap,
                max(0.2, lineWidth),
                colorbarLabel,
                colorbar,
            ),
        )
        this.current.colorbar = Colorbar(cmap, low, high, colorbarLabel)
        this.current.colorbar.visible = colorbar
    }

    public mut function contour(
        matrix : List[List[double]],
        levels : Int = 7,
        cmap : String = "viridis",
        lineWidth : double = 1.0,
        rowLabels : List[String] = [],
        colLabels : List[String] = [],
        colorbar : Bool = true,
        colorbarLabel : String = "",
    ) : void {
        if matrix.length() == 0 { return }
        let bounds := Bounds()
        for (row in matrix) {
            for (value in row) { bounds.include(value) }
        }
        if !bounds.any { return }
        let span := if bounds.high > bounds.low then bounds.high - bounds.low else 1.0
        let count := clampInt(levels, 1, 40)
        let chosen : List[double] =
            [bounds.low + span * i.toDouble() / (count + 1).toDouble() for i in range(1, count + 1)]
        this.addContourMatrix(
            matrix,
            chosen,
            rowLabels,
            colLabels,
            cmap,
            lineWidth,
            colorbar,
            colorbarLabel,
        )
    }

    public mut function contour(
        matrix : List[List[double]],
        levels : List[double],
        cmap : String = "viridis",
        lineWidth : double = 1.0,
        rowLabels : List[String] = [],
        colLabels : List[String] = [],
        colorbar : Bool = true,
        colorbarLabel : String = "",
    ) : void {
        this.addContourMatrix(
            matrix,
            levels,
            rowLabels,
            colLabels,
            cmap,
            lineWidth,
            colorbar,
            colorbarLabel,
        )
    }

    public mut function contourFrame(
        frame : DataFrame,
        columns : List[String] = [],
        levels : Int = 7,
        cmap : String = "viridis",
        lineWidth : double = 1.0,
        colorbar : Bool = true,
        colorbarLabel : String = "",
    ) : void or
        Error {
            let names := frameNumericColumns(frame, columns)?
            let rows := frame.length()
            if rows < 2 || names.length() < 2 {
                return Error("contourFrame needs at least two rows and two numeric columns")
            }
            let mut columnsData : Array[List[double]] = Array.empty()
            for (name in names) { columnsData.append(frameNumericValues(frame, name)?) }
            let columnList := columnsData.toList()
            let matrix : List[List[double]] =
                [
                    [listAt(listAt(columnList, c), r) for c in range(names.length())] for r in range(
                        rows,
                    )
                ]
            this.contour(
                matrix,
                levels,
                cmap,
                lineWidth,
                frame.index.texts(),
                names,
                colorbar,
                colorbarLabel,
            )
        }

    public mut function annotate(
        text : String,
        xyX : double,
        xyY : double,
        textX : double,
        textY : double,
        color : String = "",
        size : double = -1.0,
        align : String = "left",
        weight : String = "normal",
        arrowColor : String = "",
        arrowWidth : double = -1.0,
        alpha : double = 1.0,
    ) : void {
        let chosen := if color == "" then this.style.textColor else normalizeColor(color)
        let arrow := if arrowColor == "" then chosen else normalizeColor(arrowColor)
        let width := if arrowWidth < 0.0 then max(0.8, this.style.lineWidth * 0.8) else arrowWidth
        this.current.addAnnotation(
            Annotation(
                textX,
                textY,
                xyX,
                xyY,
                text,
                chosen,
                if size < 0.0 then this.style.fontSize else size,
                align,
                weight,
                arrow,
                width,
                clamp(alpha, 0.0, 1.0),
            ),
        )
    }

    public mut function arrow(
        x1 : double,
        y1 : double,
        x2 : double,
        y2 : double,
        color : String = "",
        width : double = -1.0,
        alpha : double = 1.0,
    ) : void {
        this.annotate(
            "",
            x1,
            y1,
            x2,
            y2,
            color = color,
            arrowColor = color,
            arrowWidth = width,
            alpha = alpha,
        )
    }

    // DataFrame-first spellings keep the common pandas shape: fig.plot(df, x = "a", y = "b").

    public mut function plot(
        frame : DataFrame,
        x : String = "",
        y : List[String] = [],
        kind : String = "line",
        colors : List[String] = [],
        labels : List[String] = [],
        alpha : double = 1.0,
        lineWidth : double = -1.0,
        marker : String = "",
        stacked : Bool = false,
    ) : void or
        Error {
            this.plotFrame(
                frame,
                x,
                y,
                kind = kind,
                colors = colors,
                labels = labels,
                alpha = alpha,
                lineWidth = lineWidth,
                marker = marker,
                stacked = stacked,
            )
        }

    public mut function plot(
        frame : DataFrame,
        x : String,
        y : String,
        kind : String = "line",
        colors : List[String] = [],
        labels : List[String] = [],
        alpha : double = 1.0,
        lineWidth : double = -1.0,
        marker : String = "",
        stacked : Bool = false,
    ) : void or
        Error {
            this.plotFrame(
                frame,
                x,
                [y],
                kind = kind,
                colors = colors,
                labels = labels,
                alpha = alpha,
                lineWidth = lineWidth,
                marker = marker,
                stacked = stacked,
            )
        }

    public mut function bar(
        frame : DataFrame,
        x : String = "",
        y : List[String] = [],
        stacked : Bool = false,
        horizontal : Bool = false,
        colors : List[String] = [],
        labels : List[String] = [],
        alpha : double = 1.0,
    ) : void or
        Error {
            this.barFrame(
                frame,
                x,
                y,
                stacked = stacked,
                horizontal = horizontal,
                colors = colors,
                labels = labels,
                alpha = alpha,
            )
        }

    public mut function bar(
        frame : DataFrame,
        x : String,
        y : String,
        stacked : Bool = false,
        horizontal : Bool = false,
        colors : List[String] = [],
        labels : List[String] = [],
        alpha : double = 1.0,
    ) : void or
        Error {
            this.barFrame(
                frame,
                x,
                [y],
                stacked = stacked,
                horizontal = horizontal,
                colors = colors,
                labels = labels,
                alpha = alpha,
            )
        }

    public mut function scatter(
        frame : DataFrame,
        x : String = "",
        y : String = "",
        colorBy : String = "",
        sizeBy : String = "",
        marker : String = "",
        markerSize : double = -1.0,
        alpha : double = 0.8,
        label : String = "",
        cmap : String = "viridis",
    ) : void or
        Error {
            this.scatterFrame(frame, x, y, colorBy, sizeBy, marker, markerSize, alpha, label, cmap)
        }

    public mut function hist(
        frame : DataFrame,
        columns : List[String] = [],
        bins : Int = 10,
        density : Bool = false,
        cumulative : Bool = false,
        histType : String = "bar",
        labels : List[String] = [],
        colors : List[String] = [],
        alpha : double = 0.6,
    ) : void or
        Error {
            this.histFrame(
                frame,
                columns,
                bins,
                density,
                cumulative,
                histType,
                labels,
                colors,
                alpha,
            )
        }

    public mut function hist(
        frame : DataFrame,
        column : String,
        bins : Int = 10,
        density : Bool = false,
        cumulative : Bool = false,
        histType : String = "bar",
        labels : List[String] = [],
        colors : List[String] = [],
        alpha : double = 0.6,
    ) : void or
        Error {
            this.histFrame(
                frame,
                [column],
                bins,
                density,
                cumulative,
                histType,
                labels,
                colors,
                alpha,
            )
        }

    public mut function pie(
        frame : DataFrame,
        values : String,
        labels : String = "",
        colors : List[String] = [],
        startAngle : double = 90.0,
        donut : double = 0.0,
        autoPercent : Bool = false,
    ) : void or
        Error {
            this.pieFrame(frame, values, labels, colors, startAngle, donut, autoPercent)
        }

    public mut function savefig(path : String, dpi : Int = -1) : void or Error with Effects =
        this.save(path, dpi)

    public mut function suptitle(text : String, size : double = -1.0) : void =
        this.figureTitleText(text, size)
}

// ---------------------------------------------------------------- Kesdas adapters

function frameXValues(frame : DataFrame, x : String) : XValues or Error {
    if x == "" { return frameIndexValues(frame) }
    if !frame.hasColumn(x) { return Error("no column named " + x) }
    let series := frame.col(x)?
    xValuesFromColumn(series.data)
}

function frameNumericColumns(frame : DataFrame, wanted : List[String]) : List[String] or Error {
    if wanted.length() > 0 {
        for (name in wanted) {
            if !frame.hasColumn(name) { return Error("no column named " + name) }
            let series := frame.col(name)?
            let kind := series.dtype()
            if kind != "int64" && kind != "float64" && kind != "bool" {
                return Error("column " + name + " is not numeric")
            }
        }
        return wanted
    }
    let mut names : Array[String] = Array.empty()
    for (name in frame.names) {
        let series := frame.col(name)?
        let kind := series.dtype()
        if kind == "int64" || kind == "float64" { names.append(name) }
    }
    if names.length() == 0 { return Error("the frame has no numeric columns") }
    names.toList()
}

function frameNumericValues(frame : DataFrame, name : String) : List[double] or Error {
    if !frame.hasColumn(name) { return Error("no column named " + name) }
    let series := frame.col(name)?
    let kind := series.dtype()
    if kind == "str" { return Error("column " + name + " is not numeric") }
    series.toFloats()
}

function frameTextValues(frame : DataFrame, name : String) : List[String] or Error {
    if !frame.hasColumn(name) { return Error("no column named " + name) }
    let series := frame.col(name)?
    series.toStrings()
}

function uniqueTexts(values : List[String]) : List[String] {
    let mut out : Array[String] = Array.empty()
    for (value in values) {
        if !containsText(out.toList(), value) { out.append(value) }
    }
    out.toList()
}

function indexOfText(values : List[String], value : String) : Int {
    let mut i := 0
    for (item in values) {
        if item == value { return i }
        i = i + 1
    }
    0
}

function scaledSizes(values : List[double], small : double, large : double) : List[double] {
    let bounds := Bounds()
    for (value in values) { bounds.include(value) }
    if !bounds.any { return [] }
    let span := bounds.high - bounds.low
    if span <= 0.0 { return [(small + large) / 2.0 for v in values] }
    [small + (v - bounds.low) / span * (large - small) for v in values]
}

        edgeColor : String = "",
        edgeWidth : double = -1.0,
    ) : void {
        this.addScatterValues(
            x,
            y,
            [],
            [],
            [],
            label,
            color,
            marker,
            markerSize,
            alpha,
            edgeColor,
            if edgeWidth < 0.0 then this.style.markerEdgeWidth else edgeWidth,
        )
    }


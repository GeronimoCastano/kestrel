function colormapColor(cmap : String, t : double) : String {
    let colors := colorPalette(cmap)
    let count := colors.length()
    if count == 0 { return "#000000" }
    let scaled := clamp(t, 0.0, 1.0) * (count - 1).toDouble()
    let low := whole(floor(scaled))
    let high := min(low + 1, count - 1)
    mixColor(listAt(colors, low), listAt(colors, high), scaled - low.toDouble())
}

// ---------------------------------------------------------------- math labels

function superscriptOf(text : String) : String {
    let mut out := ""
    for (ch in text) {
        out =
            out +
                (
                    if ch == "0" then "⁰"
                        else if ch == "1" then "¹"
                        else if ch == "2" then "²"
                        else if ch == "3" then "³"
                        else if ch == "4" then "⁴"
                        else if ch == "5" then "⁵"
                        else if ch == "6" then "⁶"
                        else if ch == "7" then "⁷"
                        else if ch == "8" then "⁸"
                        else if ch == "9" then "⁹"
                        else if ch == "-" then "⁻"
                        else if ch == "+" then "⁺"
                        else if ch == "=" then "⁼"
                        else if ch == "(" then "⁽"
                        else if ch == ")" then "⁾"
                        else if ch == "n" then "ⁿ"
                        else if ch == "i" then "ⁱ"
                        else if ch == "a" then "ᵃ"
                        else if ch == "b" then "ᵇ"
                        else if ch == "c" then "ᶜ"
                        else if ch == "d" then "ᵈ"
                        else if ch == "e" then "ᵉ"
                        else if ch == "k" then "ᵏ"
                        else if ch == "m" then "ᵐ"
                        else if ch == "o" then "ᵒ"
                        else if ch == "p" then "ᵖ"
                        else if ch == "r" then "ʳ"
                        else if ch == "s" then "ˢ"
                        else if ch == "t" then "ᵗ"
                        else if ch == "u" then "ᵘ"
                        else if ch == "v" then "ᵛ" else if ch == "x" then "ˣ" else ch
                )
    }
    out
}

function subscriptOf(text : String) : String {
    let mut out := ""
    for (ch in text) {
        out =
            out +
                (
                    if ch == "0" then "₀"
                        else if ch == "1" then "₁"
                        else if ch == "2" then "₂"
                        else if ch == "3" then "₃"
                        else if ch == "4" then "₄"
                        else if ch == "5" then "₅"
                        else if ch == "6" then "₆"
                        else if ch == "7" then "₇"
                        else if ch == "8" then "₈"
                        else if ch == "9" then "₉"
                        else if ch == "-" then "₋"
                        else if ch == "+" then "₊"
                        else if ch == "=" then "₌"
                        else if ch == "(" then "₍"
                        else if ch == ")" then "₎"
                        else if ch == "a" then "ₐ"
                        else if ch == "e" then "ₑ"
                        else if ch == "h" then "ₕ"
                        else if ch == "i" then "ᵢ"
                        else if ch == "j" then "ⱼ"
                        else if ch == "k" then "ₖ"
                        else if ch == "l" then "ₗ"
                        else if ch == "m" then "ₘ"
                        else if ch == "n" then "ₙ"
                        else if ch == "o" then "ₒ"
                        else if ch == "p" then "ₚ"
                        else if ch == "r" then "ᵣ"
                        else if ch == "s" then "ₛ"
                        else if ch == "t" then "ₜ"
                        else if ch == "u" then "ᵤ"
                        else if ch == "v" then "ᵥ" else if ch == "x" then "ₓ" else ch
                )
    }
    out
}

function greekLetter(name : String) : String {
    if name == "alpha" then "α"
        else if name == "beta" then "β"
        else if name == "gamma" then "γ"
        else if name == "delta" then "δ"
        else if name == "epsilon" then "ε"
        else if name == "varepsilon" then "ε"
        else if name == "zeta" then "ζ"
        else if name == "eta" then "η"
        else if name == "theta" then "θ"
        else if name == "vartheta" then "ϑ"
        else if name == "iota" then "ι"
        else if name == "kappa" then "κ"
        else if name == "lambda" then "λ"
        else if name == "mu" then "μ"
        else if name == "nu" then "ν"
        else if name == "xi" then "ξ"
        else if name == "pi" then "π"
        else if name == "rho" then "ρ"
        else if name == "sigma" then "σ"
        else if name == "tau" then "τ"
        else if name == "upsilon" then "υ"
        else if name == "phi" then "φ"
        else if name == "varphi" then "φ"
        else if name == "chi" then "χ"
        else if name == "psi" then "ψ"
        else if name == "omega" then "ω"
        else if name == "Gamma" then "Γ"
        else if name == "Delta" then "Δ"
        else if name == "Theta" then "Θ"
        else if name == "Lambda" then "Λ"
        else if name == "Xi" then "Ξ"
        else if name == "Pi" then "Π"
        else if name == "Sigma" then "Σ"
        else if name == "Upsilon" then "Υ"
        else if name == "Phi" then "Φ"
        else if name == "Psi" then "Ψ" else if name == "Omega" then "Ω" else ""
}

function mathSymbol(name : String) : String {
    if name == "infty" then "∞"
        else if name == "pm" then "±"
        else if name == "mp" then "∓"
        else if name == "times" then "×"
        else if name == "cdot" then "·"
        else if name == "div" then "÷"
        else if name == "le" || name == "leq" then "≤"
        else if name == "ge" || name == "geq" then "≥"
        else if name == "ne" || name == "neq" then "≠"
        else if name == "approx" then "≈"
        else if name == "sim" then "∼"
        else if name == "propto" then "∝"
        else if name == "partial" then "∂"
        else if name == "nabla" then "∇"
        else if name == "sum" then "Σ"
        else if name == "prod" then "Π"
        else if name == "int" then "∫"
        else if name == "to" || name == "rightarrow" then "→"
        else if name == "leftarrow" then "←"
        else if name == "leftrightarrow" then "↔"
        else if name == "Rightarrow" then "⇒"
        else if name == "degree" then "°"
        else if name == "circ" then "∘"
        else if name == "ldots" || name == "dots" then "…"
        else if name == "langle" then "⟨"
        else if name == "rangle" then "⟩"
        else if name == "left" || name == "right" then ""
        else if name == "quad" then " "
        else if name == "qquad" then "  "
        else if name == "sin" then "sin"
        else if name == "cos" then "cos"
        else if name == "tan" then "tan"
        else if name == "log" then "log"
        else if name == "ln" then "ln"
        else if name == "exp" then "exp"
        else if name == "max" then "max"
        else if name == "min" then "min"
        else if name == "lim" then "lim"
        else if name == "arg" then "arg"
        else if name == "det" then "det" else if name == "dim" then "dim" else ""
}

// readGroup returns the braced group starting at index and the next index.
function readGroup(text : String, start : Int) : (String, Int) {
    let mut i := start
    while i < text.length() && text[i] == " " { i = i + 1 }
    if i >= text.length() { return ("", i) }
    if text[i] != "{" {
        return (sliceText(text, i, i + 1), i + 1)
    }
    let mut depth := 1
    let mut end := i + 1
    while end < text.length() && depth > 0 {
        if text[end] == "{" { depth = depth + 1 } else if text[end] == "}" { depth = depth - 1 }
        end = end + 1
    }
    (sliceText(text, i + 1, max(i + 1, end - 1)), end)
}

function convertMath(text : String) : String {
    let mut out := ""
    let mut i := 0
    while i < text.length() {
        let ch := text[i]
        if ch == "\\" {
            let mut j := i + 1
            let mut name := ""
            while j < text.length() {
                let c := text[j]
                if isLowerLetter(c) || isUpperLetter(c) {
                    name = name + c
                    j = j + 1
                } else {
                    break
                }
            }
            if name == "" {
                if j < text.length() { out = out + text[j]; i = j + 1 } else { i = j }
            } else if name == "frac" {
                let (first, afterFirst) := readGroup(text, j)
                let (second, afterSecond) := readGroup(text, afterFirst)
                out = out + "(" + convertMath(first) + ")/(" + convertMath(second) + ")"
                i = afterSecond
            } else if name == "sqrt" {
                let (inside, after) := readGroup(text, j)
                out = out + "√(" + convertMath(inside) + ")"
                i = after
            } else if name == "text" ||
                name == "mathrm" ||
                name == "operatorname" || name == "mathit" || name == "mathbf" || name == "mathsf" {
                    let (inside, after) := readGroup(text, j)
                    out = out + inside
                    i = after
                } else {
                    let greek := greekLetter(name)
                    if greek != "" { out = out + greek } else { out = out + mathSymbol(name) }
                    i = j
                }
        } else if ch == "^" {
            let (group, after) := readGroup(text, i + 1)
            out = out + superscriptOf(convertMath(group))
            i = after
        } else if ch == "_" {
            let (group, after) := readGroup(text, i + 1)
            out = out + subscriptOf(convertMath(group))
            i = after
        } else if ch == "{" || ch == "}" {
            i = i + 1
        } else {
            out = out + ch
            i = i + 1
        }
    }
    out
}

// mathText turns $...$ segments into Unicode text that SVG fonts can show.
// It covers the common Greek letters, operators, superscripts and subscripts.
function mathText(text : String) : String {
    if !text.contains("$") { return text }
    let parts := text.split("$")
    if parts.length() % 2 == 0 { return text }
    let mut out := ""
    let mut index := 0
    for (part in parts) {
        if index % 2 == 0 {
            out = out + part
        } else {
            out = out + convertMath(part)
        }
        index = index + 1
    }
    out
}

// ---------------------------------------------------------------- SVG text

function escapeXml(text : String) : String =
    text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace(
        "'",
        "&apos;",
    )

function fmt(x : double) : String {
    if x != x { return "0" }
    let text := f"{x:.2f}"
    if text == "-0.00" then "0.00" else text
}

// ---------------------------------------------------------------- styles

// A Style holds the settings matplotlib calls rcParams. Styles are values:
// use the static constructors, or Style.byName("science+ieee"), and pass one to
// Figure. A figure keeps a private copy, so changing a style later does not
// disturb a figure that already uses it.
public class Style {
    public var name : String
    public var figureWidth : double
    public var figureHeight : double
    public var dpi : Int
    public var figureFace : String
    public var axesFace : String
    public var axesEdge : String
    public var axesLineWidth : double
    public var textColor : String
    public var fontFamily : String
    public var fontKind : String
    public var fontSize : double
    public var titleSize : double
    public var labelSize : double
    public var tickSize : double
    public var legendSize : double
    public var titleWeight : String
    public var labelWeight : String
    public var colorCycle : List[String]
    public var dashCycle : List[String]
    public var markerCycle : List[String]
    public var lineWidth : double
    public var lineStyle : String
    public var markerSize : double
    public var markerEdgeWidth : double
    public var grid : Bool
    public var gridColor : String
    public var gridWidth : double
    public var gridStyle : String
    public var gridAlpha : double
    public var minorGrid : Bool
    public var axisBelow : Bool
    public var spineTop : Bool
    public var spineRight : Bool
    public var spineLeft : Bool
    public var spineBottom : Bool
    public var ticksTop : Bool
    public var ticksRight : Bool
    public var tickDirection : String
    public var majorTickLength : double
    public var minorTickLength : double
    public var tickWidth : double
    public var minorTicks : Bool
    public var legendFrame : Bool
    public var legendFace : String
    public var legendEdge : String
    public var legendFrameAlpha : double
    public var legendPosition : String
    public var legendColumns : Int
    public var left : double
    public var right : double
    public var bottom : double
    public var top : double
    public var wspace : double
    public var hspace : double
    public var titlePad : double
    public var labelPad : double
    public var tickPad : double
    public var barWidth : double
    public var errorCapSize : double
    public var colorbarWidth : double
    public var heatmapGrid : Bool

    new() {
        this.name = "default"
        this.figureWidth = 6.4
        this.figureHeight = 4.8
        this.dpi = 100
        this.figureFace = "white"
        this.axesFace = "white"
        this.axesEdge = "black"
        this.axesLineWidth = 0.8
        this.textColor = "#262626"
        this.fontFamily = "DejaVu Sans, Arial, Helvetica, sans-serif"
        this.fontKind = "sans"
        this.fontSize = 10.0
        this.titleSize = 12.0
        this.labelSize = 10.0
        this.tickSize = 10.0
        this.legendSize = 10.0
        this.titleWeight = "normal"
        this.labelWeight = "normal"
        this.colorCycle =
            [
                "#1f77b4",
                "#ff7f0e",
                "#2ca02c",
                "#d62728",
                "#9467bd",
                "#8c564b",
                "#e377c2",
                "#7f7f7f",
                "#bcbd22",
                "#17becf",
            ]
        this.dashCycle = ["-"]
        this.markerCycle = ["o"]
        this.lineWidth = 1.5
        this.lineStyle = "-"
        this.markerSize = 6.0
        this.markerEdgeWidth = 0.8
        this.grid = false
        this.gridColor = "#b0b0b0"
        this.gridWidth = 0.8
        this.gridStyle = "-"
        this.gridAlpha = 0.6
        this.minorGrid = false
        this.axisBelow = true
        this.spineTop = true
        this.spineRight = true
        this.spineLeft = true
        this.spineBottom = true
        this.ticksTop = false
        this.ticksRight = false
        this.tickDirection = "out"
        this.majorTickLength = 3.5
        this.minorTickLength = 2.0
        this.tickWidth = 0.8
        this.minorTicks = false
        this.legendFrame = true
        this.legendFace = "white"
        this.legendEdge = "#cccccc"
        this.legendFrameAlpha = 0.8
        this.legendPosition = "best"
        this.legendColumns = 1
        this.left = 0.125
        this.right = 0.9
        this.bottom = 0.11
        this.top = 0.88
        this.wspace = 0.2
        this.hspace = 0.15
        this.titlePad = 6.0
        this.labelPad = 5.0
        this.tickPad = 3.5
        this.barWidth = 0.8
        this.errorCapSize = 3.0
        this.colorbarWidth = 10.0
        this.heatmapGrid = false
    }

    new(other : Style) {
        this.name = other.name
        this.figureWidth = other.figureWidth
        this.figureHeight = other.figureHeight
        this.dpi = other.dpi
        this.figureFace = other.figureFace
        this.axesFace = other.axesFace
        this.axesEdge = other.axesEdge
        this.axesLineWidth = other.axesLineWidth
        this.textColor = other.textColor
        this.fontFamily = other.fontFamily
        this.fontKind = other.fontKind
        this.fontSize = other.fontSize
        this.titleSize = other.titleSize
        this.labelSize = other.labelSize
        this.tickSize = other.tickSize
        this.legendSize = other.legendSize
        this.titleWeight = other.titleWeight
        this.labelWeight = other.labelWeight
        this.colorCycle = other.colorCycle
        this.dashCycle = other.dashCycle
        this.markerCycle = other.markerCycle
        this.lineWidth = other.lineWidth
        this.lineStyle = other.lineStyle
        this.markerSize = other.markerSize
        this.markerEdgeWidth = other.markerEdgeWidth
        this.grid = other.grid
        this.gridColor = other.gridColor
        this.gridWidth = other.gridWidth
        this.gridStyle = other.gridStyle
        this.gridAlpha = other.gridAlpha
        this.minorGrid = other.minorGrid
        this.axisBelow = other.axisBelow
        this.spineTop = other.spineTop
        this.spineRight = other.spineRight
        this.spineLeft = other.spineLeft
        this.spineBottom = other.spineBottom
        this.ticksTop = other.ticksTop
        this.ticksRight = other.ticksRight
        this.tickDirection = other.tickDirection
        this.majorTickLength = other.majorTickLength
        this.minorTickLength = other.minorTickLength
        this.tickWidth = other.tickWidth
        this.minorTicks = other.minorTicks
        this.legendFrame = other.legendFrame
        this.legendFace = other.legendFace
        this.legendEdge = other.legendEdge
        this.legendFrameAlpha = other.legendFrameAlpha
        this.legendPosition = other.legendPosition
        this.legendColumns = other.legendColumns
        this.left = other.left
        this.right = other.right
        this.bottom = other.bottom
        this.top = other.top
        this.wspace = other.wspace
        this.hspace = other.hspace
        this.titlePad = other.titlePad
        this.labelPad = other.labelPad
        this.tickPad = other.tickPad
        this.barWidth = other.barWidth
        this.errorCapSize = other.errorCapSize
        this.colorbarWidth = other.colorbarWidth
        this.heatmapGrid = other.heatmapGrid
    }

    public function copy() : Style = Style(this)

    public function isSerif() : Bool = this.fontKind == "serif"
    public function isMono() : Bool = this.fontKind == "mono"

    public function withFontSize(size : double) : Style {
        let next := Style(this)
        next.fontSize = size
        next.labelSize = size
        next.tickSize = size
        next.legendSize = size
        next.titleSize = size + 2.0
        next
    }

    public function withFontFamily(family : String, kind : String) : Style {
        let next := Style(this)
        next.fontFamily = family
        next.fontKind = kind
        next
    }

    public function withColors(colors : List[String]) : Style {
        let next := Style(this)
        next.colorCycle = colors
        next
    }

    public function withFigureSize(width : double, height : double) : Style {
        let next := Style(this)
        next.figureWidth = width
        next.figureHeight = height
        next
    }

    public static function componentNames() : List[String] =
        [
            "default",
            "classic",
            "ggplot",
            "seaborn",
            "seaborn-whitegrid",
            "bmh",
            "dark",
            "fivethirtyeight",
            "grayscale",
            "solarize",
            "minimal",
            "science",
            "ieee",
            "nature",
            "grid",
            "no-latex",
            "scatter",
            "bright",
            "vibrant",
            "muted",
            "high-vis",
            "high-contrast",
            "light",
            "retro",
            "std-colors",
            "notebook",
        ]

    public static function names() : List[String] =
        [
            "default",
            "classic",
            "ggplot",
            "seaborn",
            "seaborn-whitegrid",
            "bmh",
            "dark",
            "fivethirtyeight",
            "grayscale",
            "solarize",
            "minimal",
            "science",
            "science+ieee",
            "science+nature",
            "science+grid",
            "science+no-latex",
            "science+scatter",
            "science+bright",
            "science+vibrant",
            "science+muted",
            "science+high-vis",
            "science+high-contrast",
            "science+light",
            "science+retro",
            "ieee",
            "nature",
            "notebook",
        ]

    public static function isComponent(name : String) : Bool =
        containsText(Style.componentNames(), Style.normalizeName(name))

    // applyComponent applies one named style layer over another. Later layers
    // win, matching matplotlib's style composition.
    public static function applyComponent(base : Style, component : String) : Style {
        let s := Style(base)
        let name := Style.normalizeName(component)
        if name == "classic" {
            s.fontSize = 12.0
            s.titleSize = 14.0
            s.labelSize = 12.0
            s.tickSize = 12.0
            s.legendSize = 12.0
            s.colorCycle =
                ["#0000FF", "#008000", "#FF0000", "#00BFBF", "#BF00BF", "#BFBF00", "#000000"]
            s.lineWidth = 1.0
            s.axesEdge = "black"
            s.axesLineWidth = 1.0
            s.textColor = "black"
            s.grid = false
            s.figureFace = "#bfbfbf"
            s.axesFace = "white"
            s.spineTop = true
            s.spineRight = true
            s.tickDirection = "out"
            s.legendFrame = true
        } else if name == "ggplot" {
            s.axesFace = "#E5E5E5"
            s.figureFace = "white"
            s.axesEdge = "white"
            s.axesLineWidth = 1.0
            s.grid = true
            s.gridColor = "white"
            s.gridWidth = 1.0
            s.gridStyle = "-"
            s.textColor = "#555555"
            s.labelSize = 12.0
            s.titleSize = 14.0
            s.tickSize = 10.0
            s.legendSize = 10.0
            s.colorCycle =
                ["#E24A33", "#348ABD", "#988ED5", "#777777", "#FBC15E", "#8EBA42", "#FFB5B8"]
            s.spineTop = false
            s.spineRight = false
            s.spineLeft = false
            s.spineBottom = false
            s.tickDirection = "out"
            s.fontFamily = "DejaVu Sans, Arial, Helvetica, sans-serif"
            s.fontKind = "sans"
            s.minorTicks = false
        } else if name == "seaborn" {
            s.axesFace = "#EAEAF2"
            s.figureFace = "white"
            s.axesEdge = "white"
            s.axesLineWidth = 0.0
            s.grid = true
            s.gridColor = "white"
            s.gridWidth = 1.0
            s.gridStyle = "-"
            s.textColor = "#262626"
            s.colorCycle =
                [
                    "#4c72b0",
                    "#dd8452",
                    "#55a868",
                    "#c44e52",
                    "#8172b3",
                    "#937860",
                    "#da8bc3",
                    "#8c8c8c",
                    "#ccb974",
                    "#64b5cd",
                ]
            s.spineTop = false
            s.spineRight = false
            s.spineLeft = false
            s.spineBottom = false
            s.tickDirection = "out"
            s.majorTickLength = 0.0
            s.minorTickLength = 0.0
            s.tickWidth = 0.0
            s.legendFrame = false
            s.fontFamily = "DejaVu Sans, Arial, Helvetica, sans-serif"
            s.fontKind = "sans"
        } else if name == "seaborn-whitegrid" {
            s.axesFace = "white"
            s.figureFace = "white"
            s.axesEdge = "#cccccc"
            s.axesLineWidth = 1.0
            s.grid = true
            s.gridColor = "#cccccc"
            s.gridWidth = 1.0
            s.gridStyle = "-"
            s.textColor = "#262626"
            s.colorCycle =
                [
                    "#4c72b0",
                    "#dd8452",
                    "#55a868",
                    "#c44e52",
                    "#8172b3",
                    "#937860",
                    "#da8bc3",
                    "#8c8c8c",
                    "#ccb974",
                    "#64b5cd",
                ]
            s.spineTop = false
            s.spineRight = false
            s.spineLeft = false
            s.spineBottom = false
            s.tickDirection = "out"
            s.majorTickLength = 0.0
            s.minorTickLength = 0.0
            s.tickWidth = 0.0
            s.legendFrame = false
            s.fontFamily = "DejaVu Sans, Arial, Helvetica, sans-serif"
            s.fontKind = "sans"
        } else if name == "bmh" {
            s.lineWidth = 2.0
            s.axesFace = "#eeeeee"
            s.figureFace = "white"
            s.axesEdge = "#bcbcbc"
            s.grid = true
            s.gridColor = "#b2b2b2"
            s.gridStyle = "--"
            s.gridWidth = 0.5
            s.colorCycle =
                [
                    "#348ABD",
                    "#A60628",
                    "#7A68A6",
                    "#467821",
                    "#D55E00",
                    "#CC79A7",
                    "#56B4E9",
                    "#009E73",
                    "#F0E442",
                    "#0072B2",
                ]
            s.titleSize = 14.0
            s.labelSize = 12.0
            s.legendFrame = true
            s.tickDirection = "in"
        } else if name == "dark" {
            s.figureFace = "#000000"
            s.axesFace = "#000000"
            s.axesEdge = "white"
            s.textColor = "white"
            s.gridColor = "white"
            s.spineTop = true
            s.spineRight = true
            s.legendFrame = false
            s.legendFace = "#000000"
            s.legendEdge = "white"
            s.colorCycle =
                [
                    "#8dd3c7",

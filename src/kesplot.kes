    public mut function scatterFrame(
        frame : DataFrame,
        x : String = "",
        y : String = "",
        colorBy : String = "",
        sizeBy : String = "",
        marker : String = "",
        markerSize : double = -1.0,
        alpha : double = 0.8,
        label : String = "",
        cmap : String = "viridis",
    ) : void or
        Error {
            if y == "" { return Error("scatterFrame needs a y column") }
            let xValues := frameXValues(frame, x)?
            let ys := frameNumericValues(frame, y)?
            if x != "" && this.current.xLabel == "" { this.current.xLabel = x }
            if this.current.yLabel == "" { this.current.yLabel = y }
            let count := min(ys.length(), frame.length())
            let positions : List[double] =
                if xValues.categorical then this.current.categories(xValues.labels)
                else takeDoubles(xValues.values, count)
            let index := this.current.colorCount
            let chosenMarker :=
                resolveMarker(this.style, if marker == "" then "auto" else marker, index)
            let sizes : List[double] =
                if sizeBy == "" then []
                else scaledSizes(frameNumericValues(frame, sizeBy)?, 12.0, 120.0)
            if colorBy == "" {
                let chosen := this.nextColor("")
                this.current.addPoints(
                    Points(
                        takeDoubles(positions, count),
                        takeDoubles(ys, count),
                        chosen,
                        [],
                        sizes,
                        chosenMarker,
                        clamp(alpha, 0.0, 1.0),
                        "",
                        this.style.markerEdgeWidth,
                        label,
                    ),
                )
                if label != "" {
                    this.legendMarker(
                        label,
                        chosen,
                        chosenMarker,
                        if markerSize < 0.0 then this.style.markerSize else markerSize,
                        alpha,
                    )
                }
                return
            }
            if !frame.hasColumn(colorBy) { return Error("no column named " + colorBy) }
            let colorSeries := frame.col(colorBy)?
            let kind := colorSeries.dtype()
            if kind == "str" || kind == "bool" {
                let texts := colorSeries.toStrings()
                let categories := uniqueTexts(texts)
                let textArray := texts.toArray()
                let base := this.current.colorCount
                let pointColors : List[String] =
                    [
                        listAt(
                            this.style.colorCycle,
                            (
                                base +
                                    indexOfText(
                                        categories,
                                        textArray[min(i, textArray.length() - 1)],
                                    )
                            ) %
                                max(1, this.style.colorCycle.length()),
                        ) for i in range(count)
                    ]
                this.current.addPoints(
                    Points(
                        takeDoubles(positions, count),
                        takeDoubles(ys, count),
                        "",
                        pointColors,
                        sizes,
                        chosenMarker,
                        clamp(alpha, 0.0, 1.0),
                        "",
                        this.style.markerEdgeWidth,
                        "",
                    ),
                )
                this.current.colorCount = this.current.colorCount + 1
                for (category in categories) {
                    let color :=
                        listAt(
                            this.style.colorCycle,
                            (base + indexOfText(categories, category)) %
                                max(1, this.style.colorCycle.length()),
                        )
                    this.legendMarker(
                        category,
                        color,
                        chosenMarker,
                        if markerSize < 0.0 then this.style.markerSize else markerSize,
                        alpha,
                    )
                }
                if label != "" { this.current.legendTitle = label }
                this.current.legendShown = true
                return
            }
            let values := colorSeries.toFloats()
            let bounds := Bounds()
            for (value in values) { bounds.include(value) }
            let low := if bounds.any then bounds.low else 0.0
            let high := if bounds.any && bounds.high > bounds.low then bounds.high else low + 1.0
            let pointColors : List[String] =
                [
                    colormapColor(
                        cmap,
                        (listAt(values, min(i, values.length() - 1)) - low) / (high - low),
                    ) for i in range(count)
                ]
            this.current.addPoints(
                Points(
                    takeDoubles(positions, count),
                    takeDoubles(ys, count),
                    "",
                    pointColors,
                    sizes,
                    chosenMarker,
                    clamp(alpha, 0.0, 1.0),
                    "",
                    this.style.markerEdgeWidth,
                    label,
                ),
            )
            this.current.colorbar =
                Colorbar(cmap, low, high, if label == "" then colorBy else label)
            this.current.colorbar.visible = true
            this.current.colorCount = this.current.colorCount + 1
        }

    public mut function histFrame(
        frame : DataFrame,
        columns : List[String] = [],
        bins : Int = 10,
        density : Bool = false,
        cumulative : Bool = false,
        histType : String = "bar",
        labels : List[String] = [],
        colors : List[String] = [],
        alpha : double = 0.6,
    ) : void or
        Error {
            let names := frameNumericColumns(frame, columns)?
            let mut i := 0
            for (name in names) {
                let values := frameNumericValues(frame, name)?
                let label := if i < labels.length() then listAt(labels, i) else name
                let color := if i < colors.length() then listAt(colors, i) else ""
                this.hist(
                    values,
                    bins = bins,
                    density = density,
                    cumulative = cumulative,
                    histType = histType,
                    label = label,
                    color = color,
                    alpha = alpha,
                )
                i = i + 1
            }
            if names.length() > 1 { this.current.legendShown = true }
        }

    public mut function histFrame(
        frame : DataFrame,
        column : String,
        bins : Int = 10,
        density : Bool = false,
        cumulative : Bool = false,
        histType : String = "bar",
        labels : List[String] = [],
        colors : List[String] = [],
        alpha : double = 0.6,
    ) : void or
        Error {
            this.histFrame(
                frame,
                [column],
                bins = bins,
                density = density,
                cumulative = cumulative,
                histType = histType,
                labels = labels,
                colors = colors,
                alpha = alpha,
            )
        }

    public mut function boxFrame(
        frame : DataFrame,
        columns : List[String] = [],
        labels : List[String] = [],
        color : String = "",
        width : double = -1.0,
    ) : void or
        Error {
            let names := frameNumericColumns(frame, columns)?
            let mut groups : Array[List[double]] = Array.empty()
            for (name in names) { groups.append(frameNumericValues(frame, name)?) }
            this.boxPlot(
                groups.toList(),
                if labels.length() > 0 then labels else names,
                color = color,
                width = width,
            )
            this.current.legendShown = false
        }

    public mut function heatmapFrame(
        frame : DataFrame,
        columns : List[String] = [],
        cmap : String = "viridis",
        colorbar : Bool = true,
        colorbarLabel : String = "",
    ) : void or
        Error {
            let names := frameNumericColumns(frame, columns)?
            let mut columnsData : Array[List[double]] = Array.empty()
            for (name in names) { columnsData.append(frameNumericValues(frame, name)?) }
            let columnList := columnsData.toList()
            let rows := frame.length()
            if rows == 0 || names.length() == 0 {
                return Error("the frame has no rows or numeric columns")
            }
            let matrix : List[List[double]] =
                [
                    [listAt(listAt(columnList, c), r) for c in range(names.length())] for r in range(
                        rows,
                    )
                ]
            let rowLabels := frame.index.texts()
            this.heatmap(matrix, rowLabels, names, cmap, colorbar, colorbarLabel, false)
        }

    public mut function pieFrame(
        frame : DataFrame,
        values : String,
        labels : String = "",
        colors : List[String] = [],
        startAngle : double = 90.0,
        donut : double = 0.0,
        autoPercent : Bool = false,
    ) : void or
        Error {
            let numbers := frameNumericValues(frame, values)?
            let names : List[String] =
                if labels == "" then frame.index.texts() else frameTextValues(frame, labels)?
            this.pie(
                numbers,
                names,
                colors,
                startAngle,
                [],
                donut,
                autoPercent,
                1.12,
                true,
                "white",
                1.0,
            )
        }


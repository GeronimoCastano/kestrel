                    "#fdb462",
                    "#b3de69",
                    "#bc82bd",
                    "#ccebc4",
                    "#ffed6f",
                ]
        } else if name == "fivethirtyeight" {
            s.lineWidth = 4.0
            s.figureFace = "#f0f0f0"
            s.axesFace = "#f0f0f0"
            s.axesEdge = "#f0f0f0"
            s.axesLineWidth = 3.0
            s.grid = true
            s.gridColor = "#cbcbcb"
            s.gridWidth = 1.0
            s.gridStyle = "-"
            s.colorCycle = ["#008fd5", "#fc4f30", "#e5ae38", "#6d904f", "#8b8b8b", "#810f7c"]
            s.fontSize = 14.0
            s.titleSize = 18.0
            s.labelSize = 14.0
            s.tickSize = 14.0
            s.legendSize = 14.0
            s.spineTop = false
            s.spineRight = false
            s.majorTickLength = 0.0
            s.minorTickLength = 0.0
            s.tickWidth = 0.0
            s.axisBelow = true
        } else if name == "grayscale" {
            s.colorCycle = ["#000000", "#666666", "#999999", "#b3b3b3"]
            s.figureFace = "#bfbfbf"
            s.axesFace = "white"
            s.axesEdge = "black"
            s.textColor = "black"
            s.gridColor = "black"
        } else if name == "solarize" {
            s.figureFace = "#FDF6E3"
            s.axesFace = "#EEE8D5"
            s.axesEdge = "#EEE8D5"
            s.axesLineWidth = 1.0
            s.textColor = "#657B83"
            s.grid = true
            s.gridColor = "#FDF6E3"
            s.gridWidth = 1.0
            s.gridStyle = "-"
            s.colorCycle =
                [
                    "#268BD2",
                    "#2AA198",
                    "#859900",
                    "#B58900",
                    "#CB4B16",
                    "#DC322F",
                    "#D33682",
                    "#6C71C4",
                ]
            s.lineWidth = 2.0
            s.titleSize = 16.0
            s.labelSize = 12.0
            s.tickSize = 12.0
            s.legendSize = 12.0
            s.spineTop = false
            s.spineRight = false
            s.spineLeft = false
            s.spineBottom = false
            s.tickDirection = "out"
        } else if name == "minimal" {
            s.grid = false
            s.spineTop = false
            s.spineRight = false
            s.axesEdge = "#666666"
            s.tickDirection = "out"
            s.legendFrame = false
        } else if name == "science" {
            s.figureWidth = 3.5
            s.figureHeight = 2.625
            s.colorCycle =
                ["#0C5DA5", "#00B945", "#FF9500", "#FF2C00", "#845B97", "#474747", "#9E9E9E"]
            s.fontFamily = "Times New Roman, Times, DejaVu Serif, Georgia, serif"
            s.fontKind = "serif"
            s.fontSize = 10.0
            s.titleSize = 10.0
            s.labelSize = 10.0
            s.tickSize = 10.0
            s.legendSize = 9.0
            s.axesLineWidth = 0.5
            s.lineWidth = 1.0
            s.grid = false
            s.gridWidth = 0.5
            s.legendFrame = false
            s.spineTop = true
            s.spineRight = true
            s.tickDirection = "in"
            s.majorTickLength = 3.0
            s.minorTickLength = 1.5
            s.tickWidth = 0.5
            s.minorTicks = true
            s.ticksTop = true
            s.ticksRight = true
            s.markerSize = 4.0
            s.errorCapSize = 2.5
            s.axesFace = "white"
            s.figureFace = "white"
            s.textColor = "black"
            s.titleWeight = "normal"
        } else if name == "ieee" {
            s.figureWidth = 3.3
            s.figureHeight = 2.5
            s.colorCycle = ["#000000", "#FF0000", "#0000FF", "#008000"]
            s.dashCycle = ["-", "--", ":", "-."]
            s.fontSize = 8.0
            s.titleSize = 9.0
            s.labelSize = 8.0
            s.tickSize = 8.0
            s.legendSize = 8.0
            s.fontFamily = "Times New Roman, Times, DejaVu Serif, Georgia, serif"
            s.fontKind = "serif"
            s.spineTop = true
            s.spineRight = true
            s.tickDirection = "in"
            s.majorTickLength = 3.0
            s.minorTickLength = 1.5
            s.tickWidth = 0.5
            s.minorTicks = true
            s.ticksTop = true
            s.ticksRight = true
            s.markerSize = 4.0
        } else if name == "nature" {
            s.figureWidth = 3.3
            s.figureHeight = 2.5
            s.fontSize = 7.0
            s.titleSize = 8.0
            s.labelSize = 7.0
            s.tickSize = 7.0
            s.legendSize = 7.0
            s.fontFamily = "DejaVu Sans, Arial, Helvetica, sans-serif"
            s.fontKind = "sans"
            s.axesLineWidth = 0.5
            s.gridWidth = 0.5
            s.lineWidth = 1.0
            s.markerSize = 3.0
        } else if name == "grid" {
            s.grid = true
            s.axisBelow = true
            s.gridStyle = "--"
            s.gridColor = "#000000"
            s.gridAlpha = 0.5
            s.gridWidth = 0.5
            s.legendFrame = true
            s.legendFrameAlpha = 1.0
        } else if name == "no-latex" {
            s.fontFamily = "STIX Two Text, STIXGeneral, DejaVu Serif, Georgia, serif"
            s.fontKind = "serif"
        } else if name == "scatter" {
            s.markerCycle = ["o", "s", "^", "v", "<", ">", "D"]
            s.markerSize = 3.0
            s.lineStyle = "none"
            s.lineWidth = 1.0
        } else if name == "bright" {
            s.colorCycle =
                ["#4477AA", "#EE6677", "#228833", "#CCBB44", "#66CCEE", "#AA3377", "#BBBBBB"]
        } else if name == "vibrant" {
            s.colorCycle =
                ["#EE7733", "#0077BB", "#33BBEE", "#EE3377", "#CC3311", "#009988", "#BBBBBB"]
        } else if name == "muted" {
            s.colorCycle =
                [
                    "#CC6677",
                    "#332288",
                    "#DDCC77",
                    "#117733",
                    "#88CCEE",
                    "#882255",
                    "#44AA99",
                    "#999933",
                    "#AA4499",
                    "#DDDDDD",
                ]
        } else if name == "high-vis" {
            s.colorCycle = ["#0d49fb", "#e6091c", "#26eb47", "#8936df", "#fec32d", "#25d7fd"]
            s.dashCycle = ["-", "--", "-.", ":", "-", "--"]
        } else if name == "high-contrast" {
            s.colorCycle = ["#004488", "#DDAA33", "#BB5566"]
        } else if name == "light" {
            s.colorCycle =
                [
                    "#77AADD",
                    "#EE8866",
                    "#EEDD88",
                    "#FFAABB",
                    "#99DDFF",
                    "#44BB99",
                    "#BBCC33",
                    "#AAAA00",
                    "#DDDDDD",
                ]
        } else if name == "retro" {
            s.colorCycle = ["#4165c0", "#e770a2", "#5ac3be", "#696969", "#f79a1e", "#ba7dcd"]
        } else if name == "std-colors" {
            s.colorCycle =
                ["#0C5DA5", "#00B945", "#FF9500", "#FF2C00", "#845B97", "#474747", "#9E9E9E"]
        } else if name == "notebook" {
            s.figureWidth = 6.0
            s.figureHeight = 4.0
            s.fontSize = 11.0
            s.titleSize = 13.0
            s.labelSize = 11.0
            s.tickSize = 10.0
            s.legendSize = 10.0
        }
        s
    }

    public static function normalizeName(name : String) : String =
        name.trim().toLower().replace("_", "-").replace(" ", "-")

    // byName builds a style from one or more layers separated by '+'.
    public static function byName(name : String) : Style or Error {
        let clean := Style.normalizeName(name)
        if clean == "" { return Error("plot style name is empty") }
        let parts := clean.split("+")
        let mut result := Style()
        for (part in parts) {
            let item := Style.normalizeName(part)
            if !Style.isComponent(item) {
                return Error("unknown plot style: " + part)
            }
            result = Style.applyComponent(result, item)
        }
        result.name = name
        result
    }

    public static function isKnown(name : String) : Bool =
        match Style.byName(name) { s => true, _ => false }

    public static function named(name : String) : Style =
        match Style.byName(name) { s => s, _ => Style() }

    public static function standard() : Style = Style()
    public static function classic() : Style = Style.named("classic")
    public static function ggplot() : Style = Style.named("ggplot")
    public static function seaborn() : Style = Style.named("seaborn")
    public static function seabornWhitegrid() : Style = Style.named("seaborn-whitegrid")
    public static function bmh() : Style = Style.named("bmh")
    public static function dark() : Style = Style.named("dark")
    public static function fivethirtyeight() : Style = Style.named("fivethirtyeight")
    public static function grayscale() : Style = Style.named("grayscale")
    public static function solarize() : Style = Style.named("solarize")
    public static function minimal() : Style = Style.named("minimal")
    public static function science() : Style = Style.named("science")
    public static function ieee() : Style = Style.named("ieee")
    public static function nature() : Style = Style.named("nature")
    public static function scienceIeee() : Style = Style.named("science+ieee")
    public static function scienceNature() : Style = Style.named("science+nature")
    public static function scienceGrid() : Style = Style.named("science+grid")
    public static function scienceScatter() : Style = Style.named("science+scatter")
    public static function scienceBright() : Style = Style.named("science+bright")
    public static function scienceVibrant() : Style = Style.named("science+vibrant")
    public static function scienceMuted() : Style = Style.named("science+muted")
    public static function scienceHighVis() : Style = Style.named("science+high-vis")
    public static function scienceHighContrast() : Style = Style.named("science+high-contrast")
    public static function scienceLight() : Style = Style.named("science+light")
    public static function scienceRetro() : Style = Style.named("science+retro")
    public static function notebook() : Style = Style.named("notebook")
}

public function version() : String = "kesplot 0.2"

// Reports the external tools the raster, PDF and TeX paths need.
public function backendReport() : String with Effects {
    let mut out := "kesplot backends:\n"
    for (tool in ["latex", "dvisvgm", "rsvg-convert", "magick"]) {
        let available := shellStatus("command -v " + shellQuote(tool) + " >/dev/null 2>&1") == 0
        out = out + "  " + tool + ": " + (if available then "available" else "missing") + "\n"
    }
    out
}

// ---------------------------------------------------------------- SVG output

class Svg {
    private var parts : Array[String]

    new() {
        this.parts = Array.empty()
    }

    public mut function add(text : String) : void {
        this.parts.append(text)
    }

    public function text() : String = this.parts.toList().join("")
}

function element(name : String, attributes : List[(String, String)], body : String) : String {
    let mut open := "<" + name
    for ((key, value) in attributes) {
        open = open + " " + key + "=\"" + value + "\""
    }
    if body == "" then open + "/>\n" else open + ">" + body + "</" + name + ">\n"
}

function dashArray(dash : String, width : double) : String {
    let unit := if width <= 0.0 then 1.0 else width
    if dash == "--" ||
            dash == "dashed" then fmt(4.0 * max(unit, 0.8)) + "," + fmt(2.6 * max(unit, 0.8))
        else if dash == "-." ||
            dash ==
                "dashdot" then fmt(5.0 * max(unit, 0.8)) +
                    "," + fmt(2.2 * max(unit, 0.8)) + ",1," + fmt(2.2 * max(unit, 0.8))
        else if dash == ":" ||
            dash == "dotted" then fmt(0.9 * max(unit, 0.7)) + "," + fmt(2.4 * max(unit, 0.8))
        else if dash == "none" || dash == " " || dash == "" then "" else ""
}

function opacityAttribute(alpha : double) : String {
    if alpha >= 0.999 then "" else " fill-opacity=\"" + fmt(clamp(alpha, 0.0, 1.0)) + "\""
}

function strokeOpacityAttribute(alpha : double) : String {
    if alpha >= 0.999 then "" else " stroke-opacity=\"" + fmt(clamp(alpha, 0.0, 1.0)) + "\""
}

function strokeAttributes(color : String, width : double, dash : String, alpha : double) : String {
    if color == "" || color == "none" || width <= 0.0 { return " stroke=\"none\"" }
    let mut text := " stroke=\"" + color + "\" stroke-width=\"" + fmt(width) + "\""
    let pattern := dashArray(dash, width)
    if pattern != "" { text = text + " stroke-dasharray=\"" + pattern + "\"" }
    text + strokeOpacityAttribute(alpha)
}

function fillAttributes(color : String, alpha : double) : String {
    if color == "" || color == "none" { return " fill=\"none\"" }
    " fill=\"" + color + "\"" + opacityAttribute(alpha)
}


        this.align = align
        this.rotation = rotation
        this.weight = weight
        this.coordinate = coordinate
        this.family = family
        this.alpha = alpha
    }

    public function copy() : TextMark =
        TextMark(
            this.x,
            this.y,
            this.content,
            this.color,
            this.size,
            this.align,
            this.rotation,
            this.weight,
            this.coordinate,
            this.family,
            this.alpha,
        )
}

class LegendItem {
    public final label : String
    public final color : String
    public final edge : String
    public final marker : String
    public final dash : String
    public final lineWidth : double
    public final markerSize : double
    public final kind : String
    public final alpha : double

    new(
        label : String,
        color : String,
        edge : String,
        marker : String,
        dash : String,
        lineWidth : double,
        markerSize : double,
        kind : String,
        alpha : double,
    ) {
        this.label = label
        this.color = color
        this.edge = edge
        this.marker = marker
        this.dash = dash
        this.lineWidth = lineWidth
        this.markerSize = markerSize
        this.kind = kind
        this.alpha = alpha
    }

    public function copy() : LegendItem =
        LegendItem(
            this.label,
            this.color,
            this.edge,
            this.marker,
            this.dash,
            this.lineWidth,
            this.markerSize,
            this.kind,
            this.alpha,
        )
}

class Colorbar {
    public var visible : Bool
    public var cmap : String
    public var low : double
    public var high : double
    public var label : String

    new() {
        this.visible = false
        this.cmap = "viridis"
        this.low = 0.0
        this.high = 1.0
        this.label = ""
    }

    new(cmap : String, low : double, high : double, label : String) {
        this.visible = true
        this.cmap = cmap
        this.low = low
        this.high = high
        this.label = label
    }

    public function copy() : Colorbar {
        let next := Colorbar()
        next.visible = this.visible
        next.cmap = this.cmap
        next.low = this.low
        next.high = this.high
        next.label = this.label
        next
    }
}

// ---------------------------------------------------------------- axes geometry

class Bounds {
    public var low : double
    public var high : double
    public var any : Bool

    new() {
        this.low = 0.0
        this.high = 0.0
        this.any = false
    }

    public mut function include(x : double) : void {
        if !finite(x) { return }
        if !this.any {
            this.low = x
            this.high = x
            this.any = true
        } else if x < this.low {
            this.low = x
        } else if x > this.high {
            this.high = x
        }
    }
}

class AxisTicks {
    public final positions : List[double]
    public final labels : List[String]
    public final minor : List[double]
    public final step : double
    public final logScale : Bool

    new(
        positions : List[double],
        labels : List[String],
        minor : List[double],
        step : double,
        logScale : Bool,
    ) {
        this.positions = positions
        this.labels = labels
        this.minor = minor
        this.step = step
        this.logScale = logScale
    }
}

class Transform {
    public final left : double
    public final right : double
    public final top : double
    public final bottom : double
    public final xLow : double
    public final xHigh : double
    public final yLow : double
    public final yHigh : double
    public final xLog : Bool
    public final yLog : Bool

    new(
        left : double,
        right : double,
        top : double,
        bottom : double,
        xLow : double,
        xHigh : double,
        yLow : double,
        yHigh : double,
        xLog : Bool,
        yLog : Bool,
    ) {
        this.left = left
        this.right = right
        this.top = top
        this.bottom = bottom
        this.xLow = if xLog then log10(xLow) else xLow
        this.xHigh = if xLog then log10(xHigh) else xHigh
        this.yLow = if yLog then log10(yLow) else yLow
        this.yHigh = if yLog then log10(yHigh) else yHigh
        this.xLog = xLog
        this.yLog = yLog
    }

    public function px(x : double) : double {
        if this.xLog && x <= 0.0 { return nanValue() }
        let value := if this.xLog then log10(x) else x
        this.left + (value - this.xLow) / (this.xHigh - this.xLow) * (this.right - this.left)
    }

    public function py(y : double) : double {
        if this.yLog && y <= 0.0 { return nanValue() }
        let value := if this.yLog then log10(y) else y
        this.bottom - (value - this.yLow) / (this.yHigh - this.yLow) * (this.bottom - this.top)
    }
}

// ---------------------------------------------------------------- axes

class Axes {
    public var title : String
    public var xLabel : String
    public var yLabel : String
    public var xScale : String
    public var yScale : String
    public var xInverted : Bool
    public var yInverted : Bool
    public var xMin : double
    public var xMax : double
    public var yMin : double
    public var yMax : double
    public var xTickPositions : List[double]
    public var xTickLabels : List[String]
    public var yTickPositions : List[double]
    public var yTickLabels : List[String]
    public var xTickRotation : double
    public var xCategories : Array[String]
    public var yCategories : Array[String]
    public var gridX : Int
    public var gridY : Int
    public var minorX : Int
    public var minorY : Int
    public var legendShown : Bool
    public var legendTitle : String
    public var legendPosition : String
    public var legendColumns : Int
    public var legendFrame : Int
    public var aspect : String
    public var showTop : Bool
    public var showRight : Bool
    public var showLeft : Bool
    public var showBottom : Bool
    public var pieMode : Bool
    public var colorbar : Colorbar
    public var colorCount : Int
    public var lines : Array[Line2D]
    public var points : Array[Points]
    public var bars : Array[Bars]
    public var bands : Array[Band]
    public var errors : Array[ErrorBars]
    public var boxes : Array[BoxPlot]
    public var guides : Array[Guide]
    public var contours : Array[Contour]
    public var heatmaps : Array[Heatmap]
    public var pies : Array[Pie]
    public var labels : Array[TextMark]
    public var annotations : Array[Annotation]
    public var legendItems : Array[LegendItem]

    new() {
        this.title = ""
        this.xLabel = ""
        this.yLabel = ""
        this.xScale = "linear"
        this.yScale = "linear"
        this.xInverted = false
        this.yInverted = false
        this.xMin = nanValue()
        this.xMax = nanValue()
        this.yMin = nanValue()
        this.yMax = nanValue()
        this.xTickPositions = []
        this.xTickLabels = []
        this.yTickPositions = []
        this.yTickLabels = []
        this.xTickRotation = 999.0
        this.xCategories = Array.empty()
        this.yCategories = Array.empty()
        this.gridX = -1
        this.gridY = -1
        this.minorX = -1
        this.minorY = -1
        this.legendShown = false
        this.legendTitle = ""
        this.legendPosition = ""
        this.legendColumns = 0
        this.legendFrame = -1
        this.aspect = "auto"
        this.showTop = true
        this.showRight = true
        this.showLeft = true
        this.showBottom = true
        this.pieMode = false
        this.colorbar = Colorbar()
        this.colorCount = 0
        this.lines = Array.empty()
        this.points = Array.empty()
        this.bars = Array.empty()
        this.bands = Array.empty()
        this.errors = Array.empty()
        this.boxes = Array.empty()
        this.guides = Array.empty()
        this.contours = Array.empty()
        this.heatmaps = Array.empty()
        this.pies = Array.empty()
        this.labels = Array.empty()
        this.annotations = Array.empty()
        this.legendItems = Array.empty()
    }

    new(other : Axes) {
        this.title = other.title
        this.xLabel = other.xLabel
        this.yLabel = other.yLabel
        this.xScale = other.xScale
        this.yScale = other.yScale
        this.xInverted = other.xInverted
        this.yInverted = other.yInverted
        this.xMin = other.xMin
        this.xMax = other.xMax
        this.yMin = other.yMin
        this.yMax = other.yMax
        this.xTickPositions = other.xTickPositions
        this.xTickLabels = other.xTickLabels
        this.yTickPositions = other.yTickPositions
        this.yTickLabels = other.yTickLabels
        this.xTickRotation = other.xTickRotation
        this.xCategories = copyStrings(other.xCategories)
        this.yCategories = copyStrings(other.yCategories)
        this.gridX = other.gridX
        this.gridY = other.gridY
        this.minorX = other.minorX
        this.minorY = other.minorY
        this.legendShown = other.legendShown
        this.legendTitle = other.legendTitle
        this.legendPosition = other.legendPosition
        this.legendColumns = other.legendColumns
        this.legendFrame = other.legendFrame
        this.aspect = other.aspect
        this.showTop = other.showTop
        this.showRight = other.showRight
        this.showLeft = other.showLeft
        this.showBottom = other.showBottom
        this.pieMode = other.pieMode
        this.colorbar = other.colorbar.copy()
        this.colorCount = other.colorCount
        this.lines = copyLines(other.lines)
        this.points = copyPointSets(other.points)
        this.bars = copyBars(other.bars)
        this.bands = copyBands(other.bands)
        this.errors = copyErrors(other.errors)
        this.boxes = copyBoxes(other.boxes)
        this.guides = copyGuides(other.guides)
        this.contours = copyContours(other.contours)
        this.heatmaps = copyHeatmaps(other.heatmaps)
        this.pies = copyPies(other.pies)
        this.labels = copyTextMarks(other.labels)
        this.annotations = copyAnnotations(other.annotations)
        this.legendItems = copyLegendItems(other.legendItems)
    }

    public function copy() : Axes = Axes(this)

    public mut function addLine(move line : Line2D) : void { this.lines.append(line) }
    public mut function addPoints(move points : Points) : void { this.points.append(points) }
    public mut function addBars(move bars : Bars) : void { this.bars.append(bars) }
    public mut function addBand(move band : Band) : void { this.bands.append(band) }
    public mut function addErrorBars(move errors : ErrorBars) : void { this.errors.append(errors) }
    public mut function addBox(move box : BoxPlot) : void { this.boxes.append(box) }
    public mut function addGuide(move guide : Guide) : void { this.guides.append(guide) }
    public mut function addContour(move contour : Contour) : void { this.contours.append(contour) }
    public mut function addHeatmap(move map : Heatmap) : void { this.heatmaps.append(map) }
    public mut function addPie(move pie : Pie) : void { this.pies.append(pie) }
    public mut function addText(move text : TextMark) : void { this.labels.append(text) }
    public mut function addAnnotation(move annotation : Annotation) : void {
        this.annotations.append(annotation)
    }
    public mut function addLegendItem(move item : LegendItem) : void {
        this.legendItems.append(item)
    }

    // categories maps labels to stable integer positions, adding new labels.
    public mut function categories(labels : List[String]) : List[double] {
        let mut out : Array[double] = Array.empty()
        for (label in labels) {
            let mut found := -1
            for (i in range(this.xCategories.length())) {
                if this.xCategories[i] == label {
                    found = i
                    break
                }
            }
            if found < 0 {
                this.xCategories.append(label)
                found = this.xCategories.length() - 1
            }
            out.append(found.toDouble())
        }
        out.toList()
    }

    public mut function categoriesY(labels : List[String]) : List[double] {
        let mut out : Array[double] = Array.empty()
        for (label in labels) {
            let mut found := -1
            for (i in range(this.yCategories.length())) {
                if this.yCategories[i] == label {
                    found = i
                    break
                }
            }
            if found < 0 {
                this.yCategories.append(label)
                found = this.yCategories.length() - 1
            }
            out.append(found.toDouble())
        }
        out.toList()
    }
}

// ---------------------------------------------------------------- copy helpers

function copyStrings(items : Array[String]) : Array[String] {
    let mut out : Array[String] = Array.empty()
    for (item in items) { out.append(item) }
    out
}


    public mut function stackPlot(
        x : List[double],
        series : List[List[double]],
        labels : List[String] = [],
        colors : List[String] = [],
        alpha : double = 0.75,
        lineWidth : double = 0.8,
    ) : void {
        let count := x.length()
        let running : Array[double] = Array(count, 0.0)
        let xa := x.toArray()
        let mut seriesIndex := 0
        for (values in series) {
            let va := values.toArray()
            let lower : List[double] = [running[i] for i in range(count)]
            let upper : List[double] =
                [
                    running[i] +
                        (if i < va.length() && finite(va[i]) then va[i] else 0.0) for i in range(
                            count,
                        )
                ]
            let label := if seriesIndex < labels.length() then listAt(labels, seriesIndex) else ""
            let color := if seriesIndex < colors.length() then listAt(colors, seriesIndex) else ""
            let chosen := resolveColor(this.style, color, this.current.colorCount)
            this.addBandValues(x, lower, upper, [], label, color, alpha, chosen, lineWidth, "-")
            for (i in range(count)) {
                running[i] = running[i] + (if i < va.length() && finite(va[i]) then va[i] else 0.0)
            }
            seriesIndex = seriesIndex + 1
        }
    }

    public mut function stackPlotFrame(
        frame : DataFrame,
        x : String = "",
        y : List[String] = [],
        labels : List[String] = [],
        colors : List[String] = [],
        alpha : double = 0.75,
    ) : void or
        Error {
            let xValues := frameXValues(frame, x)?
            let names := frameNumericColumns(frame, y)?
            let positions : List[double] =
                if xValues.categorical then this.current.categories(xValues.labels)
                else xValues.values
            let mut data : Array[List[double]] = Array.empty()
            for (name in names) { data.append(frameNumericValues(frame, name)?) }
            this.stackPlot(
                positions,
                data.toList(),
                if labels.length() > 0 then labels else names,
                colors,
                alpha,
                0.8,
            )
            if names.length() > 1 { this.current.legendShown = true }
        }


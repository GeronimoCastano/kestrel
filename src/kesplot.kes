function isHexDigit(ch : String) : Bool =
    isDigits(ch) || "abcdef".contains(ch) || "ABCDEF".contains(ch)

function allHex(text : String) : Bool {
    if text.length() == 0 { return false }
    for (ch in text) {
        if !isHexDigit(ch) { return false }
    }
    true
}

// normalizeColor accepts matplotlib color spellings and CSS names. An empty
// color is resolved later against the style's cycle.
function normalizeColor(color : String) : String {
    let text := color.trim()
    if text == "" { return "" }
    let named := textIndex(COLOR_NAMES, text.toLower())
    if named >= 0 { return listAt(COLOR_VALUES, named) }
    if text.length() == 1 {
        let short := textIndex(COLOR_NAMES, text)
        if short >= 0 { return listAt(COLOR_VALUES, short) }
    }
    if text.startsWith("#") {
        return "#" + sliceText(text, 1, text.length())
    }
    if allHex(text) && (text.length() == 6 || text.length() == 3) {
        return "#" + text
    }
    // "0.5" style grayscale accepted by matplotlib.
    if text.length() > 0 &&
        isDigits(sliceText(text, 0, 1)) && (text.contains(".") || text.length() == 1) {
            let value := match parseDouble(text) { v => v, _ => -1.0 }
            if value >= 0.0 && value <= 1.0 {
                let level := whole(value * 255.0)
                return "rgb(" + level.text() + "," + level.text() + "," + level.text() + ")"
            }
        }
    text
}

function hexDigit(ch : String) : Int {
    let digits := "0123456789abcdef"
    let mut i := 0
    for (c in digits) {
        if c == ch.toLower() { return i }
        i = i + 1
    }
    0
}

function hexNumber(text : String) : Int {
    let mut value := 0
    for (ch in text) {
        value = value * 16 + hexDigit(ch)
    }
    value
}

function hexValue(color : String) : (Int, Int, Int) {
    let text := if color.startsWith("#") then sliceText(color, 1, color.length()) else color
    if text.length() == 3 {
        let r := hexNumber(sliceText(text, 0, 1) + sliceText(text, 0, 1))
        let g := hexNumber(sliceText(text, 1, 2) + sliceText(text, 1, 2))
        let b := hexNumber(sliceText(text, 2, 3) + sliceText(text, 2, 3))
        (r, g, b)
    } else if text.length() == 6 {
        let r := hexNumber(sliceText(text, 0, 2))
        let g := hexNumber(sliceText(text, 2, 4))
        let b := hexNumber(sliceText(text, 4, 6))
        (r, g, b)
    } else {
        (0, 0, 0)
    }
}

function hexText(value : Int) : String {
    let digits := "0123456789abcdef"
    let n := clampInt(value, 0, 255)
    let high := digits[n / 16]
    let low := digits[n % 16]
    high + low
}

function mixColor(first : String, second : String, amount : double) : String {
    let (r1, g1, b1) := hexValue(first)
    let (r2, g2, b2) := hexValue(second)
    let t := clamp(amount, 0.0, 1.0)
    let r := whole((r1.toDouble() + (r2 - r1).toDouble() * t).round())
    let g := whole((g1.toDouble() + (g2 - g1).toDouble() * t).round())
    let b := whole((b1.toDouble() + (b2 - b1).toDouble() * t).round())
    "#" + hexText(r) + hexText(g) + hexText(b)
}


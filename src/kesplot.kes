    // ---- bands and areas

    public mut function addBandValues(
        xs : List[double],
        lower : List[double],
        upper : List[double],
        xLabels : List[String],
        label : String,
        color : String,
        alpha : double,
        edgeColor : String,
        edgeWidth : double,
        lineStyle : String,
    ) : void {
        let count := min(xs.length(), min(lower.length(), upper.length()))
        let valuesX :=
            if xLabels.length() > 0 then this.current.categories(xLabels)
            else takeDoubles(xs, count)
        let index := this.current.colorCount
        let chosen := this.nextColor(color)
        this.current.addBand(
            Band(
                valuesX,
                takeDoubles(lower, count),
                takeDoubles(upper, count),
                chosen,
                clamp(alpha, 0.0, 1.0),
                normalizeColor(edgeColor),
                max(0.0, edgeWidth),
                lineStyle,
                label,
            ),
        )
        if label != "" { this.legendPatch(label, chosen, alpha) }
    }


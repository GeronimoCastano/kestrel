    public mut function plotSeries(
        series : Series,
        label : String = "",
        color : String = "",
        lineWidth : double = -1.0,
        lineStyle : String = "",
        marker : String = "",
        markerSize : double = -1.0,
        alpha : double = 1.0,
        step : String = "",
    ) : void {
        let x := indexValues(series)
        if series.indexName != "" && this.current.xLabel == "" {
            this.current.xLabel = series.indexName
        }
        let name := if label == "" then seriesLabel(series) else label
        if x.categorical {
            this.addLineValues(
                [],
                series.toFloats(),
                x.labels,
                name,
                color,
                lineWidth,
                lineStyle,
                marker,
                markerSize,
                alpha,
                step,
            )
        } else {
            this.addLineValues(
                x.values,
                series.toFloats(),
                [],
                name,
                color,
                lineWidth,
                lineStyle,
                marker,
                markerSize,
                alpha,
                step,
            )
        }
    }

    // ---- scatter plots

    public mut function addScatterValues(
        xs : List[double],
        ys : List[double],
        xLabels : List[String],
        colors : List[String],
        sizes : List[double],
        label : String,
        color : String,
        marker : String,
        markerSize : double,
        alpha : double,
        edgeColor : String,
        edgeWidth : double,
    ) : void {
        let count := min(xs.length(), ys.length())
        let valuesX :=
            if xLabels.length() > 0 then this.current.categories(xLabels)
            else takeDoubles(xs, count)
        let index := this.current.colorCount
        let chosen := this.nextColor(color)
        let chosenMarker :=
            resolveMarker(this.style, if marker == "" then "auto" else marker, index)
        let size := if markerSize < 0.0 then this.style.markerSize else markerSize
        this.current.addPoints(
            Points(
                valuesX,
                takeDoubles(ys, min(valuesX.length(), ys.length())),
                chosen,
                colors,
                sizes,
                chosenMarker,
                clamp(alpha, 0.0, 1.0),
                edgeColor,
                max(0.0, edgeWidth),
                label,
            ),
        )
        if label != "" { this.legendMarker(label, chosen, chosenMarker, size, alpha) }
    }


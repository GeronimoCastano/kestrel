        let index := this.current.colorCount
        let chosen := this.nextColor(color)
        let actualWidth := if width < 0.0 then this.style.lineWidth else width
        let dash := resolveDash(this.style, lineStyle, index)
        this.current.addGuide(
            Guide("v", x, chosen, actualWidth, dash, clamp(alpha, 0.0, 1.0), label),
        )
        if label != "" { this.legendLine(label, chosen, dash, "", actualWidth, 0.0, alpha) }
    }


    // ---- error bars and stems

    public mut function plotErrorValues(
        xs : List[double],
        ys : List[double],
        yLow : List[double],
        yHigh : List[double],
        xLow : List[double],
        xHigh : List[double],
        xLabels : List[String],
        label : String,
        color : String,
        width : double,
        capSize : double,
        marker : String,
        markerSize : double,
        alpha : double,
    ) : void {
        let count := min(xs.length(), ys.length())
        let valuesX :=
            if xLabels.length() > 0 then this.current.categories(xLabels)
            else takeDoubles(xs, count)
        let index := this.current.colorCount
        let chosen := this.nextColor(color)
        let chosenMarker := resolveMarker(this.style, if marker == "" then "o" else marker, index)
        let chosenWidth := if width < 0.0 then this.style.lineWidth else width
        let size := if markerSize < 0.0 then this.style.markerSize else markerSize
        let caps := if capSize < 0.0 then this.style.errorCapSize else capSize
        this.current.addErrorBars(
            ErrorBars(
                valuesX,
                takeDoubles(ys, min(valuesX.length(), ys.length())),
                yLow,
                yHigh,
                xLow,
                xHigh,
                chosen,
                chosenWidth,
                caps,
                chosenMarker,
                size,
                clamp(alpha, 0.0, 1.0),
                label,
            ),
        )
        if label != "" {
            this.current.addLegendItem(
                LegendItem(
                    label,
                    chosen,
                    chosen,
                    chosenMarker,
                    "-",
                    chosenWidth,
                    size,
                    "error",
                    alpha,
                ),
            )
        }
    }


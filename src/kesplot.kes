    // ---- bars

    public mut function addBarsValues(
        positions : List[double],
        heights : List[double],
        bases : List[double],
        offset : double,
        width : double,
        horizontal : Bool,
        label : String,
        color : String,
        alpha : double,
        edgeColor : String,
        edgeWidth : double,
    ) : void {
        let count := min(positions.length(), heights.length())
        let pa := positions.toArray()
        let ha := heights.toArray()
        let moved : List[double] = [pa[i] + offset for i in range(min(count, pa.length()))]
        let widths : List[double] =
            [
                if width < 0.0 then this.style.barWidth
                    else width for i in range(min(count, ha.length()))
            ]
        let chosen := this.nextColor(color)
        this.current.addBars(
            Bars(
                moved,
                takeDoubles(heights, count),
                bases,
                widths,
                chosen,
                [],
                normalizeColor(edgeColor),
                max(0.0, edgeWidth),
                clamp(alpha, 0.0, 1.0),
                horizontal,
                label,
            ),
        )
        if label != "" { this.legendPatch(label, chosen, alpha) }
    }

    public mut function bar(
        labels : List[String],
        values : List[double],
        width : double = -1.0,
        label : String = "",
        color : String = "",
        alpha : double = 1.0,
        edgeColor : String = "",
        edgeWidth : double = 0.0,
        offset : double = 0.0,
    ) : void {
        let positions := this.current.categories(labels)
        let bases := [0.0 for i in range(values.length())]
        this.addBarsValues(
            positions,
            values,
            bases,
            offset,
            if width < 0.0 then this.style.barWidth else width,
            false,
            label,
            color,
            alpha,
            edgeColor,
            edgeWidth,
        )
    }


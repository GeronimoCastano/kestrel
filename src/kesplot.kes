        )
    }

    public mut function step(
        x : List[double],
        y : List[double],
        where : String = "pre",
        label : String = "",
        color : String = "",
        lineWidth : double = -1.0,
        lineStyle : String = "",
        marker : String = "",
        markerSize : double = -1.0,
        alpha : double = 1.0,
    ) : void {
        this.plot(
            x,
            y,
            label = label,
            color = color,
            lineWidth = lineWidth,
            lineStyle = lineStyle,
            marker = marker,
            markerSize = markerSize,
            alpha = alpha,
            step = where,
        )
    }

    public mut function step(
        x : List[Int],
        y : List[double],
        where : String = "pre",
        label : String = "",
        color : String = "",
        lineWidth : double = -1.0,
        lineStyle : String = "",
        marker : String = "",
        markerSize : double = -1.0,
        alpha : double = 1.0,
    ) : void {
        this.plot(
            x,

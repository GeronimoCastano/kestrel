    public mut function stem(
        x : List[double],
        y : List[double],
        base : double = 0.0,
        label : String = "",
        color : String = "",
        width : double = -1.0,
        marker : String = "",
        markerSize : double = -1.0,
        alpha : double = 1.0,
    ) : void {
        let xs := x.toArray()
        let ys := y.toArray()
        let count := min(xs.length(), ys.length())
        let low : List[double] = [if ys[i] >= base then 0.0 else base - ys[i] for i in range(count)]
        let high : List[double] =
            [if ys[i] >= base then ys[i] - base else 0.0 for i in range(count)]
        this.plotErrorValues(
            takeDoubles(x, count),
            y,
            low,
            high,
            [],
            [],
            [],
            label,
            color,
            width,
            0.0,
            if marker == "" then "o" else marker,
            markerSize,
            alpha,
        )
    }

    public mut function stem(
        x : List[Int],
        y : List[double],
        base : double = 0.0,
        label : String = "",
        color : String = "",
        width : double = -1.0,
        marker : String = "",
        markerSize : double = -1.0,
        alpha : double = 1.0,
    ) : void {
        this.stem(
            [v.toDouble() for v in x],
            y,
            base = base,
            label = label,
            color = color,
            width = width,
            marker = marker,
            markerSize = markerSize,
            alpha = alpha,
        )
    }

    // ---- histograms

    mut function addHistogram(
        values : List[double],
        edges : List[double],
        density : Bool,
        cumulative : Bool,
        histType : String,
        label : String,
        color : String,
        alpha : double,
        edgeColor : String,
        edgeWidth : double,
    ) : void {
        let clean := validValues(values)
        if clean.length() == 0 || edges.length() < 2 { return }
        let edgeArray := edges.toArray()
        let bins := edgeArray.length() - 1
        let counts : Array[double] = Array(bins, 0.0)
        let total := clean.length().toDouble()
        for (value in clean) {
            let mut placed := -1
            for (i in range(bins)) {
                let upper := edgeArray[i + 1]
                if value >= edgeArray[i] && (value < upper || (i == bins - 1 && value <= upper)) {
                    placed = i
                    break
                }
            }
            if placed >= 0 { counts[placed] = counts[placed] + 1.0 }
        }
        let heights : Array[double] = Array(bins, 0.0)
        let mut running := 0.0
        for (i in range(bins)) {
            let width := (edgeArray[i + 1] - edgeArray[i]).abs()
            if cumulative {
                running = running + (if density then counts[i] / total else counts[i])
                heights[i] = running
            } else {
                heights[i] =
                    if density then counts[i] / (total * max(width, 1.0e-12)) else counts[i]
            }
        }
        let chosen := this.nextColor(color)
        let kind := histType.toLower()
        if kind == "step" || kind == "stepfilled" {
            let xs : Array[double] = Array.empty()
            let ys : Array[double] = Array.empty()
            for (i in range(bins)) {
                xs.append(edgeArray[i])
                ys.append(heights[i])
                xs.append(edgeArray[i + 1])
                ys.append(heights[i])
            }
            this.current.addLine(
                Line2D(
                    xs.toList(),
                    ys.toList(),
                    chosen,
                    if edgeWidth <= 0.0 then 1.2 else edgeWidth,
                    "-",
                    "",
                    0.0,
                    chosen,
                    chosen,
                    clamp(alpha, 0.0, 1.0),
                    "",
                    label,
                ),
            )
            if kind == "stepfilled" {
                let lowers := [0.0 for i in range(xs.length())]
                this.current.addBand(
                    Band(
                        xs.toList(),
                        lowers,
                        ys.toList(),
                        chosen,
                        clamp(alpha, 0.0, 1.0) * 0.5,
                        chosen,
                        0.8,
                        "-",
                        "",
                    ),
                )
            }
            if label != "" { this.legendLine(label, chosen, "-", "", 1.2, 0.0, alpha) }
        } else {
            let positions : Array[double] = Array.empty()
            let widths : Array[double] = Array.empty()
            for (i in range(bins)) {
                positions.append((edgeArray[i] + edgeArray[i + 1]) / 2.0)
                widths.append((edgeArray[i + 1] - edgeArray[i]).abs())
            }
            let bases := [0.0 for i in range(bins)]
            this.current.addBars(
                Bars(
                    positions.toList(),
                    heights.toList(),
                    bases,
                    widths.toList(),
                    chosen,
                    [],
                    normalizeColor(edgeColor),
                    max(0.0, edgeWidth),
                    clamp(alpha, 0.0, 1.0),
                    false,
                    label,
                ),
            )
            if label != "" { this.legendPatch(label, chosen, alpha) }
        }
    }

    public mut function hist(
        values : List[double],
        bins : Int = 10,
        density : Bool = false,
        cumulative : Bool = false,
        histType : String = "bar",
        label : String = "",
        color : String = "",
        alpha : double = 0.7,
        edgeColor : String = "",
        edgeWidth : double = 0.0,
    ) : void {
        let clean := validValues(values)
        if clean.length() == 0 { return }
        let count := max(1, bins)
        // Bins need the range, not a full order: sorting a million values only
        // to read its ends was quadratic-ish work for nothing.
        let first := match clean.min() { Some(value) => value, None => 0.0 }
        let last := match clean.max() { Some(value) => value, None => 0.0 }
        let low := if first == last then first - 0.5 else first
        let high := if first == last then last + 0.5 else last
        let edges : List[double] =
            [low + (high - low) * i.toDouble() / count.toDouble() for i in range(count + 1)]
        this.addHistogram(
            clean,
            edges,
            density,
            cumulative,
            histType,
            label,
            color,
            alpha,
            edgeColor,
            edgeWidth,
        )
    }

    public mut function hist(
        values : List[Int],
        bins : Int = 10,
        density : Bool = false,
        cumulative : Bool = false,
        histType : String = "bar",
        label : String = "",
        color : String = "",
        alpha : double = 0.7,
        edgeColor : String = "",
        edgeWidth : double = 0.0,
    ) : void {
        this.hist(
            [v.toDouble() for v in values],
            bins = bins,
            density = density,
            cumulative = cumulative,
            histType = histType,
            label = label,
            color = color,
            alpha = alpha,
            edgeColor = edgeColor,
            edgeWidth = edgeWidth,
        )
    }

    public mut function hist(
        values : List[double],
        edges : List[double],
        density : Bool = false,
        cumulative : Bool = false,
        histType : String = "bar",
        label : String = "",
        color : String = "",
        alpha : double = 0.7,
        edgeColor : String = "",
        edgeWidth : double = 0.0,
    ) : void {
        this.addHistogram(
            values,
            edges.sorted(),
            density,
            cumulative,
            histType,
            label,
            color,
            alpha,
            edgeColor,
            edgeWidth,
        )
    }

    public mut function histSeries(
        series : Series,
        bins : Int = 10,
        density : Bool = false,
        cumulative : Bool = false,
        histType : String = "bar",
        label : String = "",
        color : String = "",
        alpha : double = 0.7,
    ) : void {
        this.hist(
            series.toFloats(),
            bins = bins,
            density = density,
            cumulative = cumulative,
            histType = histType,
            label = if label == "" then seriesLabel(series) else label,
            color = color,
            alpha = alpha,
        )
    }

    // ---- box plots

    mut function addBoxGroup(
        values : List[double],
        label : String,
        position : double,
        color : String,
        width : double,
    ) : void {
        let clean := validValues(values).sorted()
        if clean.length() == 0 { return }
        let q1 := quantileSorted(clean, 0.25)
        let median := quantileSorted(clean, 0.5)
        let q3 := quantileSorted(clean, 0.75)
        let spread := q3 - q1
        let fenceLow := q1 - spread * 1.5
        let fenceHigh := q3 + spread * 1.5
        let mut whiskerLow := q1
        let mut whiskerHigh := q3
        let outliers : Array[double] = Array.empty()
        for (value in clean) {
            if value < fenceLow || value > fenceHigh {
                outliers.append(value)
            } else if value < whiskerLow {
                whiskerLow = value
            } else if value > whiskerHigh {
                whiskerHigh = value
            }
        }
        let chosen := this.nextColor(color)
        this.current.addBox(
            BoxPlot(
                position,
                whiskerLow,
                q1,
                median,
                q3,
                whiskerHigh,
                outliers.toList(),
                chosen,
                if width < 0.0 then this.style.barWidth * 0.65 else width,
                label,
            ),
        )
        if label != "" { this.legendPatch(label, chosen, 0.35) }
    }

    public mut function box(
        values : List[double],
        label : String = "",
        color : String = "",
        width : double = -1.0,
    ) : void {
        this.addBoxGroup(values, label, this.current.boxes.length().toDouble(), color, width)
    }

    public mut function box(
        values : List[Int],
        label : String = "",
        color : String = "",
        width : double = -1.0,
    ) : void {
        this.box([v.toDouble() for v in values], label = label, color = color, width = width)
    }

    public mut function boxPlot(
        groups : List[List[double]],
        labels : List[String] = [],
        color : String = "",
        width : double = -1.0,
    ) : void {
        let positions : List[double] =
            if labels.length() == groups.length() then this.current.categories(labels)
            else [i.toDouble() for i in range(groups.length())]
        let pa := positions.toArray()
        let mut i := 0
        for (group in groups) {
            let name := if i < labels.length() then listAt(labels, i) else ""
            this.addBoxGroup(group, name, pa[i], color, width)
            i = i + 1
        }
    }

    public mut function boxSeries(
        series : Series,
        label : String = "",
        color : String = "",
        width : double = -1.0,
    ) : void {
        this.box(
            series.toFloats(),
            label = if label == "" then seriesLabel(series) else label,
            color = color,
            width = width,
        )
    }

    // ---- heatmaps

    public mut function heatmap(
        matrix : List[List[double]],
        rowLabels : List[String] = [],
        colLabels : List[String] = [],
        cmap : String = "viridis",
        colorbar : Bool = true,
        colorbarLabel : String = "",
        grid : Bool = false,
    ) : void {
        if matrix.length() == 0 { return }
        let rows := matrix.length()
        let cols := listAt(matrix, 0).length()
        if cols == 0 { return }
        let map :=
            Heatmap(
                matrix,
                rowLabels,
                colLabels,
                cmap,
                nanValue(),
                nanValue(),
                grid,
                colorbarLabel,
                colorbar,
            )
        let (low, high) := heatmapRange(map)
        this.current.pieMode = false
        this.current.aspect = "equal"
        this.current.xMin = 0.0
        this.current.xMax = cols.toDouble()
        this.current.yMin = 0.0
        this.current.yMax = rows.toDouble()
        if colLabels.length() == cols {
            this.current.xTickPositions = [i.toDouble() + 0.5 for i in range(cols)]
            this.current.xTickLabels = colLabels
        }
        if rowLabels.length() == rows {
            this.current.yTickPositions = [(rows - 1 - i).toDouble() + 0.5 for i in range(rows)]
            this.current.yTickLabels = rowLabels
        }
        this.current.addHeatmap(map)
        this.current.colorbar = Colorbar(cmap, low, high, colorbarLabel)
        this.current.colorbar.visible = colorbar
        this.current.colorCount = this.current.colorCount + 1
    }

    public mut function heatmapScaled(
        matrix : List[List[double]],
        rowLabels : List[String],
        colLabels : List[String],
        cmap : String,
        vmin : double,
        vmax : double,
        colorbar : Bool = true,
        colorbarLabel : String = "",
    ) : void {
        if matrix.length() == 0 { return }
        let rows := matrix.length()
        let cols := listAt(matrix, 0).length()
        let map :=
            Heatmap(matrix, rowLabels, colLabels, cmap, vmin, vmax, false, colorbarLabel, colorbar)
        this.current.pieMode = false
        this.current.aspect = "equal"
        this.current.xMin = 0.0
        this.current.xMax = cols.toDouble()
        this.current.yMin = 0.0
        this.current.yMax = rows.toDouble()
        if colLabels.length() == cols {
            this.current.xTickPositions = [i.toDouble() + 0.5 for i in range(cols)]
            this.current.xTickLabels = colLabels
        }
        if rowLabels.length() == rows {
            this.current.yTickPositions = [(rows - 1 - i).toDouble() + 0.5 for i in range(rows)]
            this.current.yTickLabels = rowLabels
        }
        this.current.addHeatmap(map)
        this.current.colorbar = Colorbar(cmap, vmin, vmax, colorbarLabel)
        this.current.colorbar.visible = colorbar
    }

    public mut function imshow(
        matrix : List[List[double]],
        cmap : String = "viridis",
        colorbar : Bool = true,
    ) : void {
        this.heatmap(matrix, cmap = cmap, colorbar = colorbar)
    }

    // ---- pie charts

    public mut function pie(
        values : List[double],
        labels : List[String] = [],
        colors : List[String] = [],
        startAngle : double = 90.0,
        explode : List[double] = [],
        donut : double = 0.0,
        autoPercent : Bool = false,
        labelDistance : double = 1.12,
        showLabels : Bool = true,
        edgeColor : String = "white",
        edgeWidth : double = 1.0,
    ) : void {
        let resolved : List[String] =
            if colors.length() == 0 then [] else [normalizeColor(c) for c in colors]
        this.current.pieMode = true
        this.current.addPie(
            Pie(
                values,
                labels,
                resolved,
                startAngle,
                explode,
                donut,
                autoPercent,
                labelDistance,
                showLabels,
                normalizeColor(edgeColor),
                max(0.0, edgeWidth),
            ),
        )
        let mut i := 0
        for (label in labels) {
            let color :=
                if resolved.length() > 0 then listAt(resolved, i % resolved.length())
                else listAt(this.style.colorCycle, i % this.style.colorCycle.length())
            this.current.addLegendItem(
                LegendItem(label, color, color, "", "-", 0.8, 0.0, "patch", 1.0),
            )
            i = i + 1
        }
    }

    public mut function pie(
        values : List[Int],
        labels : List[String] = [],
        colors : List[String] = [],
        startAngle : double = 90.0,
        explode : List[double] = [],
        donut : double = 0.0,
        autoPercent : Bool = false,
        showLabels : Bool = true,
    ) : void {
        this.pie(
            [v.toDouble() for v in values],
            labels = labels,
            colors = colors,
            startAngle = startAngle,
            explode = explode,
            donut = donut,
            autoPercent = autoPercent,
            showLabels = showLabels,
        )
    }

    // ---- text

    public mut function text(
        x : double,
        y : double,
        content : String,
        color : String = "",
        size : double = -1.0,
        align : String = "center",
        rotation : double = 0.0,
        weight : String = "normal",
        coordinate : String = "data",
        family : String = "",
        alpha : double = 1.0,
    ) : void {
        let chosen := if color == "" then this.style.textColor else normalizeColor(color)
        this.current.addText(
            TextMark(
                x,
                y,
                content,
                chosen,
                if size < 0.0 then this.style.fontSize else size,
                align,
                rotation,
                weight,
                coordinate,
                family,
                alpha,
            ),
        )
    }

    public mut function textAxes(
        x : double,
        y : double,
        content : String,
        color : String = "",
        size : double = -1.0,
        align : String = "center",
        rotation : double = 0.0,
        weight : String = "normal",
        family : String = "",
        alpha : double = 1.0,
    ) : void {
        this.text(
            x,
            y,
            content,
            color = color,
            size = size,
            align = align,
            rotation = rotation,
            weight = weight,
            coordinate = "axes",
            family = family,
            alpha = alpha,
        )
    }

    // ---- output

    function renderBody() : String {
        let width := this.figureWidth * 72.0
        let height := this.figureHeight * 72.0
        let svg := Svg()
        svg.add(
            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" +
                fmt(this.figureWidth) +
                "in\" height=\"" +
                fmt(this.figureHeight) +
                "in\" viewBox=\"0 0 " +
                fmt(width) +
                " " + fmt(height) + "\" font-family=\"" + escapeXml(this.style.fontFamily) + "\">\n",
        )
        if this.figureTitle != "" {
            svg.add("<title>" + escapeXml(this.figureTitle) + "</title>\n")
        }
        svg.add(
            "<rect width=\"" +
                fmt(width) +
                "\" height=\"" + fmt(height) + "\" fill=\"" + this.style.figureFace + "\"/>\n",
        )
        let left := width * this.style.left
        let right := width * this.style.right
        let bottom := height * (1.0 - this.style.bottom)
        let (figureTitleText, figureTitleSize) :=
            fittedText(
                this.figureTitle,
                max(20.0, width - 2.0 * width * this.style.left),
                this.figureTitleSize,
                this.style.isSerif(),
            )
        let figureTitleLines :=
            if figureTitleText == "" then 0 else figureTitleText.split("\n").length()
        let titleHeight :=
            if figureTitleText == "" then 0.0
            else figureTitleSize * 1.9 * figureTitleLines.toDouble()
        let top := height * (1.0 - this.style.top) + titleHeight
        if figureTitleText != "" {
            svg.add(
                textBlock(
                    figureTitleText,
                    width / 2.0,
                    height * (1.0 - this.style.top) + figureTitleSize * 0.95,
                    figureTitleSize * 1.2,
                    figureTitleSize,
                    this.style.textColor,
                    "middle",
                    "bold",
                    "",
                    0.0,
                    1.0,
                ),
            )
        }
        let safeTop := min(top, bottom - 20.0)
        let safeRight := max(left + 20.0, right)
        let count := this.rows * this.cols
        let gapX :=
            if this.cols > 1 then this.style.wspace * (safeRight - left) / this.cols.toDouble()
            else 0.0
        let gapY :=
            if this.rows > 1 then this.style.hspace * (bottom - safeTop) / this.rows.toDouble()
            else 0.0
        let cellWidth :=
            (safeRight - left - gapX * (this.cols - 1).toDouble()) / this.cols.toDouble()
        let cellHeight :=
            (bottom - safeTop - gapY * (this.rows - 1).toDouble()) / this.rows.toDouble()
        let mut index := 0
        while index < count {
            let row := index / this.cols
            let column := index % this.cols
            let cellX := left + column.toDouble() * (cellWidth + gapX)
            let cellY := safeTop + row.toDouble() * (cellHeight + gapY)
            let panel := if index == this.currentIndex then this.current else this.saved[index]
            renderAxes(panel, svg, this.style, cellX, cellY, cellWidth, cellHeight, index)
            index = index + 1
        }
        svg.add("</svg>\n")
        svg.text()
    }

    public function toSvgFallback() : String =
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" + this.renderBody()

    public function toSvg() : String or Error with Effects {
        let body := this.renderBody()
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" + applyTex(body, "")?
    }

    public function toSvgTex() : String or Error with Effects = this.toSvg()

    public function toHtml() : String or Error with Effects {
        let body := this.renderBody()
        "<div style=\"max-width:100%;display:inline-block\">" + applyTex(body, "")?+ "</div>"
    }

    public function toHtmlPage() : String or Error with Effects {
        let page := this.toHtml()?
        "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>" +
            escapeXml(if this.figureTitle == "" then "kesplot figure" else this.figureTitle) +
            "</title><style>body{margin:0;background:#fff;display:flex;justify-content:center;padding:16px}svg{max-width:100%;height:auto}</style></head>\n<body>\n" +
            page + "\n</body>\n</html>\n"
    }

    // The notebook display must return one String, so an unavailable TeX
    // installation falls back to the Unicode preview instead of failing the cell.
    public function html() : String with Effects {
        match this.toHtml() {
            page => page,
            _ =>
                "<div style=\"max-width:100%;display:inline-block\">" + this.renderBody() + "</div>",
        }
    }

    public function text() : String =
        "Figure(" +
            this.rows.text() +
            "x" +
            this.cols.text() +
            ", " +
            trimZeroes(fixedDecimals(this.figureWidth, 2)) +
            "x" +
            trimZeroes(fixedDecimals(this.figureHeight, 2)) + " in, style " + this.style.name + ")"

    public function save(path : String, dpi : Int = -1) : void or Error with Effects {
        let lower := path.toLower()
        if lower.endsWith(".svg") {
            let content := this.toSvg()?
            writeTextFile(path, content)?
            return
        }
        if lower.endsWith(".html") || lower.endsWith(".htm") {
            let content := this.toHtmlPage()?
            writeTextFile(path, content)?
            return
        }
        if lower.endsWith(".png") ||
            lower.endsWith(".jpg") ||
            lower.endsWith(".jpeg") || lower.endsWith(".pdf") || lower.endsWith(".ps") {
                let svg := this.toSvg()?
                let format :=
                    if lower.endsWith(".png") then "png"
                    else if lower.endsWith(".pdf") then "pdf"
                    else if lower.endsWith(".ps") then "ps" else "jpg"
                let chosenDpi := max(1, if dpi > 0 then dpi else this.style.dpi)
                convertSvg(
                    svg,
                    path,
                    format,
                    chosenDpi,
                    whole(this.figureWidth * chosenDpi.toDouble()),
                    whole(this.figureHeight * chosenDpi.toDouble()),
                )?
                return
            }
        return Error("kesplot saves .svg, .html, .png, .jpg, .jpeg, .pdf or .ps")
    }

    // ---- Kesdas frames and series

    public mut function plotFrame(
        frame : DataFrame,
        x : String = "",
        y : List[String] = [],
        kind : String = "line",
        colors : List[String] = [],
        labels : List[String] = [],
        alpha : double = 1.0,
        lineWidth : double = -1.0,
        marker : String = "",
        stacked : Bool = false,
        edgeColor : String = "",
        edgeWidth : double = 0.0,
    ) : void or
        Error {
            let xValues := frameXValues(frame, x)?
            let names := frameNumericColumns(frame, y)?
            if x != "" && this.current.xLabel == "" { this.current.xLabel = x }
            let styleKind := kind.toLower()
            let chosenAlpha := clamp(alpha, 0.0, 1.0)
            if styleKind == "bar" || styleKind == "barh" {
                let horizontal := styleKind == "barh"
                let positions : List[double] =
                    if xValues.categorical then this.current.categories(xValues.labels)
                    else xValues.values
                let count := min(positions.length(), frame.length())
                let seriesCount := names.length()
                let width :=
                    if stacked || seriesCount <= 1 then this.style.barWidth
                    else this.style.barWidth / seriesCount.toDouble() * 0.92
                let running : Array[double] = Array(count, 0.0)
                let mut seriesIndex := 0
                for (name in names) {
                    let values := frameNumericValues(frame, name)?
                    let offset :=
                        if stacked || seriesCount <= 1 then 0.0
                        else 0.0 -
                            this.style.barWidth / 2.0 + width * (seriesIndex.toDouble() + 0.5)
                    let bases : List[double] =
                        if stacked then [running[i] for i in range(count)]
                        else [0.0 for i in range(count)]
                    let label :=
                        if seriesIndex < labels.length() then listAt(labels, seriesIndex) else name
                    let color :=
                        if seriesIndex < colors.length() then listAt(colors, seriesIndex) else ""
                    this.addBarsValues(
                        positions,
                        values,
                        bases,
                        offset,
                        width,
                        horizontal,
                        label,
                        color,
                        chosenAlpha,
                        edgeColor,
                        edgeWidth,
                    )
                    if stacked {
                        let actual := values.toArray()
                        for (i in range(min(count, actual.length()))) {
                            running[i] =
                                running[i] + (if actual[i] == actual[i] then actual[i] else 0.0)
                        }
                    }
                    seriesIndex = seriesIndex + 1
                }
                if seriesCount > 1 { this.current.legendShown = true }
                return
            }
            if styleKind == "hist" || styleKind == "histogram" {
                for (name in names) {
                    let values := frameNumericValues(frame, name)?
                    this.hist(
                        values,
                        bins = 10,
                        density = false,
                        cumulative = false,
                        histType = "bar",
                        label = (if labels.length() > 0 then listAt(labels, 0) else name),
                        color = (if colors.length() > 0 then listAt(colors, 0) else ""),
                        alpha = 0.6,
                    )
                }
                if names.length() > 1 { this.current.legendShown = true }
                return
            }
            if styleKind == "scatter" {
                if names.length() != 1 {
                    return Error("scatterFrame plots one y column; got " + names.length().text())
                }
                this.scatterFrame(frame, x, listAt(names, 0), "", "", marker, -1.0, chosenAlpha)?
                return
            }
            if styleKind == "box" || styleKind == "boxplot" {
                let mut groups : Array[List[double]] = Array.empty()
                for (name in names) { groups.append(frameNumericValues(frame, name)?) }
                this.boxPlot(groups.toList(), names)
                if names.length() > 1 { this.current.legendShown = true }
                return
            }
            if styleKind == "line" ||
                styleKind == "plot" || styleKind == "step" || styleKind == "area" {
                    let mut seriesIndex := 0
                    for (name in names) {
                        let values := frameNumericValues(frame, name)?
                        let label :=
                            if seriesIndex < labels.length() then listAt(labels, seriesIndex)
                            else name
                        let color :=
                            if seriesIndex < colors.length() then listAt(colors, seriesIndex)
                            else ""
                        if styleKind == "area" {
                            let lowers := [0.0 for i in range(values.length())]
                            if xValues.categorical then {
                                this.addBandValues(
                                    [],
                                    lowers,
                                    values,
                                    xValues.labels,
                                    label,
                                    color,
                                    0.3,
                                    color,
                                    0.8,
                                    "-",
                                )
                            } else {
                                this.addBandValues(
                                    xValues.values,
                                    lowers,
                                    values,
                                    [],
                                    label,
                                    color,
                                    0.3,
                                    color,
                                    0.8,
                                    "-",
                                )
                            }
                        } else if xValues.categorical {
                            this.addLineValues(
                                [],
                                values,
                                xValues.labels,
                                label,
                                color,
                                lineWidth,
                                "",
                                marker,
                                -1.0,
                                chosenAlpha,
                                if styleKind == "step" then "pre" else "",
                            )
                        } else {
                            this.addLineValues(
                                xValues.values,
                                values,
                                [],
                                label,
                                color,
                                lineWidth,
                                "",
                                marker,
                                -1.0,
                                chosenAlpha,
                                if styleKind == "step" then "pre" else "",
                            )
                        }
                        seriesIndex = seriesIndex + 1
                    }
                    if names.length() > 1 { this.current.legendShown = true }
                    return
                }
            Error("unknown plot kind: " + kind)
        }

    public mut function plotFrame(
        frame : DataFrame,
        x : String,
        y : String,
        kind : String = "line",
        colors : List[String] = [],
        labels : List[String] = [],
        alpha : double = 1.0,
        lineWidth : double = -1.0,
        marker : String = "",
        stacked : Bool = false,
        edgeColor : String = "",
        edgeWidth : double = 0.0,
    ) : void or
        Error {
            this.plotFrame(
                frame,
                x,
                [y],
                kind = kind,
                colors = colors,
                labels = labels,
                alpha = alpha,
                lineWidth = lineWidth,
                marker = marker,
                stacked = stacked,
                edgeColor = edgeColor,
                edgeWidth = edgeWidth,
            )
        }

    public mut function barFrame(
        frame : DataFrame,
        x : String = "",
        y : List[String] = [],
        stacked : Bool = false,
        horizontal : Bool = false,
        colors : List[String] = [],
        labels : List[String] = [],
        alpha : double = 1.0,
    ) : void or
        Error {
            this.plotFrame(
                frame,
                x,
                y,
                kind = if horizontal then "barh" else "bar",
                colors = colors,
                labels = labels,
                alpha = alpha,
                stacked = stacked,
                edgeColor = "",
                edgeWidth = 0.0,
            )
        }


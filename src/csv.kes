// std.csv: comma-separated text, as RFC 4180 describes it.
//
//     let rows := csv.parse(fs.readFile("data.csv")?)?
//     let table := csv.parseRecords(text)?        // one Map per row, keyed by the header
//     fs.writeFile("out.csv", csv.write(rows))?
//
// A field in double quotes may hold the delimiter, line breaks and `""` for a quote. Lines end
// with LF or CRLF. kesdas's readCsv builds typed DataFrame columns; this module gives Strings.

// The rows of `text`, each a List of fields. A trailing line break does not add an empty row.
public function parse(text : String, delimiter : String = ",") : List[List[String]] or Error {
    if delimiter.byteLength() != 1 || delimiter == "\"" || delimiter == "\n" {
        return Error("CSV: the delimiter must be one character other than a quote or a line break")
    }
    let sep := delimiter.byteAt(0)
    let rows : Array[List[String]] = Array.empty()
    let mut fields : Array[String] = Array.empty()
    let n := text.byteLength()
    let mut at := 0
    let mut line := 1
    let mut fieldStart := true
    while at < n {
        let b := text.byteAt(at)
        if b == 34 && fieldStart {
            let pieces : Array[String] = Array.empty()
            at += 1
            let mut start := at
            let mut closed := false
            while at < n {
                let c := text.byteAt(at)
                if c == 34 {
                    pieces.append(text.byteSlice(start, at))
                    if at + 1 < n && text.byteAt(at + 1) == 34 {
                        pieces.append("\"")
                        at += 2
                        start = at
                    } else {
                        at += 1
                        closed = true
                        break
                    }
                } else {
                    if c == 10 {
                        line += 1
                    }
                    at += 1
                }
            }
            if !closed {
                return Error(f"CSV: a quoted field that starts on line {line} is never closed")
            }
            fields.append(pieces.join(""))
            if at < n {
                let next := text.byteAt(at)
                if next != sep && next != 10 && next != 13 {
                    return Error(f"CSV: text after a closing quote on line {line}")
                }
            }
            fieldStart = false
        } else if b == sep {
            if fieldStart {
                fields.append("")
            }
            at += 1
            fieldStart = true
            if at >= n {
                fields.append("")
            }
        } else if b == 10 || b == 13 {
            if fieldStart {
                fields.append("")
            }
            rows.append(fields.toList())
            fields = Array.empty()
            at += if b == 13 && at + 1 < n && text.byteAt(at + 1) == 10 then 2 else 1
            line += 1
            fieldStart = true
        } else {
            let start := at
            while at < n {
                let c := text.byteAt(at)
                if c == sep || c == 10 || c == 13 {
                    break
                }
                if c == 34 {
                    return Error(f"CSV: a quote inside an unquoted field on line {line}")
                }
                at += 1
            }
            fields.append(text.byteSlice(start, at))
            fieldStart = false
        }
    }
    if fields.length() > 0 {
        rows.append(fields.toList())
    }
    return rows.toList()
}

// Rows as Maps from the header's names to the fields. Every row needs as many fields as the header.
public function parseRecords(text : String, delimiter : String = ",") : List[Map[String, String]] or Error {
    let rows := parse(text, delimiter)?
    let header := rows.take(1).flatten()
    let records : Array[Map[String, String]] = Array.empty()
    let mut number := 1
    for (row in rows.drop(1)) {
        number += 1
        if row.length() != header.length() {
            return Error(f"CSV: row {number} has {row.length()} fields, but the header has {header.length()}")
        }
        let mut entry : Map[String, String] = Map()
        for ((name, field) in header.zip(row)) {
            entry = entry.put(name, field)
        }
        records.append(entry)
    }
    return records.toList()
}

function quoteField(field : String, delimiter : String) : String {
    if field.contains(delimiter) || field.contains("\"") || field.contains("\n") || field.contains("\r") {
        return "\"" + field.replace("\"", "\"\"") + "\""
    }
    return field
}

// CSV text for `rows`, quoting only the fields that need it, with LF after each row.
public function write(rows : List[List[String]], delimiter : String = ",") : String =
    rows.map(row => row.map(field => quoteField(field, delimiter)).join(delimiter) + "\n").join("")

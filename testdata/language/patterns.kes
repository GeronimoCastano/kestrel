// Alternatives and ranges in patterns: one arm body for several shapes, and
// integer intervals with `..` (half-open) and `..=` (closed).

function classOf(b : Int) : String = match b {
    48..=57 => "digit",
    65..=90 | 97..=122 => "letter",
    32 | 9 | 10 | 13 => "space",
    _ => "other",
}

function everyBool(b : Bool) : Int = match b {
    true | false => 1,
}

enum Direction {
    North
    South
    East
    West
}

function vertical(d : Direction) : Bool = match d {
    North | South => true,
    East | West => false,
}

function sign(n : Int) : String = match n {
    -10..0 => "negative",
    0 => "zero",
    1..=9 => "small",
    _ => "large",
}

function described(n : Int, loud : Bool) : String = match n {
    -5..0 | 100..=200 if loud => "loud edge",
    0 | 1 => "small",
    _ => "other",
}

print(classOf(50))
print(classOf(65))
print(classOf(32))
print(classOf(0))
print(everyBool(true))
print(vertical(Direction.North))
print(vertical(Direction.West))
print(sign(-3))
print(sign(0))
print(sign(5))
print(sign(100))
print(described(-3, true))
print(described(-3, false))

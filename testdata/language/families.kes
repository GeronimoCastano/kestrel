// Family sets, set-builder and finite sets in the proof kernel.
// The theorems mirror the FamUnion, FamInter and FamCombo worlds: membership
// unfolds to ordinary quantifiers, so the usual logical tactics apply.

theorem familyUnionIntro[U](
    F : Set[Set[U]],
    A : Set[U],
    hF : A ∈ F,
    x : U,
    hx : x ∈ A,
) : x ∈ ⋃₀ F by {
    exists A
    constructor
    exact hF
    exact hx
}

theorem familyUnionElim[U](
    F : Set[Set[U]],
    x : U,
    h : x ∈ ⋃₀ F,
) : exists A : Set[U], A ∈ F and x ∈ A by {
    exact h
}

theorem familyInterIntro[U](
    F : Set[Set[U]],
    x : U,
    h : forall A : Set[U], A ∈ F -> x ∈ A,
) : x ∈ ⋂₀ F by {
    exact h
}

theorem familyInterElim[U](
    F : Set[Set[U]],
    x : U,
    h : x ∈ ⋂₀ F,
) : forall A : Set[U], A ∈ F -> x ∈ A by {
    exact h
}

theorem familyUnionMono[U](F : Set[Set[U]], G : Set[Set[U]], h : F ⊆ G) : ⋃₀ F ⊆ ⋃₀ G by {
    intro x
    intro hx
    cases hx
    cases hxw
    exists s
    constructor
    apply h
    exact hxwl
    exact hxwr
}

theorem memberSubsetUnion[U](F : Set[Set[U]], A : Set[U], hF : A ∈ F) : A ⊆ ⋃₀ F by {
    intro x
    intro hx
    exists A
    constructor
    exact hF
    exact hx
}

theorem familyInterSubset[U](F : Set[Set[U]], A : Set[U], hF : A ∈ F) : ⋂₀ F ⊆ A by {
    intro x
    intro hx
    apply hx
    exact hF
}

theorem unionPair[U](A : Set[U], B : Set[U]) : ⋃₀ { A, B } = A ∪ B by {
    ext
    intro x
    intro hx
    cases hx
    cases hxw
    cases hxwl
    have hAs := symm(hxwll)
    rw [hAs]
    left
    exact hxwr
    have hBs := symm(hxwlr)
    rw [hBs]
    right
    exact hxwr
    intro x
    intro hx
    cases hx
    exists A
    constructor
    left
    rfl
    exact hxl
    exists B
    constructor
    right
    rfl
    exact hxr
}

theorem interPair[U](A : Set[U], B : Set[U]) : ⋂₀ { A, B } = A ∩ B by {
    ext
    intro x
    intro hx
    constructor
    apply hx
    left
    rfl
    apply hx
    right
    rfl
    intro x
    intro hx
    intro s
    intro hs
    cases hx
    cases hs
    rw [hsl]
    exact hxl
    rw [hsr]
    exact hxr
}

theorem familyDeMorgan[U](F : Set[Set[U]]) : (⋃₀ F)ᶜ =
    { x : U | forall A : Set[U], A ∈ F -> x ∉ A } by {
        ext
        intro x
        intro h
        intro A
        intro hAF
        intro hxA
        apply h
        exists A
        constructor
        exact hAF
        exact hxA
        intro x
        intro h
        intro hx
        cases hx
        cases hxw
        have hs := h(s)
        exact hs(hxwl, hxwr)
    }

theorem builderSingleton[U](a : U) : { x : U | x = a } = { a } by {
    ext
    intro x
    intro h
    exact h
    intro x
    intro h
    exact h
}

theorem emptySubset[U](A : Set[U]) : ∅ ⊆ A by {
    intro x
    intro h
    exfalso
    exact h
}

theorem emptyElim[U](x : U) : x ∈ ∅ -> false by {
    intro h
    exact h
}

theorem aliasSpelling[U](F : Set[Set[U]], x : U, h : x ∈ \union0 F) : x ∈ ⋃₀ F by {
    exact h
}

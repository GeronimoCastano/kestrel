function nonnegative(n : Int) : Int ensures result >= 0 {
    if n < 0 {return 0}
    n
}

function echo(text : String) : String ensures result == text = text

function parsed(text : String) : Int or Error ensures result > 0 {
    parseInt(text)?
}

print(nonnegative(-3))
print(nonnegative(4))
print(echo("hello"))
print(match parsed("3") {n => n.text(), _ => "error",})
print(match parsed("invalid") {RuntimeError.Parse(_) => "parse", _ => "other",})

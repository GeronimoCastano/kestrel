theorem setExact[U](x : U, A : Set[U], h : x ∈ A) : x ∈ A by {
    exact h
}

theorem setApply[U](x : U, A : Set[U], B : Set[U], h1 : A ⊆ B, h2 : x ∈ A) : x ∈ B by {
    exact h1(h2)
}

theorem setHave[U](
    x : U,
    A : Set[U],
    B : Set[U],
    C : Set[U],
    h1 : A ⊆ B,
    h2 : B ⊆ C,
    h3 : x ∈ A,
) : x ∈ C by {
    have h4 := h1(h3)
    exact h2(h4)
}

theorem subsetRefl[U](A : Set[U]) : A ⊆ A by {
    intro x
    intro h
    exact h
}

theorem subsetTrans[U](A : Set[U], B : Set[U], C : Set[U], h1 : A ⊆ B, h2 : B ⊆ C) : A ⊆ C by {
    intro x
    intro h3
    have h4 := h1(h3)
    exact h2(h4)
}

theorem useRefl[U](A : Set[U]) : A ⊆ A by {
    exact subsetRefl(A)
}

theorem useTrans[U](A : Set[U], B : Set[U], C : Set[U], h1 : A ⊆ B, h2 : B ⊆ C) : A ⊆ C by {
    exact subsetTrans(A, B, C)
}

theorem setImp[U](
    x : U,
    A : Set[U],
    B : Set[U],
    C : Set[U],
    h1 : A ⊆ B,
    h2 : x ∈ B -> x ∈ C,
) : x ∈ A -> x ∈ C by {
    intro h3
    have h4 := h1(h3)
    exact h2(h4)
}

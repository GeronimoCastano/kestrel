// A class takes part in brackets by naming Indexable[Key, Item] and writing at.
// MutableIndexable[Key, Item] adds setAt, which a bracket assignment calls.
class Grid {
    has MutableIndexable[(Int, Int), double]

    private var cells : Array[double]
    private final columns : Int

    new(rows : Int, columns : Int) {
        this.columns = columns
        this.cells = Array(rows * columns, 0.0)
    }

    public function at(key : (Int, Int)) : double = this.cells[this.columns * key[0] + key[1]]

    public mut function setAt(key : (Int, Int), value : double) : void {
        this.cells[this.columns * key[0] + key[1]] = value
    }
}

// A read works through a borrowed parameter, and a write needs it to be mut.
function sumRow(grid : Grid, row : Int, columns : Int) : double {
    let mut total := 0.0
    for (column in range(columns)) {
        total = total + grid[(row, column)]
    }
    total
}

function fill(mut grid : Grid, rows : Int, columns : Int) : void {
    for (row in range(rows)) {
        for (column in range(columns)) {
            grid[(row, column)] = (row * columns + column).toDouble()
        }
    }
}

let mut grid := Grid(2, 3)
fill(grid, 2, 3)
print(grid[(0, 2)])
print(grid[(1, 1)])
print(sumRow(grid, 1, 3))

grid[(0, 2)] = 99.0
print(grid[(0, 2)])

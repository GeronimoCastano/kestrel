function add(a : Nat, b : Nat) : Nat = match a { Zero => b, Succ(k) => Succ(add(k, b)) }

@simp
theorem addEq(a : Nat, b : Nat) : add(a, b) = a + b by {
    induction a {
        Zero => { rfl }
        Succ(k) ih => { simp [ih] }
    }
}

theorem auto(n : Nat, m : Nat) : add(n, m) = n + m by {
    simp
}

// Examples checked by the current front end; native execution is still pending.
import std.collections.{List}

trait Shape {
    function area() : double
}

const SCALE_FACTOR : double = 2.0

function add(a : double, b : double) : double = a + b

function twice(x : double) : double = x * SCALE_FACTOR

// `_` leaves a slot open. A call with open slots is a function.
public function pipesAndCurrying() : double {
    let addOne := add(1.0, _)                     // a function
    let total : double = 3.0 |> addOne |> twice   // 3.0 -> 4.0 -> 8.0
    let sum := 3.0 |> add(_, 1.0)                 // the piped value fills `_`: 4.0
    total + sum
}

public function mutation() : double {
    let mut total := 0.0
    total = total + 1.0
    total = total * 2.0
    total
}

public function sideList() : List[double] {
    let sides : List[double] = [1.0, 2.0, 3.0]
    sides
}

public class Figure {
    public function area() : double = 0.0
    public function fits(limit : double) : Bool = this.area() <= limit
}

public class Square extends Figure {
    has Shape

    public final side : double

    new(side : double) {
        this.side = side
    }

    public static function unit() : Square = Square(1.0)

    @override public function area() : double = this.side * this.side
    public function fits(other : Square) : Bool = this.area() <= other.area()   // overload: no keyword

    // rejected (Ov1): @override public function area() : Int
}

public class Account {
    private var balance : double

    new(start : double) {
        this.balance = start
    }

    public mut function deposit(amount : double) : void or Error requires amount > 0.0 {
        this.balance = this.balance + amount
    }

    public function current() : double = this.balance
}

// The bound is declared once. The body can call area() because S : Shape.
public function biggest[S : Shape](a : S, b : S) : S =
    if a.area() >= b.area() then a else b

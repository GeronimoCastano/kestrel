enum Tree {
    Leaf
    Node(Tree, Tree)
}

function mirror(t : Tree) : Tree =
    match t { Leaf => Leaf, Node(a, b) => Node(mirror(b), mirror(a)) }

theorem mirrorTwice(t : Tree) : mirror(mirror(t)) = t by {
    induction t {
        Leaf => { rfl }
        Node(a, b) iha ihb => { simp [iha, ihb] }
    }
}

enum Expr {
    Lit(Int)
    Add(Expr, Expr)
}

function eval(e : Expr) : Int = match e { Lit(n) => n, Add(a, b) => eval(a) + eval(b) }

function fold(e : Expr) : Expr = match e { Lit(n) => Lit(n), Add(a, b) => Add(fold(a), fold(b)) }

theorem foldPreserves(e : Expr) : eval(fold(e)) = eval(e) {
    induction e { Lit(n) => rfl, Add(a, b) iha ihb => simp [iha, ihb] }
}

// A gallery of kesplot's chart types. Run with:
//     kestrel run examples/kesplot_gallery.kes
// It writes kesplot-gallery-*.svg in the current directory.
import std.kesplot as plt
import std.kesdas.{Series, DataFrame}
import std.math.{sin, cos}

function lines() : void or Error with Effects {
    let xs := [i.toDouble() / 20.0 for i in range(121)]
    let fig := plt.Figure(style = plt.Style.science())
    fig.plot(xs, [sin(x) for x in xs], label = "$\\sin(x)$", color = "C0")
    fig.plot(xs, [cos(x) for x in xs], label = "$\\cos(x)$", color = "C1", lineStyle = "--", lineWidth = 1.4)
    fig.plot(xs, [sin(2.0 * x) for x in xs], label = "$\\sin(2x)$", color = "C2", lineStyle = ":", marker = "o", markerSize = 3.0)
    fig.title("Line styles and markers")
    fig.xLabel("x")
    fig.yLabel("y")
    fig.legend("upper right")
    fig.save("kesplot-gallery-lines.svg")?
}

function scatter() : void or Error with Effects {
    let n := 55
    let frame := DataFrame([
        Series([i.toDouble() for i in range(n)], name = "x"),
        Series([i.toDouble() * 0.5 + 10.0 * sin(i.toDouble() / 8.0) for i in range(n)], name = "y"),
        Series([if i % 3 == 0 then "a" else if i % 3 == 1 then "b" else "c" for i in range(n)], name = "group"),
        Series([1.0 + i.toDouble() / 20.0 for i in range(n)], name = "size"),
    ])
    let fig := plt.Figure(style = plt.Style.science())
    fig.scatterFrame(frame, x = "x", y = "y", colorBy = "group", sizeBy = "size")?
    fig.title("Scatter with colour and size")
    fig.xLabel("x")
    fig.yLabel("y")
    fig.legend("outside right")
    fig.save("kesplot-gallery-scatter.svg")?
}

function bars() : void or Error with Effects {
    let frame := DataFrame([
        Series(["alpha", "beta", "gamma", "delta"], name = "category"),
        Series([12, 8, 15, 10], name = "north"),
        Series([9, 14, 7, 12], name = "south"),
    ])
    let fig := plt.Figure(style = plt.Style.science())
    fig.barFrame(frame, x = "category", y = ["north", "south"])?
    fig.title("Grouped bars")
    fig.xLabel("category")
    fig.yLabel("count")
    fig.legend("upper right")
    fig.save("kesplot-gallery-bars.svg")?

    let horizontal := plt.Figure(style = plt.Style.science())
    horizontal.barh(["north", "south", "east", "west"], [12, -4, 9, 6], label = "profit")
    horizontal.title("Horizontal bars")
    horizontal.legend()
    horizontal.save("kesplot-gallery-barh.svg")?
}

function histograms() : void or Error with Effects {
    let a := [sin(i.toDouble() * 0.7) * 2.0 + 0.5 * cos(i.toDouble() * 0.2) for i in range(200)]
    let b := [cos(i.toDouble() * 0.45) * 1.5 - 0.3 for i in range(200)]
    let fig := plt.Figure(style = plt.Style.science())
    fig.hist(a, bins = 18, label = "signal A", alpha = 0.55, color = "C0")
    fig.hist(b, bins = 18, label = "signal B", alpha = 0.55, color = "C1", histType = "step")
    fig.title("Overlapping histograms")
    fig.xLabel("value")
    fig.yLabel("count")
    fig.legend()
    fig.save("kesplot-gallery-hist.svg")?

    let frame := DataFrame([
        Series([1.0, 2.0, 2.2, 3.0, 4.0, 10.0, 2.5, 2.8], name = "A"),
        Series([2.0, 3.0, 3.4, 4.0, 5.0, 6.0, 3.2, 3.8], name = "B"),
        Series([0.5, 1.0, 1.1, 1.5, 2.0, 4.5, 1.2, 1.4], name = "C"),
    ])
    let box := plt.Figure(style = plt.Style.science())
    box.boxFrame(frame)?
    box.title("Distribution by category")
    box.yLabel("value")
    box.save("kesplot-gallery-box.svg")?
}

function matrices() : void or Error with Effects {
    let rows := 7
    let cols := 6
    let matrix := [[sin(r.toDouble() * 0.8) * cos(c.toDouble() * 0.6) for c in range(cols)] for r in range(rows)]
    let rowLabels := ["r" + r.text() for r in range(rows)]
    let colLabels := ["c" + c.text() for c in range(cols)]
    let fig := plt.Figure(style = plt.Style.science())
    fig.heatmap(matrix, rowLabels, colLabels, "viridis", true, "value")
    fig.title("Heatmap")
    fig.save("kesplot-gallery-heatmap.svg")?

    let contourFig := plt.Figure(style = plt.Style.science())
    let smooth := [[sin(r.toDouble() / 3.0) * cos(c.toDouble() / 4.0) for c in range(40)] for r in range(24)]
    contourFig.contour(smooth, 7, "viridis", 1.0, [], [], true, "z")
    contourFig.title("Contour lines")
    contourFig.save("kesplot-gallery-contour.svg")?
}

function pieChart() : void or Error with Effects {
    let fig := plt.Figure(style = plt.Style.science())
    fig.pie([35.0, 25.0, 20.0, 12.0, 8.0], ["North", "South", "East", "West", "Other"], startAngle = 90.0, autoPercent = true, donut = 0.4)
    fig.title("Share of sales")
    fig.legend("outside right")
    fig.save("kesplot-gallery-pie.svg")?
}

function extras() : void or Error with Effects {
    let xs := [i.toDouble() / 10.0 for i in range(61)]
    let middle := [sin(x) for x in xs]
    let lower := [sin(x) - 0.2 for x in xs]
    let upper := [sin(x) + 0.2 for x in xs]
    let fig := plt.Figure(style = plt.Style.science())
    fig.fillBetween(xs, lower, upper, label = "95% band", alpha = 0.2, color = "C0")
    fig.plot(xs, middle, label = "mean", color = "C0")
    fig.hLine(0.0, label = "zero", color = "C3", lineStyle = "--")
    fig.annotate("peak", 1.57, 1.0, 3.2, 0.75, color = "C3")
    fig.title("Bands, guides and annotations")
    fig.xLabel("x")
    fig.legend("outside right")
    fig.save("kesplot-gallery-extras.svg")?

    let area := plt.Figure(style = plt.Style.science())
    let a := [1.0 + sin(i.toDouble() / 2.0) * 0.3 for i in range(12)]
    let b := [2.0 + cos(i.toDouble() / 3.0) * 0.4 for i in range(12)]
    let c := [1.5 + sin(i.toDouble() / 4.0) * 0.2 for i in range(12)]
    area.stackPlot([i.toDouble() for i in range(12)], [a, b, c], ["alpha", "beta", "gamma"])
    area.title("Stacked areas")
    area.xLabel("month")
    area.legend("upper left")
    area.save("kesplot-gallery-stack.svg")?
}

function panels() : void or Error with Effects {
    let xs := [i.toDouble() for i in range(30)]
    let fig := plt.Figure(style = plt.Style.science())
    fig.subplots(2, 2)
    fig.plot(xs, [x * x for x in xs], label = "quadratic")
    fig.title("Line")
    fig.legend()
    fig.nextPanel()
    fig.scatter(xs, [sin(x / 3.0) for x in xs], label = "scatter")
    fig.title("Scatter")
    fig.nextPanel()
    fig.bar(["A", "B", "C", "D"], [3, 7, 2, 5], label = "counts")
    fig.title("Bars")
    fig.nextPanel()
    fig.hist([sin(i.toDouble() * 0.6) for i in range(100)], bins = 12, label = "hist")
    fig.title("Histogram")
    fig.figureTitleText("A four-panel figure")
    fig.save("kesplot-gallery-panels.svg")?
}

function main() : void or Error with Effects {
    lines()?
    scatter()?
    bars()?
    histograms()?
    matrices()?
    pieChart()?
    extras()?
    panels()?
    print("wrote kesplot-gallery-*.svg")
}
main()?

// Integer and floating-point loops. Integer arithmetic is checked for overflow.
function lcg(n : Int) : Int {
    let mut x := 42
    let mut total := 0
    for (let i : Int = 0; i < n; i = i + 1) {
        x = (x * 1103515245 + 12345) % 2147483648
        total = total + (x % 1000)
    }
    total
}

function leibniz(n : Int) : double {
    let mut sum := 0.0
    let mut sign := 1.0
    for (let i : Int = 0; i < n; i = i + 1) {
        sum = sum + sign / (2.0 * i.toDouble() + 1.0)
        sign = -sign
    }
    4.0 * sum
}

print(lcg(50000000))
print(f"{leibniz(50000000):.9f}")

// Transformer forward/backward benchmark: MultiheadAttention(64, 2) -> residual
// -> LayerNorm -> Linear(64, 64). Backward on the output sum, 1600 iterations.
import std.kesnet.{LayerNorm, Linear, Module, MultiheadAttention}

public class AttentionBlock extends Module {
    public var attention : MultiheadAttention
    public var norm : LayerNorm
    public var projection : Linear

    new(width : Int, heads : Int) {
        this.registered = Array.empty()
        this.trainingMode = true
        this.attention = MultiheadAttention(width, heads)
        this.norm = LayerNorm(width)
        this.projection = Linear(width, width)
        for (parameter in this.attention.parameters()) { this.registered.append(parameter) }
        for (parameter in this.norm.parameters()) { this.registered.append(parameter) }
        for (parameter in this.projection.parameters()) { this.registered.append(parameter) }
    }

    @override
    public function forward(x : Variable) : Variable {
        let attended := this.attention.forward(x)
        let normalized := this.norm.forward(attended + x)
        this.projection.forward(normalized)
    }
}

Variable.seed(3)
let tokens :=
    Tensor.generate(
        (8, 32, 64),
        (n, t, f) => (((n * 29 + t * 47 + f * 11) % 101).toDouble() - 50.0) / 50.0,
    )
let inputs := Variable.fromTensor(tokens)

let block := AttentionBlock(64, 2)
let mut finalLoss := 0.0

for (step in range(1600)) {
    let output := block.forward(inputs)
    let loss := output.sum()
    block.zeroGrad()
    loss.backward()
    finalLoss = loss.item()
}

print(f"{finalLoss:.6f}")

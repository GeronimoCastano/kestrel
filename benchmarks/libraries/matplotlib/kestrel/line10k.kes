// line10k: two 5,000-point line series, title, labels, legend and grid.
import c "stdlib.h"
import std.kesplot as plt
import std.math.{cos, sin}

function quote(text : String) : String = "'" + text.replace("'", "'\\''") + "'"

function reportSize(path : String) : void or Error with Effects {
    let sizePath := path + ".size"
    let status := unsafe { system("wc -c < " + quote(path) + " > " + quote(sizePath)) }
    if status.toInt() != 0 { return Error("cannot measure " + path) }
    using reader := open(sizePath)?{
        let line := reader.readLine()?
        print(parseInt(line.trim())?)
    }
}

function main() : void or Error with Effects {
    let n := 5000
    let xs : Array[double] = Array.empty()
    let sinY : Array[double] = Array.empty()
    let cosY : Array[double] = Array.empty()
    for (i in range(n)) {
        let x := 5.0 * i.toDouble() / (n - 1).toDouble()
        xs.append(x)
        sinY.append(sin(x))
        cosY.append(cos(x))
    }

    let fig := plt.Figure(width = 8.0, height = 6.0)
    fig.plot(xs.toList(), sinY.toList(), label = "sin(x)")
    fig.plot(xs.toList(), cosY.toList(), label = "cos(x)", lineStyle = "--")
    fig.title("Two 5,000-point series")
    fig.xLabel("x")
    fig.yLabel("y")
    fig.legend("upper right")
    fig.grid(true)

    fig.save("/tmp/plotbench/kestrel_line10k.svg")?
    reportSize("/tmp/plotbench/kestrel_line10k.svg")?
}
main()

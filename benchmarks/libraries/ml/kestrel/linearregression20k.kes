// Closed-form least squares on 20,000 observations with 16 features.
// The fit and prediction repeat R times and the printed numbers add every
// repetition.
import std.ml.{LinearRegression, meanSquaredError}

import std.process.{args}

let REPETITIONS :=
    if args.toArray().length() > 0 then (match parseInt(args.toArray()[0]) { n => n, _ => 500 })
    else 500

let X := Tensor.generate((20000, 16), (i, j) => (((i * 31 + j * 17) % 101) - 50).toDouble() / 10.0)
let y := Tensor.generate((20000,), i => 3.0 * X[i, 0] - 2.0 * X[i, 1] + 0.5 * X[i, 2] + 1.0)
let mut totalIntercept := 0.0
let mut totalCoefficients := 0.0
let mut totalError := 0.0
for (step in range(REPETITIONS)) {
    let model := LinearRegression.fit(X, y)
    let predicted := model.predict(X)
    totalIntercept += model.intercept
    totalCoefficients += model.coefficients.sum()
    totalError += meanSquaredError(y, predicted)
}
print(f"{totalIntercept:.6f} {totalCoefficients:.6f} {totalError:.6f}")

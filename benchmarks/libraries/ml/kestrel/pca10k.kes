// PCA with five components over 10,000 observations of 30 features.
// The fit and transform repeat R times and the printed numbers add every
// repetition.
import std.ml.{PCA}

import std.process.{args}

let REPETITIONS := if args.toArray().length() > 0 then (match parseInt(args.toArray()[0]) { n => n, _ => 1500 }) else 1500

let X := Tensor.generate((10000, 30), (i, j) => ((i * 1103515245 + j * 12345 + 7) % 2147483648).toDouble() / 2147483648.0 - 0.5)
let mut totalVariance := 0.0
let mut totalTransformed := 0.0
for (step in range(REPETITIONS)) {
    let model := PCA.fit(X, 5)
    let transformed := model.transform(X)
    totalVariance += model.explainedVariance.sum()
    totalTransformed += transformed.sum()
}
print(f"{totalVariance:.6f} {totalTransformed:.6f}")

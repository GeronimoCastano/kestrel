// K-means with four clusters over 20,000 points from three deterministic blobs.
// The fit and prediction repeat R times and the printed counts and label sum
// add every repetition. Initial centres differ between implementations, so the
// checksum is timing-only.
import std.ml.{KMeans}

import std.process.{args}

let REPETITIONS :=
    if args.toArray().length() > 0 then (match parseInt(args.toArray()[0]) { n => n, _ => 400 })
    else 400

let X := Tensor.generate(
    (20000, 12),
    (i, j) => {
        let cluster := i % 3
        let first := if cluster == 0 then -3.0 else if cluster == 1 then 3.0 else 0.0
        let second := if cluster == 0 then -3.0 else if cluster == 1 then -3.0 else 3.0
        let center := if j == 0 then first else if j == 1 then second else 0.0
        let noise := (((i * 37 + j * 53 + 11) % 200).toDouble() - 100.0) / 200.0
        center + noise
    },
)
let mut totalCounts := Array.generate(4, index => 0)
let mut totalLabels := 0.0
for (step in range(REPETITIONS)) {
    let model := KMeans.fit(X, 4, 50)
    let labels := model.predict(X)
    for (let row = 0; row < 20000; row++) {
        if labels[row] == 0.0 { totalCounts[0]++ }
        if labels[row] == 1.0 { totalCounts[1]++ }
        if labels[row] == 2.0 { totalCounts[2]++ }
        if labels[row] == 3.0 { totalCounts[3]++ }
    }
    totalLabels += labels.sum()
}
let mut sorted := totalCounts
for (let left = 0; left < 4; left++) {
    for (let right = left + 1; right < 4; right++) {
        if sorted[right] < sorted[left] {
            let saved := sorted[left]
            sorted[left] = sorted[right]
            sorted[right] = saved
        }
    }
}
print(
    f"{sorted[0].toDouble():.6f} {sorted[1].toDouble():.6f} {sorted[2].toDouble():.6f} {sorted[3].toDouble():.6f} {totalLabels:.6f}",
)

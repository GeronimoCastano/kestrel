// K-nearest-neighbour prediction: 20,000 training rows, 2,000 test rows, 8 features.
// The prediction repeats R times and the printed numbers add every repetition.
import std.ml.{KNeighborsClassifier, accuracy}

import std.process.{args}

let REPETITIONS :=
    if args.toArray().length() > 0 then (match parseInt(args.toArray()[0]) { n => n, _ => 10 })
    else 10

let training :=
    Tensor.generate(
        (20000, 8),
        (i, j) => ((i * 1103515245 + j * 12345 + 12345) % 2147483648).toDouble() / 2147483648.0,
    )
let testing :=
    Tensor.generate(
        (2000, 8),
        (i, j) => ((i * 1103515245 + j * 12345 + 987654321) % 2147483648).toDouble() / 2147483648.0,
    )
let labels := Tensor.generate((20000,), i => if training[i, 0] > 0.5 then 1.0 else 0.0)
let expected := Tensor.generate((2000,), i => if testing[i, 0] > 0.5 then 1.0 else 0.0)

let model := KNeighborsClassifier.fit(training, labels, 5)
let mut totalAccuracy := 0.0
let mut totalPredictions := 0.0
for (step in range(REPETITIONS)) {
    let predicted := model.predict(testing)
    totalAccuracy += accuracy(expected, predicted)
    totalPredictions += predicted.sum()
}
print(f"{totalAccuracy:.6f} {totalPredictions:.6f}")

// Laws relate several calls, so they go in a test file next to the trait.
import std.test.{assertEq}
import testdata.language.rules.{Square, biggest}

@test
function biggestIsSymmetric() : void {
    let a := Square(1.0)
    let b := Square(3.0)
    assertEq(biggest(a, b).area(), biggest(b, a).area())
}
